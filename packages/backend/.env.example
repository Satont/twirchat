# Backend environment variables
# Copy this file to .env and fill in the values.

# ── Server ────────────────────────────────────────────────────
# Port the HTTP + WebSocket server listens on.
PORT=3000

# Optional JSON provider list. Empty uses lilb/robotty/zneix/zonian/iore + Zonian archives.
# Set [] to disable external Twitch history server-wide. Provider selection stays on the server.
# Example: [{"id":"robotty","kind":"recent","url":"https://recent-messages.robotty.de/api/v2/recent-messages/{channel}","maxMessages":800},{"id":"zonian","kind":"archive","url":"https://logs.zonian.dev"}]
TWITCH_HISTORY_PROVIDERS=

# ── PostgreSQL ────────────────────────────────────────────────
# Bun.sql reads DATABASE_URL (or POSTGRES_URL / PGURL) automatically.
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://twirchat:twirchat@localhost:5432/twirchat

# ── Twitch OAuth ──────────────────────────────────────────────
# Register your app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Kick OAuth ────────────────────────────────────────────────
# Register your app at https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Where Kick redirects after OAuth. Must match the redirect URI
# registered in your Kick app settings.
# For local dev: http://localhost:3000/auth/kick/callback
KICK_REDIRECT_URI=http://localhost:3000/auth/kick/callback

# ── Kick Webhooks ─────────────────────────────────────────────
# The public HTTPS URL where Kick will POST webhook events.
# In local dev, use a tunnel (e.g. ngrok):
#   ngrok http 3000
#   → set this to https://<your-id>.ngrok.io/webhook/kick
KICK_WEBHOOK_URL=https://your-backend.example.com/webhook/kick

# The secret used to verify Kick webhook HMAC signatures.
# Generate with: openssl rand -hex 32
KICK_WEBHOOK_SECRET=

YOUTUBE_API_KEY=

# Optional donation OAuth. Register the exact callback URLs; use an HTTPS tunnel
# to this backend when the provider requires a public HTTPS URL.
DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=
DONATIONALERTS_REDIRECT_URI=

MEMEALERTS_CLIENT_ID=
MEMEALERTS_CLIENT_SECRET=
MEMEALERTS_REDIRECT_URI=
