{
  "name": "@twirchat/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:native && NODE_ENV=development bun --hot src/gpuix/main.tsx",
    "start": "bun run build:native && NODE_ENV=production bun src/gpuix/main.tsx",
    "qa:gui": "bun scripts/qa-gui.ts",
    "qa:native": "bun scripts/qa-gui.ts --timeout 45 -- bun scripts/qa-native.tsx",
    "qa:settings": "bun scripts/qa-gui.ts --timeout 45 -- bun scripts/qa-settings.tsx",
    "qa:windows": "bun scripts/qa-gui.ts --dbus --timeout 60 -- bun scripts/qa-windows.tsx",
    "qa:app": "bun scripts/qa-gui.ts --dbus --timeout 45 -- bun scripts/qa-app.tsx",
    "qa:changelog": "bun scripts/qa-gui.ts --timeout 45 -- bun scripts/qa-changelog.tsx",
    "qa:chat": "bun scripts/qa-gui.ts --dbus --display-width 1800 --display-height 1500 --timeout 45 -- bun scripts/qa-chat-behavior.tsx",
    "build": "bun scripts/build-desktop.ts",
    "build:release": "bun scripts/build-release.ts",
    "package:runtime": "bun scripts/package-runtime-assets.ts",
    "build:overlay": "vite build --config vite.overlay.config.ts",
    "gen": "bun ../shared/youtube/codegen/generate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.gpuix.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.bun.json",
    "test": "bun test tests/",
    "build:native": "bun scripts/build-gpuix-native.ts build",
    "check:native": "bun scripts/build-gpuix-native.ts check",
    "test:native": "bun scripts/build-gpuix-native.ts test",
    "qa:hmr": "bun scripts/qa-gui.ts --dbus --keep --timeout 80 -- bun scripts/qa-hmr.ts",
    "qa:composer": "bun scripts/qa-gui.ts --keep --timeout 60 -- bun scripts/qa-composer.tsx",
    "qa:status": "bun scripts/qa-gui.ts --dbus --keep --timeout 60 -- bun scripts/qa-status.tsx",
    "qa:churn": "bun scripts/qa-gui.ts --dbus --keep --timeout 80 -- bun --expose-gc scripts/qa-window-churn.tsx",
    "bench:chat": "bun scripts/bench-chat.ts",
    "bench:flood": "bun scripts/flood-stand.tsx"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "@grpc/grpc-js": "1.14.6",
    "@twirchat/shared": "workspace:*",
    "@twurple/api": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@twurple/chat": "8.2.0",
    "pcre2-wasm": "10.49.2",
    "react": "19.3.1",
    "sharp": "0.35.5",
    "velopack": "1.3.39-g8d2844f",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-vue": "6.0.10",
    "ts-proto": "2.18.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-svg-loader": "5.1.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
