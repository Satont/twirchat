{
  "name": "@twirchat/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:wails",
    "dev:wails": "wails3 dev -config build/config.yml",
    "dev:main": "vite --config vite.main.config.ts",
    "build": "wails3 build",
    "build:main": "vite build --config vite.main.config.ts",
    "build:overlay": "vite build --config vite.overlay.config.ts",
    "build:views": "bun run build:main && bun run build:overlay",
    "gen": "cd src/platforms/youtube && bunx @bufbuild/buf generate",
    "typecheck": "vue-tsc --noEmit",
    "test": "bun test tests/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.11.0",
    "@grpc/grpc-js": "1.14.3",
    "@twirchat/shared": "workspace:*",
    "@twurple/api": "8.0.3",
    "@twurple/auth": "8.0.3",
    "@twurple/chat": "8.0.3",
    "@wailsio/runtime": "3.0.0-alpha.97",
    "electrobun": "1.18.1",
    "reka-ui": "2.9.2",
    "splitpanes": "4.0.4",
    "virtua": "0.49.0",
    "vue": "3.5.30",
    "youtubei.js": "17.0.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.66.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-vue": "6.0.5",
    "pinia": "3.0.4",
    "ts-proto": "2.11.6",
    "typescript": "^5.8.0",
    "vite": "8.0.1",
    "vite-svg-loader": "5.1.1",
    "vue-tsc": "3.2.6"
  }
}
