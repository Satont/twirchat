{
  "name": "@twirchat/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "deno task start",
    "dev": "deno task dev",
    "build:views": "deno task build:views",
    "gen": "cd src/platforms/youtube && bunx @bufbuild/buf generate",
    "typecheck": "vue-tsc --noEmit",
    "test": "deno task test",
    "build:prod": "bun run build:views && deno task start",
    "build:prod:ci": "bun run build:views && CHATRIX_BACKEND_URL=$CHATRIX_BACKEND_URL CHATRIX_BACKEND_WS_URL=$CHATRIX_BACKEND_WS_URL deno task start"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.11.0",
    "@grpc/grpc-js": "1.14.3",
    "@twirchat/shared": "workspace:*",
    "@twurple/api": "8.0.3",
    "@twurple/auth": "8.0.3",
    "@twurple/chat": "8.0.3",
    "reka-ui": "2.9.2",
    "splitpanes": "4.0.4",
    "virtua": "0.49.0",
    "vue": "3.5.30",
    "youtubei.js": "17.0.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.66.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-vue": "6.0.5",
    "pinia": "3.0.4",
    "ts-proto": "2.11.6",
    "typescript": "^5.8.0",
    "vite": "8.0.1",
    "vite-svg-loader": "5.1.1",
    "vue-tsc": "3.2.6"
  }
}
