{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/react",
    "types": ["bun", "node"],
    "paths": {
      "@desktop/*": ["./src/*"],
      "@twirchat/shared": ["../shared/index.ts"],
      "@twirchat/shared/*": ["../shared/*"]
    }
  },
  "include": [
    "native/gpuix/probes/window-lifecycle.ts",
    "src/gpuix/**/*",
    "src/views/shared/utils/**/*",
    "src/views/main/utils/**/*",
    "scripts/qa-autocomplete.tsx",
    "scripts/qa-painted-geometry.tsx",
    "scripts/qa-drag-interactions.tsx",
    "scripts/qa-seventv-notices.tsx",
    "scripts/qa-background-images.tsx",
    "scripts/qa-history-logs.tsx",
    "scripts/qa-tab-counts.tsx",
    "scripts/qa-deferred-chat-rows.tsx",
    "scripts/qa-badge-tooltips.tsx",
    "scripts/qa-distribution.ts",
    "scripts/qa-linux-update.ts",
    "scripts/qa-tray.tsx",
    "scripts/qa-built-app.ts",
    "scripts/qa-wayland-tray.tsx",
    "scripts/qa-mention-user-card.tsx",
    "scripts/qa-emote-resources.tsx",
    "scripts/qa-text-rendering.tsx"
  ],
  "exclude": ["node_modules"]
}
