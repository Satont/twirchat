{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["bun", "node"],
    "paths": {
      "@desktop/*": ["./src/*"],
      "@twirchat/shared": ["../shared/index.ts"],
      "@twirchat/shared/*": ["../shared/*"],
      "@gpuix/*": ["./src/gpuix/*"],
      "@gpuix/hooks/*": ["./src/gpuix/hooks/*"],
      "@gpuix/components/*": ["./src/gpuix/components/*"],
      "@gpuix/state/*": ["./src/gpuix/state/*"],
      "@gpuix/theme/*": ["./src/gpuix/theme*"],
      "@gpuix/backend/*": ["./src/gpuix/backend/*"],
      "@views/*": ["./src/views/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["overlay", "node_modules", "src/gpuix"]
}
