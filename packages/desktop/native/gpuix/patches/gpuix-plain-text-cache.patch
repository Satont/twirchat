+    #[test]
+    fn cache_capacity_falls_back_without_adding_entries() {
+        let (tree, inherited, context) = fixture();
+        let entry = context
+            .prepare(&tree, &tree.elements[&3], &inherited, true)
+            .unwrap()
+            .entry;
+        {
+            let mut cache = context.cache.borrow_mut();
+            for id in 100..100 + MAX_WORDS as u64 {
