+    #[test]
+    fn only_painted_word_identities_survive_a_frame() {
+        let (mut tree, inherited, mut context) = fixture();
+        tree.create_element(5, "text".into());
+        tree.create_element(6, "text".into());
+        tree.append_child(2, 5);
+        tree.append_child(5, 6);
+        tree.set_text(6, "other".into());
+        begin_after_commit(&mut tree, &mut context);
+        let current = context
+            .prepare(&tree, &tree.elements[&3], &inherited, true)
+            .unwrap()
+            .entry;
+        let retired = context
+            .prepare(&tree, &tree.elements[&5], &inherited, true)
+            .unwrap()
+            .entry;
+        current.borrow_mut().painted_epoch = context.epoch;
+        let mut cache = context.cache.borrow_mut();
+        cache.entries.insert(3, current);
+        cache.entries.insert(5, retired);
+        cache.finish_frame(context.epoch);
+        assert_eq!(cache.entries.keys().copied().collect::<Vec<_>>(), [3]);
+    }
