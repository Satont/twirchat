+
+    fn cache_word(
+        tree: &RetainedTree,
+        inherited: &Inherited,
+        context: &PlainTextCacheContext,
+    ) -> Rc<RefCell<CachedWord>> {
+        let prepared = context
+            .prepare(tree, &tree.elements[&3], inherited, true)
+            .unwrap();
+        prepared.entry.borrow_mut().captures = 2;
+        context
+            .cache
+            .borrow_mut()
+            .entries
+            .insert(3, prepared.entry.clone());
+        prepared.entry
+    }
+
+    #[test]
+    fn committed_ancestor_opacity_rejects_a_saved_paint_only_frame_before_ui_invalidation() {
+        let (mut tree, inherited, context) = fixture();
+        cache_word(&tree, &inherited, &context);
+        let word_revision = tree.elements[&3].subtree_revision;
+        let mut style = tree.elements[&2].style.as_deref().unwrap().clone();
+        style.opacity = Some(0.5);
+        tree.set_style(2, Arc::new(style));
+        assert_eq!(tree.take_invalidation(), Invalidation::Full);
+        assert_eq!(tree.elements[&3].subtree_revision, word_revision);
+        assert!(
+            context
+                .prepare(&tree, &tree.elements[&3], &inherited, true)
+                .is_none()
+        );
+        assert!(!context.cache.borrow().enabled);
+        assert!(context.cache.borrow().entries.is_empty());
+    }
+
+    #[test]
+    fn pending_full_ancestor_changes_disable_a_saved_word_cache() {
+        let (mut tree, inherited, context) = fixture();
+        cache_word(&tree, &inherited, &context);
+        let mut style = tree.elements[&2].style.as_deref().unwrap().clone();
+        style.opacity = Some(0.5);
+        tree.set_style(2, Arc::new(style));
+        assert!(
+            context
+                .prepare(&tree, &tree.elements[&3], &inherited, true)
+                .is_none()
+        );
+        assert!(!context.cache.borrow().enabled);
+    }
+
+    #[test]
+    fn color_only_ancestor_commits_reuse_the_saved_word_generation() {
+        let (mut tree, inherited, context) = fixture();
+        let word = cache_word(&tree, &inherited, &context);
+        let mut style = tree.elements[&2].style.as_deref().unwrap().clone();
+        style.background_color = Some("#123456".into());
+        tree.set_style(2, Arc::new(style));
+        assert_eq!(tree.take_invalidation(), Invalidation::PaintOnly);
+        let reused = context
+            .prepare(&tree, &tree.elements[&3], &inherited, true)
+            .unwrap();
+        assert!(Rc::ptr_eq(&word, &reused.entry));
+        assert!(!reused.needs_build);
+        assert!(context.cache.borrow().enabled);
+    }
+
+    #[test]
+    fn stale_frame_context_cannot_clear_a_newer_valid_cache() {
+        let (mut tree, inherited, old_context) = fixture();
+        cache_word(&tree, &inherited, &old_context);
+        let mut style = tree.elements[&2].style.as_deref().unwrap().clone();
+        style.opacity = Some(0.5);
+        tree.set_style(2, Arc::new(style));
+        tree.take_invalidation();
+        {
+            let mut cache = old_context.cache.borrow_mut();
+            cache.clear();
+            cache.epoch += 1;
+            cache.enabled = true;
+            cache.guard.as_mut().unwrap().full_generation = tree.cache_revision().unwrap();
+        }
+        let current_context = PlainTextCache::context(&old_context.cache, 1, 2).unwrap();
+        let current_word = cache_word(&tree, &inherited, &current_context);
+        assert!(
+            old_context
+                .prepare(&tree, &tree.elements[&3], &inherited, true)
+                .is_none()
+        );
+        let cache = current_context.cache.borrow();
+        assert!(cache.enabled);
+        assert_eq!(cache.entries.len(), 1);
+        assert!(Rc::ptr_eq(&current_word, &cache.entries[&3]));
+    }
