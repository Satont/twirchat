+#[cfg(test)]
+mod invalidation_tests {
+    use super::{Invalidation, RetainedTree};
+    use crate::style::StyleDesc;
+    use std::sync::Arc;
+
+    fn tree() -> RetainedTree {
+        let mut tree = RetainedTree::new();
+        tree.create_element(1, "div".into());
+        tree.set_style(
+            1,
+            Arc::new(StyleDesc {
+                width: Some(crate::style::DimensionValue::Pixels(100.)),
+                ..Default::default()
+            }),
+        );
+        tree.take_invalidation();
+        tree
+    }
+
+    fn color(tree: &mut RetainedTree) {
+        let mut style = tree.elements[&1].style.as_deref().unwrap().clone();
+        style.background_color = Some("#333333".into());
+        tree.set_style(1, Arc::new(style));
+    }
+
+    #[test]
+    fn color_changes_keep_the_existing_layout() {
+        let mut tree = tree();
+        color(&mut tree);
+        assert_eq!(tree.take_invalidation(), Invalidation::PaintOnly);
+    }
+
+    #[test]
+    fn text_changes_dominate_color_updates_in_either_order() {
+        for full_first in [false, true] {
+            let mut tree = tree();
+            if full_first {
+                tree.set_text(1, "new".into());
+            }
+            color(&mut tree);
+            if !full_first {
+                tree.set_text(1, "new".into());
+            }
+            assert_eq!(tree.take_invalidation(), Invalidation::Full);
+        }
+    }
+
+    #[test]
+    fn opacity_and_geometry_updates_are_full_invalidations() {
+        for style in [
+            StyleDesc {
+                opacity: Some(0.5),
+                ..Default::default()
+            },
+            StyleDesc {
+                gap: Some(3.),
+                ..Default::default()
+            },
+        ] {
+            let mut tree = tree();
+            tree.set_style(1, Arc::new(style));
+            assert_eq!(tree.take_invalidation(), Invalidation::Full);
+        }
+    }
+
+    #[test]
+    fn taking_dirty_also_resets_the_invalidation_kind() {
+        let mut tree = tree();
+        color(&mut tree);
+        assert!(tree.take_dirty());
+        assert_eq!(tree.take_invalidation(), Invalidation::None);
+    }
+
+    #[test]
+    fn listeners_and_props_require_full_invalidation() {
+        let mut tree = tree();
