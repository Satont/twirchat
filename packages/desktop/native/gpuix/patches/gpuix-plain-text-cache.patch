+use rustc_hash::FxHashMap;
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use gpui::{App, Bounds, Element, Hsla, IntoElement, Pixels, Window, canvas, point, px, size};
+
+use crate::automation;
+use crate::renderer::{Inherited, raw_text_leaf_content};
+use crate::retained_tree::{Invalidation, RetainedElement, RetainedTree};
+use crate::text::paint::{TextPaintEffects, text_paint_effects, text_paint_marker};
+
+const MAX_WORDS: usize = 4096;
+
+pub(crate) type SharedPlainTextCache = Rc<RefCell<PlainTextCache>>;
+
+#[derive(PartialEq)]
+struct FrameGuard {
+    full_generation: u64,
+    selection: u64,
+    focus: Option<gpui::FocusId>,
+    keyboard: bool,
+    viewport: gpui::Size<Pixels>,
+    scale: f32,
+}
+
+#[derive(Default)]
+pub(crate) struct PlainTextCache {
+    entries: FxHashMap<u64, Rc<RefCell<CachedWord>>>,
+    // GPUI may retain a range after entries clear; never recycle its version token.
+    next_token: u64,
+    epoch: u64,
+    enabled: bool,
+    guard: Option<FrameGuard>,
+}
+
+impl PlainTextCache {
+    pub(crate) fn clear(&mut self) {
+        self.entries.clear();
+        self.enabled = false;
+    }
+
+    pub(crate) fn begin_frame(
+        &mut self,
+        kind: Invalidation,
+        revision: Option<u64>,
+        safe: bool,
+        selection: u64,
+        window: &Window,
+        cx: &App,
+    ) -> bool {
+        self.epoch = self.epoch.wrapping_add(1);
+        let Some(full_generation) = revision else {
+            self.clear();
+            self.guard = None;
+            return false;
+        };
+        let guard = FrameGuard {
+            full_generation,
+            selection,
+            focus: window.focused(cx).map(|focus| focus.id()),
+            keyboard: window.last_input_was_keyboard(),
+            viewport: window.viewport_size(),
+            scale: window.scale_factor(),
+        };
+        self.enabled =
+            kind == Invalidation::PaintOnly && safe && self.guard.as_ref() == Some(&guard);
+        if !self.enabled {
+            self.entries.clear();
+        }
+        self.guard = Some(guard);
+        self.enabled
+    }
+
+    pub(crate) fn context(
+        cache: &SharedPlainTextCache,
+        list_id: u64,
+        row_id: u64,
+    ) -> Option<PlainTextCacheContext> {
+        let state = cache.borrow();
+        if !state.enabled {
+            return None;
+        }
+        let full_generation = state.guard.as_ref()?.full_generation;
+        Some(PlainTextCacheContext {
+            cache: cache.clone(),
+            epoch: state.epoch,
+            full_generation,
+            list_id,
+            row_id,
+        })
+    }
+
+    fn finish_frame(&mut self, epoch: u64) {
+        if self.epoch == epoch {
+            self.entries
+                .retain(|_, entry| entry.borrow().painted_epoch == epoch);
+        }
+    }
+
+    pub(crate) fn finish(cache: SharedPlainTextCache) -> gpui::AnyElement {
+        use gpui::prelude::*;
+        let epoch = cache.borrow().epoch;
+        canvas(
+            |_, _, _| (),
+            move |_, _, _, _| {
+                cache.borrow_mut().finish_frame(epoch);
+            },
+        )
+        .absolute()
+        .w(px(0.0))
+        .h(px(0.0))
+        .into_any_element()
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct PlainTextCacheContext {
+    cache: SharedPlainTextCache,
+    epoch: u64,
+    full_generation: u64,
+    list_id: u64,
+    row_id: u64,
+}
+
+#[derive(PartialEq)]
+struct WordSource {
+    id: u64,
+    raw_id: u64,
+    revision: u64,
+    list_id: u64,
+    row_id: u64,
+    selectable: bool,
+    wash: Hsla,
+}
+
+struct CachedWord {
+    source: WordSource,
+    token: u64,
+    painted_epoch: u64,
+    captures: u8,
+    paint: Option<WordPaint>,
+}
+
+struct WordPaint {
+    text: TextPaintEffects,
+    bounds: [(u64, Bounds<Pixels>); 2],
+}
+
+pub(crate) struct PreparedWord {
+    entry: Rc<RefCell<CachedWord>>,
+    pub(crate) needs_build: bool,
+}
+
+impl PlainTextCacheContext {
+    pub(crate) fn prepare(
+        &self,
+        tree: &RetainedTree,
+        element: &RetainedElement,
+        inherited: &Inherited,
+        intrinsic_text: bool,
+    ) -> Option<PreparedWord> {
+        let mut cache = self.cache.borrow_mut();
+        if !cache.enabled || cache.epoch != self.epoch {
+            return None;
+        }
+        if tree.cache_revision() != Some(self.full_generation) {
+            cache.clear();
+            return None;
+        }
+        if !intrinsic_text
+            || !tree.geometry_refinement_ids.is_empty()
+            || !inherited.text_cache_safe
+            || inherited.highlight.is_some()
+            || element.element_type != "text"
+            || element.content.is_some()
+            || !element.events().is_empty()
+            || !element.custom_props().is_empty()
+            || element.test_id.is_some()
+            || element.auto_focus
+        {
+            return None;
+        }
+        let parent_style = tree.elements.get(&element.parent?)?.style.as_deref()?;
+        if parent_style.display.as_deref() != Some("flex")
+            || parent_style.flex_direction.as_deref() != Some("row")
+            || parent_style.flex_wrap.as_deref() != Some("wrap")
+            || parent_style.align_items.as_deref() != Some("center")
+        {
+            return None;
+        }
+        let [raw_id] = element.children.as_slice() else {
+            return None;
+        };
+        let raw = tree.elements.get(raw_id)?;
+        raw_text_leaf_content(raw)?;
+        let source = WordSource {
+            id: element.id,
+            raw_id: *raw_id,
+            revision: element.subtree_revision,
+            list_id: self.list_id,
+            row_id: self.row_id,
+            selectable: inherited.selectable,
+            wash: inherited.selection_wash,
+        };
+        if let Some(entry) = cache.entries.get(&element.id) {
+            if entry.borrow().source == source {
+                return Some(PreparedWord {
+                    entry: entry.clone(),
+                    needs_build: entry.borrow().captures < 2,
+                });
+            }
+        }
+        if element
+            .style
+            .as_deref()
+            .is_some_and(|style| !style.is_plain_text_cache_style())
+        {
+            return None;
+        }
+        cache.entries.remove(&element.id);
+        if cache.entries.len() >= MAX_WORDS {
+            return None;
+        }
+        let token = cache.next_token.checked_add(1)?;
+        cache.next_token = token;
+        Some(PreparedWord {
+            entry: Rc::new(RefCell::new(CachedWord {
+                source,
+                token,
+                painted_epoch: 0,
+                captures: 0,
+                paint: None,
+            })),
+            needs_build: true,
+        })
+    }
+
+    pub(crate) fn wrap(
+        self,
+        prepared: PreparedWord,
+        build: impl FnOnce(&mut Window, &mut App) -> gpui::AnyElement + 'static,
+    ) -> gpui::AnyElement {
+        let id = prepared.entry.borrow().source.id;
+        let token = prepared.entry.borrow().token;
+        let capture_context = self.clone();
+        let capture_entry = prepared.entry.clone();
+        let reuse_entry = prepared.entry;
+        gpui::cached_element(
+            gpui::ElementId::Integer(id),
+            token,
+            move |window, cx| {
+                CaptureWord {
+                    child: build(window, cx),
+                    entry: capture_entry,
+                    context: capture_context,
+                }
+                .into_any_element()
+            },
+            move |window, _| {
+                let mut entry = reuse_entry.borrow_mut();
+                if let Some(paint) = &entry.paint {
+                    let window_id = window.window_handle().window_id();
+                    paint.text.replay(window_id);
+                    for &(id, bounds) in &paint.bounds {
+                        automation::record_bounds(window_id, id, bounds);
+                    }
+                    entry.painted_epoch = self.epoch;
+                }
+            },
+        )
+        .into_any_element()
+    }
+}
+
+struct CaptureWord {
+    child: gpui::AnyElement,
+    entry: Rc<RefCell<CachedWord>>,
+    context: PlainTextCacheContext,
+}
+
+impl IntoElement for CaptureWord {
+    type Element = Self;
+
+    fn into_element(self) -> Self::Element {
+        self
+    }
+}
+
+impl Element for CaptureWord {
+    type RequestLayoutState = ();
+    type PrepaintState = ();
+
+    fn id(&self) -> Option<gpui::ElementId> {
+        None
+    }
+
+    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        id: Option<&gpui::GlobalElementId>,
+        inspector: Option<&gpui::InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (gpui::LayoutId, ()) {
+        Element::request_layout(&mut self.child, id, inspector, window, cx)
+    }
+
+    fn prepaint(
+        &mut self,
+        id: Option<&gpui::GlobalElementId>,
+        inspector: Option<&gpui::InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        state: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        Element::prepaint(&mut self.child, id, inspector, bounds, state, window, cx);
+    }
+
+    fn paint(
+        &mut self,
+        id: Option<&gpui::GlobalElementId>,
+        inspector: Option<&gpui::InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        state: &mut (),
+        prepaint: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let window_id = window.window_handle().window_id();
+        let marker = text_paint_marker(window_id);
+        Element::paint(
+            &mut self.child,
+            id,
+            inspector,
+            bounds,
+            state,
+            prepaint,
+            window,
+            cx,
+        );
+        let entry = self.entry.borrow();
+        let host_id = entry.source.id;
+        let raw_id = entry.source.raw_id;
+        drop(entry);
+        let Some(host) = automation::get_bounds(window_id, host_id) else {
+            return;
+        };
+        let Some(raw) = automation::get_bounds(window_id, raw_id) else {
+            return;
+        };
+        let to_bounds = |bounds: automation::ElementBounds| {
+            Bounds::new(
+                point(px(bounds.x as f32), px(bounds.y as f32)),
+                size(px(bounds.width as f32), px(bounds.height as f32)),
+            )
+        };
+        let paint = WordPaint {
+            text: text_paint_effects(window_id, marker),
+            bounds: [(host_id, to_bounds(host)), (raw_id, to_bounds(raw))],
+        };
+        let mut cache = self.context.cache.borrow_mut();
+        if !cache.enabled || cache.epoch != self.context.epoch {
+            return;
+        }
+        if cache.entries.len() >= MAX_WORDS && !cache.entries.contains_key(&host_id) {
+            return;
+        }
+        let mut entry = self.entry.borrow_mut();
+        entry.paint = Some(paint);
+        entry.captures = entry.captures.saturating_add(1);
+        entry.painted_epoch = self.context.epoch;
+        drop(entry);
+        cache.entries.insert(host_id, self.entry.clone());
+    }
+}
