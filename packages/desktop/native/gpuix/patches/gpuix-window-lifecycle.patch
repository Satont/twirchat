+            tree.append_child(1, id);
+        }
+        let ids = tree.elements[&1].children.clone();
+        let revisions = ids
+            .iter()
+            .map(|id| tree.elements[id].subtree_revision)
+            .collect();
+        let entry = VirtualListEntry::new(
+            VirtualListConfig::from_element(&tree.elements[&1]),
+            0,
+            ids,
+            revisions,
+            vec![None; 200],
+        );
+        (tree, entry)
+    }
