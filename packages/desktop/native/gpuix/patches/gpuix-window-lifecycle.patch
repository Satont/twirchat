+    #[test]
+    fn one_retention_splice_keeps_all_captured_visible_rows_mounted() {
+        let (mut tree, entry) = captured_list();
+        let captured: Vec<_> = (170..200)
+            .map(|index| (index, entry.child_at(index).expect("captured visible row")))
+            .collect();
+        entry.state.scroll_to(ListOffset {
+            item_ix: 170,
+            offset_in_item: px(7.),
+        });
+        tree.destroy_element(2);
+        tree.create_element(202, "text".into());
+        tree.append_child(1, 202);
+        assert!(
+            captured
+                .iter()
+                .all(|(index, id)| tree.elements[&1].children.get(*index) != Some(id))
+        );
+        assert!(
+            captured
+                .iter()
+                .all(|(_, id)| virtual_child_is_mounted(&tree, 1, *id))
