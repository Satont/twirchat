@@ -0,0 +1,208 @@
+use std::{
+    cell::RefCell,
+    collections::{HashMap, VecDeque},
+    sync::{LazyLock, Once},
+};
+
+use parking_lot::Mutex;
+use tray_icon::{
+    menu::{CheckMenuItem, Menu, MenuEvent, MenuItem, PredefinedMenuItem},
+    Icon, MouseButton, MouseButtonState, TrayIcon, TrayIconBuilder, TrayIconEvent,
+};
+
+const MAX_EVENTS: usize = 32;
+#[cfg(target_os = "windows")]
+const TRAY_GUID: u128 = 0x674dd166_36b8_4773_9cdc_48ade577f2b6;
+static EVENTS: LazyLock<Mutex<HashMap<u64, VecDeque<String>>>> = LazyLock::new(Default::default);
+static HANDLERS: Once = Once::new();
+
+struct TrayState {
+    _icon: TrayIcon,
+    notifications: CheckMenuItem,
+}
+
+thread_local! {
+    static TRAYS: RefCell<HashMap<u64, TrayState>> = RefCell::new(HashMap::new());
+}
+
+fn action_id(renderer_id: u64, action: &str) -> String {
+    format!("twirchat:{renderer_id}:{action}")
+}
+
+fn enqueue(id: &str) {
+    let Some((renderer_id, action)) = id
+        .strip_prefix("twirchat:")
+        .and_then(|id| id.split_once(':'))
+    else {
+        return;
+    };
+    let Ok(renderer_id) = renderer_id.parse::<u64>() else {
+        return;
+    };
+    if !matches!(action, "show" | "notifications" | "quit") {
+        return;
+    }
+    let mut queues = EVENTS.lock();
+    let Some(queue) = queues.get_mut(&renderer_id) else {
+        return;
+    };
+    if queue.len() < MAX_EVENTS {
+        queue.push_back(action.to_string());
+    }
+}
+
+pub(crate) fn configure(
+    renderer_id: u64,
+    enabled: bool,
+    notifications_enabled: bool,
+) -> Result<(), String> {
+    if !enabled {
+        remove(renderer_id);
+        return Ok(());
+    }
+    HANDLERS.call_once(|| {
+        MenuEvent::set_event_handler(Some(|event: MenuEvent| enqueue(event.id.as_ref())));
+        TrayIconEvent::set_event_handler(Some(|event| {
+            if let TrayIconEvent::Click {
+                id,
+                button: MouseButton::Left,
+                button_state: MouseButtonState::Up,
+                ..
+            } = event
+            {
+                enqueue(id.as_ref());
+            }
+        }));
+    });
+    TRAYS.with(|trays| {
+        let mut trays = trays.borrow_mut();
+        if let Some(tray) = trays.get_mut(&renderer_id) {
+            tray.notifications.set_checked(notifications_enabled);
+            return Ok(());
+        }
+        let menu = Menu::new();
+        let show = MenuItem::with_id(action_id(renderer_id, "show"), "Open TwirChat", true, None);
+        let notifications = CheckMenuItem::with_id(
+            action_id(renderer_id, "notifications"),
+            "Mention notifications",
+            true,
+            notifications_enabled,
+            None,
+        );
+        let quit = MenuItem::with_id(action_id(renderer_id, "quit"), "Quit TwirChat", true, None);
+        menu.append_items(&[
+            &show,
+            &notifications,
+            &PredefinedMenuItem::separator(),
+            &quit,
+        ])
+        .map_err(|error| error.to_string())?;
+        let icon = Icon::from_rgba(include_bytes!("tray-icon.rgba").to_vec(), 32, 32)
+            .map_err(|error| error.to_string())?;
+        let builder = TrayIconBuilder::new()
+            .with_id(action_id(renderer_id, "show"))
+            .with_tooltip("TwirChat")
+            .with_icon(icon)
+            .with_menu(Box::new(menu))
+            .with_menu_on_left_click(false);
+        #[cfg(target_os = "windows")]
+        let builder = builder.with_guid(TRAY_GUID);
+        let icon = builder.build().map_err(|error| error.to_string())?;
+        EVENTS.lock().insert(renderer_id, VecDeque::new());
+        trays.insert(
+            renderer_id,
+            TrayState {
+                _icon: icon,
+                notifications,
+            },
+        );
+        Ok(())
+    })
+}
+
+pub(crate) fn remove(renderer_id: u64) {
+    EVENTS.lock().remove(&renderer_id);
+    TRAYS.with(|trays| {
+        trays.borrow_mut().remove(&renderer_id);
+    });
+}
+
+pub(crate) fn take_events(renderer_id: u64) -> Vec<String> {
+    EVENTS
+        .lock()
+        .get_mut(&renderer_id)
+        .map(|queue| queue.drain(..).collect())
+        .unwrap_or_default()
+}
+
+#[cfg(target_os = "windows")]
+fn notification_text<const N: usize>(text: &str) -> [u16; N] {
+    let mut output = [0; N];
+    let mut written = 0;
+    for character in text.chars() {
+        let mut units = [0; 2];
+        let encoded = character.encode_utf16(&mut units);
+        if written + encoded.len() >= N {
+            break;
+        }
+        output[written..written + encoded.len()].copy_from_slice(encoded);
+        written += encoded.len();
+    }
+    output
+}
+
+pub(crate) fn notify(renderer_id: u64, title: &str, body: &str) -> Result<bool, String> {
+    #[cfg(target_os = "windows")]
+    {
+        use windows::{
+            core::GUID,
+            Win32::{Foundation::HWND, UI::Shell::*},
+        };
+        TRAYS.with(|trays| {
+            let trays = trays.borrow();
+            let Some(tray) = trays.get(&renderer_id) else {
+                return Ok(false);
+            };
+            let mut data = NOTIFYICONDATAW::default();
+            data.cbSize = u32::try_from(std::mem::size_of::<NOTIFYICONDATAW>())
+                .map_err(|error| error.to_string())?;
+            data.hWnd = HWND(tray._icon.window_handle());
+            data.guidItem = GUID::from_u128(TRAY_GUID);
+            data.uFlags = NIF_GUID | NIF_INFO;
+            data.dwInfoFlags = NIIF_INFO | NIIF_NOSOUND;
+            data.szInfoTitle = notification_text(title);
+            data.szInfo = notification_text(body);
+            if unsafe { Shell_NotifyIconW(NIM_MODIFY, &data) }.as_bool() {
+                Ok(true)
+            } else {
+                Err("Windows rejected the tray notification.".to_string())
+            }
+        })
+    }
+    #[cfg(not(target_os = "windows"))]
+    {
+        let _ = (renderer_id, title, body);
+        Ok(false)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn event_routing_is_bounded_and_ignores_retired_trays() {
+        let id = u64::MAX;
+        EVENTS.lock().insert(id, VecDeque::new());
+        for _ in 0..100 {
+            enqueue(&action_id(id, "show"));
+        }
+        assert_eq!(take_events(id).len(), MAX_EVENTS);
+        assert!(take_events(id).is_empty());
+        enqueue(&action_id(id, "unknown"));
+        assert!(take_events(id).is_empty());
+        EVENTS.lock().remove(&id);
+        enqueue(&action_id(id, "show"));
+        assert!(take_events(id).is_empty());
+    }
+}
