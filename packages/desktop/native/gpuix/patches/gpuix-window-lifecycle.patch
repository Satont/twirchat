+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn validate_bounds_update(update: &NativeWindowBoundsUpdate) -> Result<()> {
+    for (name, value, positive) in [
+        ("x", update.x, false),
+        ("y", update.y, false),
+        ("width", update.width, true),
+        ("height", update.height, true),
+    ] {
+        if value.is_some_and(|value| {
+            !value.is_finite() || value.abs() > i32::MAX as f64 || (positive && value <= 0.0)
+        }) {
+            return Err(Error::from_reason(format!("Invalid window {name}")));
+        }
+    }
+    if update
+        .mode
+        .as_deref()
+        .is_some_and(|mode| !matches!(mode, "windowed" | "maximized" | "fullscreen"))
+    {
+        return Err(Error::from_reason(
+            "Window mode must be windowed, maximized, or fullscreen",
+        ));
+    }
+    Ok(())
+}
