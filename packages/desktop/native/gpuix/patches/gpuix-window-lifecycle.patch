+    #[test]
+    fn last_queue_sender_wakes_all_idle_workers() {
+        let (sender, receiver) = gpui::PriorityQueueReceiver::<u8>::new();
+        let barrier = Arc::new(std::sync::Barrier::new(4));
+        let (done, completed) = std::sync::mpsc::channel();
+        let mut threads = Vec::new();
+        for mut worker in [receiver.clone(), receiver.clone(), receiver] {
+            let barrier = barrier.clone();
+            let done = done.clone();
+            threads.push(std::thread::spawn(move || {
+                barrier.wait();
+                done.send(worker.pop().is_err()).unwrap();
+            }));
+        }
+        barrier.wait();
+        std::thread::sleep(Duration::from_millis(20));
+        drop(sender);
+        for _ in 0..3 {
+            assert!(completed.recv_timeout(Duration::from_secs(2)).unwrap());
+        }
+        for thread in threads {
+            thread.join().unwrap();
+        }
+    }
