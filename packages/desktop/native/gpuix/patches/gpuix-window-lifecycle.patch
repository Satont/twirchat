+    #[napi]
+    pub fn get_window_visibility(&self) -> String {
+        let state = self.window_state.lock();
+        if !state.open {
+            return "hidden".into();
+        }
+        match state
+            .visibility
+            .as_ref()
+            .map(|visibility| visibility.load(std::sync::atomic::Ordering::Acquire))
+        {
+            Some(1) => "visible",
+            Some(2) => "hidden",
+            _ => "unknown",
+        }
+        .into()
+    }
