+fn retain_current_seen_rows(seen_rows: &mut HashSet<u64>, child_ids: &[u64]) {
+    if seen_rows.is_empty() {
+        return;
+    }
+    let current_rows: HashSet<u64> = child_ids.iter().copied().collect();
+    seen_rows.retain(|id| current_rows.contains(id));
+}
+
+fn virtual_list_overlap(
+    previous: &[u64],
+    current: &[u64],
+) -> Option<(std::ops::Range<usize>, std::ops::Range<usize>)> {
+    let first = current.first()?;
+    if let Some(start) = previous.iter().position(|id| id == first) {
+        let retained = previous.len() - start;
+        if start > 0 && retained <= current.len() && previous[start..] == current[..retained] {
+            return Some((start..previous.len(), 0..retained));
+        }
+    }
+    let first = previous.first()?;
+    let start = current.iter().position(|id| id == first)?;
+    let retained = current.len() - start;
+    (start > 0 && retained <= previous.len() && current[start..] == previous[..retained])
+        .then_some((0..retained, start..current.len()))
+}
+
+fn splice_virtual_list_children(
+    state: &gpui::ListState,
+    previous: &[u64],
+    current: &[u64],
+    focus_handles: &[Option<gpui::FocusHandle>],
+) {
+    if let Some((old, new)) = virtual_list_overlap(previous, current) {
+        // Keep the shared rows themselves so their measured heights and scroll anchor survive.
+        if old.end < previous.len() {
+            state.splice(old.end..previous.len(), 0);
+        }
+        if old.start > 0 {
+            state.splice(0..old.start, 0);
+        }
+        if new.end < current.len() {
+            state.splice_focusable(
+                old.len()..old.len(),
+                focus_handles[new.end..].iter().cloned(),
+            );
+        }
+        if new.start > 0 {
+            state.splice_focusable(0..0, focus_handles[..new.start].iter().cloned());
+        }
+        return;
+    }
+    let prefix = previous
+        .iter()
+        .zip(current)
+        .take_while(|(old, new)| old == new)
+        .count();
+    let suffix = previous[prefix..]
+        .iter()
+        .rev()
+        .zip(current[prefix..].iter().rev())
+        .take_while(|(old, new)| old == new)
+        .count();
+    state.splice_focusable(
+        prefix..previous.len() - suffix,
+        focus_handles[prefix..focus_handles.len() - suffix]
+            .iter()
+            .cloned(),
+    );
+}
