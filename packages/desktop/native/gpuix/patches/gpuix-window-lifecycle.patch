+
+#[cfg(test)]
+mod painted_bounds_snapshot_tests {
+    use super::{ElementBounds, PaintedBoundsSnapshot, PaintedBoundsState};
+    use std::collections::HashMap;
+    use std::sync::Arc;
+
+    fn bounds(x: f64) -> ElementBounds {
+        ElementBounds {
+            x,
+            y: 2.,
+            width: 30.,
+            height: 40.,
+        }
+    }
+
+    #[test]
+    fn publication_shares_the_completed_map_without_copying() {
+        let snapshot = PaintedBoundsSnapshot::default();
+        assert!(snapshot.get(1).is_none());
+        let painted = Arc::new(HashMap::from([(1, bounds(10.))]));
+        snapshot.publish(painted.clone());
+        let state = snapshot.state.lock();
+        let PaintedBoundsState::Painted(shared) = &*state else {
+            panic!("Expected completed paint");
+        };
+        assert!(Arc::ptr_eq(shared, &painted));
+    }
+
+    #[test]
+    fn published_frames_remain_immutable_and_removed_elements_disappear() {
+        let snapshot = PaintedBoundsSnapshot::default();
+        let mut first = Arc::new(HashMap::from([(1, bounds(10.)), (2, bounds(20.))]));
+        snapshot.publish(first.clone());
+        Arc::make_mut(&mut first).insert(1, bounds(50.));
+        assert_eq!(snapshot.get(1).map(|bounds| bounds.x), Some(10.));
+        let second = Arc::new(HashMap::from([(1, bounds(70.))]));
+        snapshot.publish(second);
+        assert_eq!(snapshot.get(1).map(|bounds| bounds.x), Some(70.));
+        assert!(snapshot.get(2).is_none());
+    }
+
+    #[test]
+    fn windows_are_independent_and_close_rejects_late_paints() {
+        let first = PaintedBoundsSnapshot::default();
+        let second = PaintedBoundsSnapshot::default();
+        let painted = Arc::new(HashMap::from([(1, bounds(10.))]));
+        let weak = Arc::downgrade(&painted);
+        first.publish(painted);
+        second.publish(Arc::new(HashMap::from([(1, bounds(20.))])));
+        first.close();
+        assert!(weak.upgrade().is_none());
+        first.publish(Arc::new(HashMap::from([(1, bounds(30.))])));
+        assert!(first.get(1).is_none());
+        assert_eq!(second.get(1).map(|bounds| bounds.x), Some(20.));
+    }
+
+    #[test]
+    fn reads_never_wait_for_a_snapshot_writer() {
+        let snapshot = PaintedBoundsSnapshot::default();
+        snapshot.publish(Arc::new(HashMap::from([(1, bounds(10.))])));
+        let _writer = snapshot.state.lock();
+        assert!(snapshot.get(1).is_none());
+    }
+}
