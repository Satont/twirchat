+// A window can close while operations remain in the UI command queue. Reject
+// cancelled work when its queue/task is dropped instead of leaving JS awaiting it.
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+struct PendingWindowOperation<T: ToNapiValue> {
+    deferred: Option<JsDeferred<T, Box<dyn FnOnce(Env) -> Result<T> + Send>>>,
+}
+
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+impl<T: ToNapiValue> PendingWindowOperation<T> {
+    fn resolve(mut self, resolver: Box<dyn FnOnce(Env) -> Result<T> + Send>) {
+        if let Some(deferred) = self.deferred.take() {
+            deferred.resolve(resolver);
+        }
+    }
+
+    fn reject(mut self, error: Error) {
+        if let Some(deferred) = self.deferred.take() {
+            deferred.reject(error);
+        }
+    }
+}
+
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+impl<T: ToNapiValue> From<JsDeferred<T, Box<dyn FnOnce(Env) -> Result<T> + Send>>>
+    for PendingWindowOperation<T>
+{
+    fn from(deferred: JsDeferred<T, Box<dyn FnOnce(Env) -> Result<T> + Send>>) -> Self {
+        Self {
+            deferred: Some(deferred),
+        }
+    }
+}
+
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+impl<T: ToNapiValue> Drop for PendingWindowOperation<T> {
+    fn drop(&mut self) {
+        if let Some(deferred) = self.deferred.take() {
+            deferred.reject(Error::from_reason(
+                "Window closed before the operation completed",
+            ));
+        }
+    }
+}
