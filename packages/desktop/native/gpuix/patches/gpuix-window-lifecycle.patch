+fn capture_native_window(
+    window: &gpui::Window,
+    state: &Arc<parking_lot::Mutex<NativeWindowState>>,
+) {
+    let origin = window.bounds().origin;
+    let size = window.viewport_size();
+    let capabilities = window.native_window_capabilities();
+    let mut state = state.lock();
+    state.open = true;
+    state.active = window.is_window_active();
+    state.visibility = window.native_window_visibility_state();
+    state.bounds = Some(NativeWindowBounds {
+        x: f32::from(origin.x) as f64,
+        y: f32::from(origin.y) as f64,
+        width: f32::from(size.width) as f64,
+        height: f32::from(size.height) as f64,
+        mode: if window.is_fullscreen() {
+            "fullscreen"
+        } else if window.is_maximized() {
+            "maximized"
+        } else {
+            "windowed"
+        }
+        .into(),
+    });
+    state.capabilities = NativeWindowCapabilities {
+        position: capabilities.position,
+        click_through: capabilities.pointer_passthrough,
+    };
+}
