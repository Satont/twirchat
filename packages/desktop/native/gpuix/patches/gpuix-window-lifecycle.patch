+            subscriptions.borrow_mut().insert(window_id, subscription);
+        });
+    }
+    let state = Arc::downgrade(&state);
+    let subscription = cx.on_window_closed(move |cx, closed| {
+        if closed != window_id {
+            return;
+        }
+        if let Some(state) = state.upgrade() {
+            let mut state = state.lock();
+            state.open = false;
+            state.active = false;
+            state.painted_bounds.close();
+            state.hotkeys.cancel();
+        }
+        crate::tray::remove(renderer_id);
+        SCROLL_HANDLES.with(|windows| {
+            windows.borrow_mut().remove(&window_id);
+        });
+        VIRTUAL_LIST_STATES.with(|windows| {
+            windows.borrow_mut().remove(&window_id);
+        });
+        PENDING_VIRTUAL_LIST_SCROLLS.with(|windows| {
+            windows.borrow_mut().remove(&window_id);
+        });
+        #[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+        WINDOW_COMMAND_TASKS.with(|tasks| {
+            tasks.borrow_mut().remove(&window_id);
+        });
+        crate::automation::remove_window_bounds(window_id);
+        crate::text::clear_window_text_state(window_id);
+        #[cfg(target_os = "macos")]
+        {
+            GPUI_WINDOWS.with(|windows| {
+                windows.borrow_mut().remove(&renderer_id);
+            });
+            FRAME_WAKE_CALLBACKS.lock().remove(&renderer_id);
+        }
+        #[cfg(not(target_os = "macos"))]
+        let _ = renderer_id;
+        cx.defer(move |_| {
+            WINDOW_LIFECYCLE_SUBSCRIPTIONS.with(|subscriptions| {
+                subscriptions.borrow_mut().remove(&window_id);
+            });
+            WINDOW_HOTKEY_SUBSCRIPTIONS.with(|subscriptions| {
+                subscriptions.borrow_mut().remove(&window_id);
+            });
+        });
+    });
+    WINDOW_LIFECYCLE_SUBSCRIPTIONS.with(|subscriptions| {
+        subscriptions.borrow_mut().insert(window_id, subscription);
+    });
+}
