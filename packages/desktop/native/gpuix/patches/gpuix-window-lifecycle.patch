+pub(crate) struct PaintedBoundsSnapshot {
+    state: parking_lot::Mutex<PaintedBoundsState>,
+}
+
+impl PaintedBoundsSnapshot {
+    pub(crate) fn publish(&self, bounds: Arc<HashMap<u64, ElementBounds>>) {
+        let mut state = self.state.lock();
+        if matches!(*state, PaintedBoundsState::Closed) {
+            drop(state);
+            return;
+        }
+        let previous = std::mem::replace(&mut *state, PaintedBoundsState::Painted(bounds));
+        drop(state);
+        drop(previous);
+    }
+
+    pub(crate) fn get(&self, id: u64) -> Option<ElementBounds> {
+        let state = self.state.try_lock()?;
+        match &*state {
+            PaintedBoundsState::Painted(bounds) => bounds.get(&id).copied(),
+            PaintedBoundsState::Pending | PaintedBoundsState::Closed => None,
+        }
+    }
+
+    pub(crate) fn close(&self) {
+        let mut state = self.state.lock();
+        let previous = std::mem::replace(&mut *state, PaintedBoundsState::Closed);
+        drop(state);
+        drop(previous);
+    }
 }
 
