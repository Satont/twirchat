+    fn last_queue_receiver_drops_pending_sender_cycle() {
+        type Pending = Box<dyn FnOnce() + Send>;
+        let (sender, receiver) = gpui::PriorityQueueReceiver::<Pending>::new();
+        let sender = Arc::new(sender);
+        let weak = Arc::downgrade(&sender);
+        let retained = sender.clone();
+        assert!(
+            sender
+                .send(gpui::Priority::Medium, Box::new(move || drop(retained)))
+                .is_ok()
+        );
+        drop(sender);
+        assert!(weak.upgrade().is_some());
+        drop(receiver);
+        assert!(weak.upgrade().is_none());
+    }
