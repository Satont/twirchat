+    #[napi(ts_return_type = "Promise<boolean>")]
+    pub fn run_text_input_action<'env>(
+        &self,
+        env: &'env Env,
+        name: String,
+    ) -> Result<Object<'env>> {
+        native_text_action(&name)?;
+        let (deferred, promise): (TextActionDeferred, Object<'env>) = env.create_deferred()?;
+        #[cfg(target_os = "macos")]
+        {
+            let can_copy = update_window(self.renderer_id, |view, window, cx| {
+                view.can_copy_native_selection(&name, window, cx)
+            });
+            let result = can_copy.and_then(|can_copy| {
+                update_window_without_view(self.renderer_id, |window, cx| {
+                    let action = native_text_action(&name)?;
+                    let available = can_copy && window.is_action_available(action.as_ref(), cx);
+                    if available {
+                        window.dispatch_action(action, cx);
+                    }
+                    Ok(available)
+                })
+            });
+            match result {
+                Ok(Ok(available)) => deferred.resolve(Box::new(move |_| Ok(available))),
+                Ok(Err(error)) | Err(error) => deferred.reject(error),
+            }
+        }
+        #[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+        self.send_window_operation(UiCommand::RunTextInputAction {
+            name,
+            deferred: deferred.into(),
+        });
+        Ok(promise)
+    }
