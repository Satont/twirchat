+    #[test]
+    fn destroyed_or_reparented_rows_are_not_resurrected() {
+        let (mut tree, entry) = captured_list();
+        let moved = entry.child_at(170).expect("captured row");
+        let destroyed = entry.child_at(171).expect("captured row");
+        tree.create_element(999, "virtual-list".into());
