--- /dev/null
+++ b/packages/native/src/hotkey_capture.rs
@@ -0,0 +1,470 @@
+//! Window-local shortcut interception before GPUI's editor keybindings.
+use std::collections::HashSet;
+use std::time::{Duration, Instant};
+
+use serde::Deserialize;
+
+const MODIFIERS: [&str; 4] = ["ctrl", "cmd", "alt", "shift"];
+const MAX_GENERATION: u64 = 9_007_199_254_740_991;
+const PREFIX_TIMEOUT: Duration = Duration::from_secs(1);
+
+#[derive(Clone, Debug, Default, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct CapturePlan {
+    pub generation: u64,
+    pub bindings: Vec<CaptureBinding>,
+    #[serde(default)]
+    pub record_all: bool,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct CaptureBinding {
+    pub id: String,
+    pub context_id: String,
+    pub keys: Vec<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct CaptureDecision {
+    pub generation: u64,
+    pub binding_id: Option<String>,
+    pub context_id: Option<String>,
+    pub prefix: bool,
+    pub recorded: bool,
+}
+
+struct Pending {
+    keys: Vec<String>,
+    context_id: String,
+    focus: Option<u64>,
+    at: Instant,
+}
+
+#[derive(Default)]
+pub(crate) struct HotkeyCapture {
+    plan: CapturePlan,
+    pending: Option<Pending>,
+}
+
+fn alias(key: &str) -> &str {
+    match key {
+        "control" => "ctrl",
+        "command" | "meta" | "super" => "cmd",
+        "option" => "alt",
+        "return" | "numpadenter" | "numpad-enter" => "enter",
+        "esc" => "escape",
+        "arrowleft" => "left",
+        "arrowright" => "right",
+        "arrowup" => "up",
+        "arrowdown" => "down",
+        "pgup" => "pageup",
+        "pgdown" => "pagedown",
+        "spacebar" => "space",
+        other => other,
+    }
+}
+
+pub(crate) fn normalize_chord(value: &str) -> Result<String, String> {
+    let mut input = value.trim().to_lowercase();
+    if input == "+" {
+        input = "plus".into();
+    } else if input.ends_with("++") {
+        input.pop();
+        input.push_str("plus");
+    }
+    let parts: Vec<&str> = input.split('+').map(|part| alias(part.trim())).collect();
+    let keys: Vec<&str> = parts
+        .iter()
+        .copied()
+        .filter(|part| !MODIFIERS.contains(part))
+        .collect();
+    if keys.len() != 1
+        || keys[0].is_empty()
+        || keys[0].chars().any(char::is_whitespace)
+        || parts.iter().copied().collect::<HashSet<_>>().len() != parts.len()
+    {
+        return Err(
+            "A shortcut chord needs one key and unique Ctrl/Cmd/Alt/Shift modifiers".into(),
+        );
+    }
+    let mut normalized: Vec<&str> = MODIFIERS
+        .into_iter()
+        .filter(|modifier| parts.contains(modifier))
+        .collect();
+    normalized.push(keys[0]);
+    Ok(normalized.join("+"))
+}
+
+pub(crate) fn event_chord(keystroke: &gpui::Keystroke) -> Option<String> {
+    let key = keystroke.key.to_lowercase();
+    if MODIFIERS.contains(&alias(&key)) || matches!(key.as_str(), "fn" | "function" | "platform") {
+        return None;
+    }
+    let mut parts = Vec::with_capacity(5);
+    if keystroke.modifiers.control {
+        parts.push("ctrl");
+    }
+    if keystroke.modifiers.platform {
+        parts.push("cmd");
+    }
+    if keystroke.modifiers.alt {
+        parts.push("alt");
+    }
+    if keystroke.modifiers.shift {
+        parts.push("shift");
+    }
+    parts.push(if key == "+" { "plus" } else { &key });
+    normalize_chord(&parts.join("+")).ok()
+}
+
+impl CapturePlan {
+    pub fn parse(json: &str) -> Result<Self, String> {
+        if json.len() > 2_000_000 {
+            return Err("Shortcut capture plan is too large".into());
+        }
+        let mut plan: Self = serde_json::from_str(json)
+            .map_err(|error| format!("Invalid shortcut capture plan: {error}"))?;
+        if plan.generation > MAX_GENERATION {
+            return Err("Shortcut generation must be a safe integer".into());
+        }
+        if plan.bindings.len() > 520 {
+            return Err("Capture at most 520 shortcuts".into());
+        }
+        let mut identities = HashSet::new();
+        for binding in &mut plan.bindings {
+            if binding.id.is_empty()
+                || binding.id.len() > 128
+                || binding.context_id.is_empty()
+                || binding.context_id.len() > 512
+                || !identities.insert((binding.id.clone(), binding.context_id.clone()))
+            {
+                return Err(
+                    "Shortcut binding/context identities must be bounded and unique".into(),
+                );
+            }
+            if binding.keys.is_empty() || binding.keys.len() > 4 {
+                return Err("Use between one and four shortcut chords".into());
+            }
+            for chord in &mut binding.keys {
+                if chord.len() > 128 {
+                    return Err("Shortcut chord is too long".into());
+                }
+                *chord = normalize_chord(chord)?;
+            }
+        }
+        Ok(plan)
+    }
+}
+
+impl HotkeyCapture {
+    pub fn set_plan(&mut self, plan: CapturePlan) {
+        if self.plan != plan {
+            self.pending = None;
+            self.plan = plan;
+        }
+    }
+    pub fn cancel(&mut self) {
+        self.pending = None;
+    }
+
+    pub fn capture(
+        &mut self,
+        chord: &str,
+        focus: Option<u64>,
+        now: Instant,
+    ) -> Option<CaptureDecision> {
+        if self.plan.record_all {
+            self.pending = None;
+            return Some(CaptureDecision {
+                generation: self.plan.generation,
+                binding_id: None,
+                context_id: None,
+                prefix: false,
+                recorded: true,
+            });
+        }
+        if let Some(pending) = self.pending.take().filter(|pending| {
+            pending.focus == focus && now.saturating_duration_since(pending.at) <= PREFIX_TIMEOUT
+        }) {
+            let mut sequence = pending.keys;
+            sequence.push(chord.into());
+            if let Some(decision) =
+                self.match_sequence(&sequence, Some(&pending.context_id), focus, now)
+            {
+                return Some(decision);
+            }
+        }
+        self.match_sequence(&[chord.into()], None, focus, now)
+    }
+
+    fn match_sequence(
+        &mut self,
+        keys: &[String],
+        context: Option<&str>,
+        focus: Option<u64>,
+        now: Instant,
+    ) -> Option<CaptureDecision> {
+        let matches = |binding: &&CaptureBinding| {
+            binding.keys.starts_with(keys)
+                && context.is_none_or(|context| binding.context_id == context)
+        };
+        let chosen = self.plan.bindings.iter().find(matches)?;
+        let context_id = chosen.context_id.clone();
+        let exact = self
+            .plan
+            .bindings
+            .iter()
+            .find(|binding| binding.context_id == context_id && binding.keys == keys);
+        let binding_id = exact.map(|binding| binding.id.clone());
+        let prefix = binding_id.is_none();
+        if prefix {
+            self.pending = Some(Pending {
+                keys: keys.to_vec(),
+                context_id: context_id.clone(),
+                focus,
+                at: now,
+            });
+        }
+        Some(CaptureDecision {
+            generation: self.plan.generation,
+            binding_id,
+            context_id: Some(context_id),
+            prefix,
+            recorded: false,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn plan(generation: u64, entries: &[(&str, &str, &[&str])]) -> CapturePlan {
+        CapturePlan::parse(&serde_json::json!({
+            "generation": generation,
+            "bindings": entries.iter().map(|(id, context, keys)| serde_json::json!({ "id": id, "contextId": context, "keys": keys })).collect::<Vec<_>>()
+        }).to_string()).expect("valid plan")
+    }
+    fn captured_id(capture: &mut HotkeyCapture, key: &str, time: Instant) -> Option<String> {
+        capture
+            .capture(key, Some(1), time)
+            .and_then(|decision| decision.binding_id)
+    }
+
+    #[test]
+    fn canonical_chords_match_js_order_and_aliases() {
+        assert_eq!(
+            normalize_chord(" Shift + Control + ArrowRight ").unwrap(),
+            "ctrl+shift+right"
+        );
+        assert_eq!(
+            normalize_chord("command+option+ctrl+shift+x").unwrap(),
+            "ctrl+cmd+alt+shift+x"
+        );
+        assert_eq!(normalize_chord("ctrl++").unwrap(), "ctrl+plus");
+        assert_eq!(normalize_chord("+").unwrap(), "plus");
+        for key in [
+            "",
+            "ctrl",
+            "ctrl+control+x",
+            "ctrl+x+y",
+            "ctrl+ ",
+            "ctrl+foo bar",
+        ] {
+            assert!(normalize_chord(key).is_err(), "{key}");
+        }
+        let keystroke = gpui::Keystroke {
+            key: "ArrowRight".into(),
+            key_char: None,
+            modifiers: gpui::Modifiers {
+                control: true,
+                platform: true,
+                alt: true,
+                shift: true,
+                ..Default::default()
+            },
+        };
+        assert_eq!(
+            event_chord(&keystroke).as_deref(),
+            Some("ctrl+cmd+alt+shift+right")
+        );
+        for key in [
+            "ctrl", "control", "shift", "alt", "super", "meta", "fn", "function",
+        ] {
+            assert!(event_chord(&gpui::Keystroke {
+                key: key.into(),
+                key_char: None,
+                modifiers: Default::default()
+            })
+            .is_none());
+        }
+    }
+
+    #[test]
+    fn captures_only_available_plan_entries() {
+        let now = Instant::now();
+        let mut capture = HotkeyCapture::default();
+        assert!(capture.capture("ctrl+right", None, now).is_none());
+        capture.set_plan(plan(7, &[("emotes", "input", &["ctrl+right"])]));
+        let event = capture.capture("ctrl+right", None, now).unwrap();
+        assert_eq!(event.binding_id.as_deref(), Some("emotes"));
+        assert_eq!(event.context_id.as_deref(), Some("input"));
+        assert_eq!(event.generation, 7);
+        assert!(!event.prefix);
+        assert!(!event.recorded);
+        assert!(capture.capture("right", None, now).is_none());
+        capture.set_plan(plan(8, &[]));
+        assert!(capture.capture("ctrl+right", None, now).is_none());
+    }
+
+    #[test]
+    fn fast_unmodified_sequence_strokes_are_captured_without_a_js_ack() {
+        let now = Instant::now();
+        let mut capture = HotkeyCapture::default();
+        capture.set_plan(plan(1, &[("three", "input", &["ctrl+k", "x", "c"])]));
+        assert!(capture.capture("x", Some(1), now).is_none());
+        assert!(capture.capture("ctrl+k", Some(1), now).unwrap().prefix);
+        assert!(capture.capture("x", Some(1), now).unwrap().prefix);
+        assert_eq!(
+            captured_id(&mut capture, "c", now).as_deref(),
+            Some("three")
+        );
+        assert!(capture.capture("x", Some(1), now).is_none());
+    }
+
+    #[test]
+    fn unmatched_native_reserved_key_cancels_prefix_before_a_new_first_stroke() {
+        let now = Instant::now();
+        let mut capture = HotkeyCapture::default();
+        capture.set_plan(plan(
+            1,
+            &[
+                ("sequence", "input", &["ctrl+k", "x"]),
+                ("fresh", "input", &["x"]),
+            ],
+        ));
+        assert!(capture.capture("ctrl+k", Some(1), now).unwrap().prefix);
+        assert!(capture.capture("ctrl+right", Some(1), now).is_none());
+        assert_eq!(
+            captured_id(&mut capture, "x", now).as_deref(),
+            Some("fresh")
+        );
+    }
+
+    #[test]
+    fn route_priority_locks_the_original_context_for_a_pending_sequence() {
+        let now = Instant::now();
+        let mut capture = HotkeyCapture::default();
+        capture.set_plan(plan(
+            1,
+            &[
+                ("upper", "popup", &["ctrl+k", "x"]),
+                ("lower", "input", &["ctrl+k", "y"]),
+            ],
+        ));
+        assert_eq!(
+            capture
+                .capture("ctrl+k", Some(1), now)
+                .unwrap()
+                .context_id
+                .as_deref(),
+            Some("popup")
+        );
+        assert!(capture.capture("y", Some(1), now).is_none());
+        assert!(capture.capture("ctrl+k", Some(1), now).unwrap().prefix);
+        assert_eq!(
+            captured_id(&mut capture, "x", now).as_deref(),
+            Some("upper")
+        );
+    }
+
+    #[test]
+    fn expires_prefix_after_one_second_and_on_focus_or_plan_change() {
+        let now = Instant::now();
+        let plan = plan(1, &[("sequence", "input", &["ctrl+k", "x"])]);
+        let mut capture = HotkeyCapture::default();
+        capture.set_plan(plan.clone());
+        capture.capture("ctrl+k", Some(1), now);
+        assert!(capture
+            .capture("x", Some(1), now + Duration::from_millis(1001))
+            .is_none());
+        capture.capture("ctrl+k", Some(1), now);
+        assert!(capture.capture("x", Some(2), now).is_none());
+        capture.capture("ctrl+k", Some(1), now);
+        let mut updated = plan.clone();
+        updated.generation = 2;
+        capture.set_plan(updated);
+        assert!(capture.capture("x", Some(1), now).is_none());
+        capture.set_plan(plan);
+        capture.capture("ctrl+k", Some(1), now);
+        capture.cancel();
+        assert!(capture.capture("x", Some(1), now).is_none());
+    }
+
+    #[test]
+    fn identical_plan_publication_does_not_interrupt_a_sequence() {
+        let now = Instant::now();
+        let plan = plan(1, &[("sequence", "input", &["ctrl+k", "x"])]);
+        let mut capture = HotkeyCapture::default();
+        capture.set_plan(plan.clone());
+        capture.capture("ctrl+k", Some(1), now);
+        capture.set_plan(plan);
+        assert_eq!(
+            captured_id(&mut capture, "x", now).as_deref(),
+            Some("sequence")
+        );
+    }
+
+    #[test]
+    fn recorder_captures_reserved_keys_and_plain_characters_without_executing_bindings() {
+        let now = Instant::now();
+        let mut capture = HotkeyCapture::default();
+        let mut recording = plan(44, &[("binding", "input", &["ctrl+right"])]);
+        recording.record_all = true;
+        capture.set_plan(recording);
+        for chord in ["ctrl+right", "escape", "enter", "tab", "x"] {
+            let event = capture.capture(chord, Some(1), now).unwrap();
+            assert!(event.recorded);
+            assert!(!event.prefix);
+            assert_eq!(event.generation, 44);
+            assert_eq!(event.binding_id, None);
+            assert_eq!(event.context_id, None);
+        }
+    }
+
+    #[test]
+    fn window_plans_and_pending_sequences_are_independent() {
+        let now = Instant::now();
+        let mut a = HotkeyCapture::default();
+        let mut b = HotkeyCapture::default();
+        a.set_plan(plan(1, &[("a", "same-id", &["ctrl+k", "x"])]));
+        b.set_plan(plan(2, &[("b", "same-id", &["ctrl+right"])]));
+        a.capture("ctrl+k", Some(1), now);
+        assert!(b.capture("x", Some(1), now).is_none());
+        assert_eq!(captured_id(&mut b, "ctrl+right", now).as_deref(), Some("b"));
+        assert_eq!(captured_id(&mut a, "x", now).as_deref(), Some("a"));
+    }
+
+    #[test]
+    fn validates_bounded_plans_and_normalizes_aliases_before_publication() {
+        let valid = CapturePlan::parse(r#"{"generation":3,"bindings":[{"id":"a","contextId":"input","keys":["Control+ArrowRight"]}]}"#).unwrap();
+        assert_eq!(valid.bindings[0].keys, ["ctrl+right"]);
+        for json in [
+            r#"{}"#,
+            r#"{"generation":-1,"bindings":[]}"#,
+            r#"{"generation":1.5,"bindings":[]}"#,
+            r#"{"generation":9007199254740992,"bindings":[]}"#,
+            r#"{"generation":1,"bindings":[],"recordAll":"yes"}"#,
+            r#"{"generation":1,"bindings":[{"id":"","contextId":"input","keys":["x"]}]}"#,
+        ] {
+            assert!(CapturePlan::parse(json).is_err(), "{json}");
+        }
+        let duplicate = serde_json::json!({"generation":1,"bindings":[{"id":"a","contextId":"input","keys":["x"]},{"id":"a","contextId":"input","keys":["y"]}]});
+        assert!(CapturePlan::parse(&duplicate.to_string()).is_err());
+        let boundary = serde_json::json!({"generation":1,"bindings":(0..520).map(|id| serde_json::json!({"id":id.to_string(),"contextId":"input","keys":["x"]})).collect::<Vec<_>>()});
+        assert!(CapturePlan::parse(&boundary.to_string()).is_ok());
+        let oversized = serde_json::json!({"generation":1,"bindings":(0..521).map(|id| serde_json::json!({"id":id.to_string(),"contextId":"input","keys":["x"]})).collect::<Vec<_>>()});
+        assert!(CapturePlan::parse(&oversized.to_string()).is_err());
+    }
+}
