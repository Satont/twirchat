+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn apply_native_bounds(
+    window: &mut gpui::Window,
+    update: NativeWindowBoundsUpdate,
+) -> anyhow::Result<()> {
+    let old = window.bounds();
+    let viewport = window.viewport_size();
+    let position_requested = update.x.is_some() || update.y.is_some();
+    if position_requested && !window.native_window_capabilities().position {
+        anyhow::bail!("Global window positioning is unsupported by this platform");
+    }
+    if update.x.is_some() || update.y.is_some() || update.width.is_some() || update.height.is_some()
+    {
+        window.set_native_bounds(gpui::Bounds {
+            origin: gpui::point(
+                gpui::px(update.x.unwrap_or(f32::from(old.origin.x) as f64) as f32),
+                gpui::px(update.y.unwrap_or(f32::from(old.origin.y) as f64) as f32),
+            ),
+            size: gpui::size(
+                gpui::px(update.width.unwrap_or(f32::from(viewport.width) as f64) as f32),
+                gpui::px(update.height.unwrap_or(f32::from(viewport.height) as f64) as f32),
+            ),
+        })?;
+    }
+    if let Some(mode) = update.mode {
+        let wants_fullscreen = mode == "fullscreen";
+        if window.is_fullscreen() != wants_fullscreen {
+            window.toggle_fullscreen();
+        }
+        if !wants_fullscreen && window.is_maximized() != (mode == "maximized") {
+            window.zoom_window();
+        }
+    }
+    Ok(())
+}
