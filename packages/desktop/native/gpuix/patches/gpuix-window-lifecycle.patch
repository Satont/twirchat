+#[cfg(all(target_os = "linux", target_env = "gnu"))]
+#[derive(Default)]
+struct GlibcTrimSchedule {
+    pending: Option<(std::time::Instant, std::time::Instant)>,
+}
+
+#[cfg(all(target_os = "linux", target_env = "gnu"))]
+impl GlibcTrimSchedule {
+    fn reaped(&mut self, now: std::time::Instant) {
+        let first = self.pending.map_or(now, |(first, _)| first);
+        self.pending = Some((first, now));
+    }
+
+    fn deadline(&self) -> Option<std::time::Instant> {
+        self.pending.map(|(first, last)| {
+            (last + Duration::from_millis(500)).min(first + Duration::from_secs(2))
+        })
+    }
+
+    fn take_due(&mut self, now: std::time::Instant) -> bool {
+        if self.deadline().is_some_and(|deadline| now >= deadline) {
+            self.pending = None;
+            true
+        } else {
+            false
+        }
+    }
+}
+
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+fn join_ui_thread(thread: std::thread::JoinHandle<()>) -> bool {
+    if thread.join().is_err() {
+        eprintln!("GPUI UI thread exited with a panic");
+        false
+    } else {
+        true
+    }
+}
+
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+fn run_ui_reaper(receiver: std::sync::mpsc::Receiver<std::thread::JoinHandle<()>>) {
+    #[cfg(all(target_os = "linux", target_env = "gnu"))]
+    {
+        use std::sync::mpsc::RecvTimeoutError;
+        use std::time::Instant;
+        let mut trim = GlibcTrimSchedule::default();
+        loop {
+            let message = match trim.deadline() {
+                Some(deadline) => {
+                    receiver.recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                }
+                None => receiver.recv().map_err(|_| RecvTimeoutError::Disconnected),
+            };
+            match message {
+                Ok(thread) => {
+                    if join_ui_thread(thread) {
+                        trim.reaped(Instant::now());
+                    }
+                }
+                Err(RecvTimeoutError::Timeout) => {}
+                Err(RecvTimeoutError::Disconnected) => {
+                    if trim.pending.take().is_some() {
+                        // SAFETY: glibc's thread-safe allocator releases only
+                        // pages already freed; no live allocations are touched.
+                        unsafe {
+                            libc::malloc_trim(0);
+                        }
+                    }
+                    break;
+                }
+            }
+            if trim.take_due(Instant::now()) {
+                // Coalesce freed application arenas off the JS/UI threads.
+                // This changes no allocator policy and is idle without closes.
+                // SAFETY: malloc_trim is thread-safe and touches only free pages.
+                unsafe {
+                    libc::malloc_trim(0);
+                }
+            }
+        }
+    }
+    #[cfg(not(all(target_os = "linux", target_env = "gnu")))]
+    for thread in receiver {
+        join_ui_thread(thread);
+    }
+}
+
+// Joining a platform loop must never block Bun's JS thread. One process-owned
+// reaper releases finished UI thread handles after each renderer is collected.
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+fn reap_ui_thread(thread: std::thread::JoinHandle<()>) {
+    static REAPER: std::sync::LazyLock<
+        Option<std::sync::mpsc::Sender<std::thread::JoinHandle<()>>>,
+    > = std::sync::LazyLock::new(|| {
+        let (sender, receiver) = std::sync::mpsc::channel::<std::thread::JoinHandle<()>>();
+        match std::thread::Builder::new()
+            .name("gpuix-ui-reaper".into())
+            .spawn(move || run_ui_reaper(receiver))
+        {
+            Ok(_) => Some(sender),
+            Err(error) => {
+                eprintln!("Failed to start the GPUI UI thread reaper: {error}");
+                None
+            }
+        }
+    });
+    if let Some(reaper) = REAPER.as_ref() {
+        if reaper.send(thread).is_err() {
+            eprintln!("GPUI UI thread reaper stopped unexpectedly");
+        }
+    }
+}
