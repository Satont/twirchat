diff --git a/packages/native/src/linux_titlebar.rs b/packages/native/src/linux_titlebar.rs
new file mode 100644
index 0000000..974bf7f
--- /dev/null
+++ b/packages/native/src/linux_titlebar.rs
@@ -0,0 +1,247 @@
+use std::{cell::Cell, rc::Rc};
+
+use gpui::{
+    div, prelude::*, px, svg, App, Context, Decorations, Entity, FontWeight, Hsla, MouseButton,
+    Pixels, Render, Role, SharedString, StyleRefinement, Window, WindowAppearance, WindowButton,
+    WindowButtonLayout,
+};
+
+use crate::theme::grey;
+
+const TITLEBAR_HEIGHT: Pixels = px(44.);
+
+pub(crate) type CloseRequest = Rc<dyn Fn(&mut Window) -> bool>;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct TitlebarState {
+    layout: WindowButtonLayout,
+    appearance: WindowAppearance,
+    can_minimize: bool,
+    can_maximize: bool,
+    window_menu: bool,
+    maximized: bool,
+}
+
+impl TitlebarState {
+    fn read(window: &Window, cx: &App) -> Self {
+        let controls = window.window_controls();
+        Self {
+            layout: cx
+                .button_layout()
+                .unwrap_or_else(WindowButtonLayout::linux_default),
+            appearance: window.appearance(),
+            can_minimize: controls.minimize && window.is_minimizable(),
+            can_maximize: controls.maximize && window.is_resizable(),
+            window_menu: controls.window_menu,
+            maximized: window.is_maximized(),
+        }
+    }
+}
+
+pub(crate) struct ClientTitlebar {
+    can_close: CloseRequest,
+    drag_pending: Rc<Cell<bool>>,
+    title: SharedString,
+    state: TitlebarState,
+    version: u64,
+}
+
+impl ClientTitlebar {
+    pub(crate) fn new(can_close: CloseRequest, title: &str, window: &Window, cx: &App) -> Self {
+        Self {
+            can_close,
+            drag_pending: Rc::new(Cell::new(false)),
+            title: SharedString::new(title),
+            state: TitlebarState::read(window, cx),
+            version: 0,
+        }
+    }
+
+    pub(crate) fn element(
+        view: &Entity<Self>,
+        title: &str,
+        window: &Window,
+        cx: &mut App,
+    ) -> Option<impl IntoElement> {
+        if !matches!(window.window_decorations(), Decorations::Client { .. })
+            || window.is_fullscreen()
+        {
+            view.read(cx).drag_pending.set(false);
+            return None;
+        }
+
+        let state = TitlebarState::read(window, cx);
+        let previous = view.read(cx);
+        let title_changed = previous.title.as_str() != title;
+        let version = if title_changed || previous.state != state {
+            // Rebuild this header in the current frame without scheduling another frame.
+            view.update(cx, |view, _| {
+                if title_changed {
+                    view.title = SharedString::new(title);
+                }
+                view.state = state;
+                view.version = view.version.wrapping_add(1);
+                view.version
+            })
+        } else {
+            previous.version
+        };
+
+        Some(
+            view.clone()
+                .cached(
+                    StyleRefinement::default()
+                        .w_full()
+                        .h(TITLEBAR_HEIGHT)
+                        .flex_none(),
+                )
+                .cache_version(version),
+        )
+    }
+}
+
+impl Render for ClientTitlebar {
+    fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+        let TitlebarState {
+            layout,
+            appearance,
+            can_minimize,
+            can_maximize,
+            window_menu,
+            maximized,
+        } = self.state;
+        let dark = matches!(
+            appearance,
+            WindowAppearance::Dark | WindowAppearance::VibrantDark
+        );
+        let (background, foreground) = if dark {
+            (grey(0x30), grey(0xff))
+        } else {
+            (grey(0xeb), grey(0x2e))
+        };
+        let buttons = |side: [Option<WindowButton>; gpui::MAX_BUTTONS_PER_SIDE]| {
+            div().flex().flex_none().gap(px(6.)).children(
+                side.into_iter()
+                    .flatten()
+                    .filter(|button| match button {
+                        WindowButton::Minimize => can_minimize,
+                        WindowButton::Maximize => can_maximize,
+                        WindowButton::Close => true,
+                    })
+                    .map(|button| render_button(button, maximized, foreground, &self.can_close)),
+            )
+        };
+
+        let press = self.drag_pending.clone();
+        let release = press.clone();
+        let outside_release = press.clone();
+        let outside_press = press.clone();
+        let drag = press.clone();
+        let title_area = div()
+            .id("window-title")
+            .flex()
+            .flex_1()
+            .h_full()
+            .min_w(px(0.))
+            .items_center()
+            .justify_center()
+            .child(
+                div()
+                    .min_w(px(0.))
+                    .truncate()
+                    .text_size(px(13.))
+                    .font_weight(FontWeight::SEMIBOLD)
+                    .child(self.title.clone()),
+            )
+            .on_mouse_down(MouseButton::Left, move |_, _, _| press.set(true))
+            .on_mouse_down_out(move |_, _, _| outside_press.set(false))
+            .on_mouse_up(MouseButton::Left, move |_, _, _| release.set(false))
+            .on_mouse_up_out(MouseButton::Left, move |_, _, _| outside_release.set(false))
+            .on_mouse_move(move |event, window, _| {
+                if drag.replace(false) && event.dragging() {
+                    window.start_window_move();
+                }
+            })
+            .when(can_maximize, |area| {
+                area.on_click(|event, window, _| {
+                    if event.click_count() == 2 {
+                        window.zoom_window();
+                    }
+                })
+            })
+            .when(window_menu, |area| {
+                area.on_mouse_down(MouseButton::Right, |event, window, _| {
+                    window.show_window_menu(event.position);
+                })
+            });
+
+        div()
+            .id("linux-client-titlebar")
+            .flex()
+            .flex_none()
+            .w_full()
+            .h(TITLEBAR_HEIGHT)
+            .px(px(10.))
+            .gap(px(8.))
+            .items_center()
+            .bg(background)
+            .text_color(foreground)
+            .border_b_1()
+            .border_color(foreground.opacity(0.12))
+            .child(buttons(layout.left))
+            .child(title_area)
+            .child(buttons(layout.right))
+    }
+}
+
+fn render_button(
+    button: WindowButton,
+    maximized: bool,
+    foreground: Hsla,
+    can_close: &CloseRequest,
+) -> impl IntoElement {
+    let (label, icon): (&str, &[u8]) = match button {
+        WindowButton::Minimize => (
+            "Minimize",
+            br#"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M4 8h8" fill="none" stroke="black" stroke-width="1.5" stroke-linecap="round"/></svg>"#,
+        ),
+        WindowButton::Maximize if maximized => (
+            "Restore",
+            br#"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M6 5.5V3.75h6.25V10H10.5M3.75 6h6.25v6.25H3.75z" fill="none" stroke="black" stroke-width="1.5" stroke-linejoin="round"/></svg>"#,
+        ),
+        WindowButton::Maximize => (
+            "Maximize",
+            br#"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M4 4h8v8H4z" fill="none" stroke="black" stroke-width="1.5" stroke-linejoin="round"/></svg>"#,
+        ),
+        WindowButton::Close => (
+            "Close",
+            br#"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="m4.5 4.5 7 7m0-7-7 7" fill="none" stroke="black" stroke-width="1.5" stroke-linecap="round"/></svg>"#,
+        ),
+    };
+    let can_close = can_close.clone();
+    div()
+        .id(button.id())
+        .role(Role::Button)
+        .aria_label(label)
+        .focusable()
+        .flex()
+        .flex_none()
+        .size(px(24.))
+        .items_center()
+        .justify_center()
+        .rounded_full()
+        .bg(foreground.opacity(0.1))
+        .hover(move |style| style.bg(foreground.opacity(0.17)))
+        .active(move |style| style.bg(foreground.opacity(0.24)))
+        .focus_visible(move |style| style.bg(foreground.opacity(0.24)))
+        .child(svg().data(icon).size(px(16.)).text_color(foreground))
+        .on_click(move |_, window, cx| {
+            cx.stop_propagation();
+            match button {
+                WindowButton::Minimize => window.minimize_window(),
+                WindowButton::Maximize => window.zoom_window(),
+                WindowButton::Close if can_close(window) => window.remove_window(),
+                WindowButton::Close => {}
+            }
+        })
+}
