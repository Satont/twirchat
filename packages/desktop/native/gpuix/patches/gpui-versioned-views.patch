+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{AppContext as _, Styled, TestAppContext, WindowHandle, div, px};
+    use std::{cell::Cell, rc::Rc};
+
+    struct CacheChild {
+        version: u64,
+        rendered_version: Rc<Cell<u64>>,
+        render_count: Rc<Cell<usize>>,
+    }
+
+    impl Render for CacheChild {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            self.render_count.set(self.render_count.get() + 1);
+            self.rendered_version.set(self.version);
+            div().size(px(40.))
+        }
+    }
+
+    struct CacheParent {
+        child: Entity<CacheChild>,
+        version: Rc<Cell<Option<u64>>>,
+    }
+
+    impl Render for CacheParent {
+        fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+            let version = self.version.get();
+            // Mutate the child during parent rendering without notifying it.
+            self.child.update(cx, |child, _| {
+                child.version = version.unwrap_or_default();
+            });
+            let child = self
+                .child
+                .clone()
+                .cached(StyleRefinement::default().size(px(40.)));
+            match version {
+                Some(version) => child.cache_version(version),
+                None => child,
+            }
+        }
+    }
+
+    struct CacheFixture {
+        cx: TestAppContext,
+        window: WindowHandle<CacheParent>,
+        version: Rc<Cell<Option<u64>>>,
+        rendered_version: Rc<Cell<u64>>,
+        render_count: Rc<Cell<usize>>,
+    }
+
+    impl CacheFixture {
+        fn new(version: Option<u64>) -> Self {
+            let mut cx = TestAppContext::single();
+            let version = Rc::new(Cell::new(version));
+            let rendered_version = Rc::new(Cell::new(0));
+            let render_count = Rc::new(Cell::new(0));
+            let window = cx.add_window({
+                let version = version.clone();
+                let rendered_version = rendered_version.clone();
+                let render_count = render_count.clone();
+                move |_, cx| CacheParent {
+                    child: cx.new(|_| CacheChild {
+                        version: 0,
+                        rendered_version,
+                        render_count,
+                    }),
+                    version,
+                }
+            });
+            let mut fixture = Self {
+                cx,
+                window,
+                version,
+                rendered_version,
+                render_count,
+            };
+            fixture.draw();
+            fixture
+        }
+
+        fn draw(&mut self) {
+            self.cx
+                .update_window(self.window.into(), |_, window, cx| {
+                    window.draw(cx).clear(cx);
+                })
+                .unwrap();
+        }
+    }
+
+    #[test]
+    fn cached_view_version_changes_render_in_the_current_frame() {
+        let mut fixture = CacheFixture::new(None);
+        let initial_count = fixture.render_count.get();
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), initial_count);
+
+        // An explicit zero differs from the unversioned default.
+        fixture.version.set(Some(0));
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), initial_count + 1);
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), initial_count + 1);
+
+        fixture.version.set(Some(1));
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), initial_count + 2);
+        assert_eq!(fixture.rendered_version.get(), 1);
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), initial_count + 2);
+    }
+
+    #[test]
+    fn cached_views_render_when_dirty_or_refreshing() {
+        let mut fixture = CacheFixture::new(Some(0));
+        let initial_count = fixture.render_count.get();
+        fixture
+            .window
+            .update(&mut fixture.cx, |parent, window, _| {
+                let child_id = parent.child.entity_id();
+                assert!(!window.is_view_cache_invalidated(child_id));
+                window.dirty_views.insert(child_id);
+                assert!(window.is_view_cache_invalidated(child_id));
+            })
+            .unwrap();
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), initial_count + 1);
+
+        fixture
+            .window
+            .update(&mut fixture.cx, |parent, window, _| {
+                let child_id = parent.child.entity_id();
+                assert!(!window.is_view_cache_invalidated(child_id));
+                window.refresh();
+                assert!(window.is_view_cache_invalidated(child_id));
+            })
+            .unwrap();
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), initial_count + 2);
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), initial_count + 2);
+    }
+
+    #[test]
+    fn cached_views_render_every_accessibility_frame() {
+        let mut fixture = CacheFixture::new(Some(0));
+        let initial_count = fixture.render_count.get();
+        fixture
+            .window
+            .update(&mut fixture.cx, |_, window, _| {
+                window.set_a11y_active_for_tests(true);
+            })
+            .unwrap();
+        fixture.draw();
+        let active_count = fixture.render_count.get();
+        assert!(active_count > initial_count);
+        fixture.draw();
+        assert!(fixture.render_count.get() > active_count);
+
+        fixture
+            .window
+            .update(&mut fixture.cx, |_, window, _| {
+                window.set_a11y_active_for_tests(false);
+            })
+            .unwrap();
+        fixture.draw();
+        let cached_count = fixture.render_count.get();
+        fixture.draw();
+        assert_eq!(fixture.render_count.get(), cached_count);
+    }
