+    #[gpui::test]
+    fn owned_global_element_ids_preserve_ancestor_scopes(cx: &mut TestAppContext) {
+        cx.add_empty_window().update(|window, _| {
+            let initial_stack = window.element_id_stack.clone();
+            let parent = window.global_element_id_for("identity-parent".into());
+            assert_eq!(
+                parent,
+                window.with_global_id("identity-parent".into(), |id, _| id.clone())
+            );
+            let (child, grandchild) = window.with_id("identity-parent", |window| {
+                let child = window.global_element_id_for("identity-child".into());
+                assert_eq!(child, window.global_element_id_for("identity-child".into()));
+                assert_eq!(
+                    child,
+                    window.with_global_id("identity-child".into(), |id, _| id.clone())
+                );
+                let grandchild = window.with_id("identity-child", |window| {
+                    let key = window.global_element_id_for("identity-grandchild".into());
+                    assert_eq!(
+                        key,
+                        window.with_global_id("identity-grandchild".into(), |id, _| id.clone())
+                    );
+                    key
+                });
+                (child, grandchild)
+            });
+            assert_ne!(parent, child);
+            assert_ne!(child, grandchild);
+            assert_ne!(parent, grandchild);
+            assert_ne!(
+                child,
+                window.with_id("another-parent", |window| {
+                    window.global_element_id_for("identity-child".into())
+                })
+            );
+            assert_eq!(window.element_id_stack, initial_stack);
+            assert_eq!(
+                parent,
+                window.global_element_id_for("identity-parent".into())
+            );
+        });
+    }
