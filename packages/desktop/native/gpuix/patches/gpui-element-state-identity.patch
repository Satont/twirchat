+    /// Derive an owned identifier for a child in the current element scope.
+    /// This does not enter that scope or change descendant identifiers. Reuse
+    /// the key for persistent state only where the same ancestor scope applies.
+    pub fn global_element_id_for(&self, element_id: ElementId) -> GlobalElementId {
+        GlobalElementId(
+            self.element_id_stack
+                .iter()
+                .cloned()
+                .chain(std::iter::once(element_id))
+                .collect(),
+        )
+    }
