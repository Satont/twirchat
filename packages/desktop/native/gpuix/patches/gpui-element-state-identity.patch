+    #[gpui::test]
+    fn owned_cache_key_keeps_painted_descendant_state_ids(cx: &mut TestAppContext) {
+        let window = cx.add_empty_window();
+        window.draw(point(px(0.), px(0.)), size(px(100.), px(100.)), |_, _| {
+            div()
+                .id("identity-parent")
+                .size_full()
+                .child(
+                    canvas(
+                        |_, _, _| (),
+                        |_, _, window, _| {
+                            let current_stack = window.element_id_stack.clone();
+                            let key = window.global_element_id_for("owned-cache".into());
+                            window.with_element_state(&key, |previous: Option<usize>, _| {
+                                ((), previous.unwrap_or_default() + 1)
+                            });
+                            assert_eq!(window.element_id_stack, current_stack);
+                        },
+                    )
+                    .size(px(1.)),
+                )
+                .child(
+                    div().id("identity-child").size(px(20.)).child(
+                        div().id("identity-grandchild").size(px(10.)).child(
+                            canvas(
+                                |_, _, _| (),
+                                |_, _, window, _| {
+                                    assert_eq!(
+                                        window.element_id_stack.as_slice(),
+                                        &[
+                                            super::ElementId::from("identity-parent"),
+                                            super::ElementId::from("identity-child"),
+                                            super::ElementId::from("identity-grandchild"),
+                                        ]
+                                    );
+                                },
+                            )
+                            .size(px(1.)),
+                        ),
+                    ),
+                )
+        });
+        window.update(|window, _| {
+            let (cache, child, grandchild) =
+                window.with_global_id("identity-parent".into(), |_, window| {
+                    let cache = window.with_global_id("owned-cache".into(), |id, _| id.clone());
+                    let (child, grandchild) =
+                        window.with_global_id("identity-child".into(), |id, window| {
+                            (
+                                id.clone(),
+                                window.with_global_id("identity-grandchild".into(), |id, _| {
+                                    id.clone()
+                                }),
+                            )
+                        });
+                    (cache, child, grandchild)
+                });
+            for expected in [&cache, &child, &grandchild] {
+                assert!(
+                    window
+                        .rendered_frame
+                        .element_states
+                        .keys()
+                        .any(|(id, _)| id == expected)
+                );
+            }
+        });
+    }
