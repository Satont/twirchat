+#[cfg(test)]
+mod inherited_selection_group_tests {
+    use super::{Inherited, Theme};
+    use crate::style::StyleDesc;
+
+    fn flex(direction: &str) -> StyleDesc {
+        StyleDesc {
+            display: Some("flex".into()),
+            flex_direction: Some(direction.into()),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn outer_horizontal_runs_share_a_group_and_columns_separate_them() {
+        let row = Inherited::root(&Theme::dark()).descend(10, Some(&flex("row")));
+        assert_eq!(row.selection_group, Some(10));
+
+        let nested = row.clone().descend(11, Some(&flex("row")));
+        assert_eq!(nested.selection_group, Some(10));
+        let raw_leaf = nested.descend(12, None);
+        assert_eq!(raw_leaf.selection_group, Some(10));
+
+        let column = row.descend(20, Some(&flex("column")));
+        assert_eq!(column.selection_group, None);
+        let next_row = column.descend(21, Some(&flex("row")));
+        assert_eq!(next_row.selection_group, Some(21));
+    }
+}
