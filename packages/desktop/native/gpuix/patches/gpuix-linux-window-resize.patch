diff --git a/packages/native/src/linux_window_frame.rs b/packages/native/src/linux_window_frame.rs
new file mode 100644
index 0000000..df5e8a0
--- /dev/null
+++ b/packages/native/src/linux_window_frame.rs
@@ -0,0 +1,117 @@
+use gpui::{
+    canvas, div, point, prelude::*, px, size, Bounds, CursorStyle, Decorations, DispatchPhase, Div,
+    HitboxBehavior, Hsla, MouseButton, MouseDownEvent, Pixels, ResizeEdge, Tiling,
+};
+
+const RESIZE_GUTTER: Pixels = px(6.);
+
+pub(crate) fn with_resize_handles(content: Div, tiling: Tiling, background: Hsla) -> Div {
+    div()
+        .relative()
+        .size_full()
+        .bg(background)
+        .child(
+            content
+                .pt(gutter(tiling.top))
+                .pr(gutter(tiling.right))
+                .pb(gutter(tiling.bottom))
+                .pl(gutter(tiling.left)),
+        )
+        .child(resize_handles(tiling))
+}
+
+fn gutter(tiled: bool) -> Pixels {
+    if tiled {
+        px(0.)
+    } else {
+        RESIZE_GUTTER
+    }
+}
+
+fn resize_handles(tiling: Tiling) -> impl IntoElement {
+    use ResizeEdge::*;
+
+    canvas(
+        move |bounds: Bounds<Pixels>, window, _| {
+            // Split the painted surface into a 3×3 grid. The center is app
+            // content. A tiled edge collapses its strip and both corners.
+            let left = gutter(tiling.left).min(bounds.size.width / 2.);
+            let right = gutter(tiling.right).min(bounds.size.width / 2.);
+            let top = gutter(tiling.top).min(bounds.size.height / 2.);
+            let bottom = gutter(tiling.bottom).min(bounds.size.height / 2.);
+            let columns = [
+                bounds.left(),
+                bounds.left() + left,
+                bounds.right() - right,
+                bounds.right(),
+            ];
+            let rows = [
+                bounds.top(),
+                bounds.top() + top,
+                bounds.bottom() - bottom,
+                bounds.bottom(),
+            ];
+            [
+                (0, 0, TopLeft),
+                (1, 0, Top),
+                (2, 0, TopRight),
+                (2, 1, Right),
+                (2, 2, BottomRight),
+                (1, 2, Bottom),
+                (0, 2, BottomLeft),
+                (0, 1, Left),
+            ]
+            .map(|(column, row, edge)| {
+                let width = columns[column + 1] - columns[column];
+                let height = rows[row + 1] - rows[row];
+                (width > px(0.) && height > px(0.)).then(|| {
+                    let bounds =
+                        Bounds::new(point(columns[column], rows[row]), size(width, height));
+                    (
+                        edge,
+                        window.insert_hitbox(bounds, HitboxBehavior::BlockMouse),
+                    )
+                })
+            })
+        },
+        move |_, handles, window, _| {
+            for (edge, hitbox) in handles.iter().flatten() {
+                let cursor = match edge {
+                    Top => CursorStyle::ResizeUp,
+                    Right => CursorStyle::ResizeRight,
+                    Bottom => CursorStyle::ResizeDown,
+                    Left => CursorStyle::ResizeLeft,
+                    TopLeft | BottomRight => CursorStyle::ResizeUpLeftDownRight,
+                    TopRight | BottomLeft => CursorStyle::ResizeUpRightDownLeft,
+                };
+                window.set_cursor_style(cursor, hitbox);
+            }
+
+            window.on_mouse_event(move |event: &MouseDownEvent, phase, window, cx| {
+                if phase != DispatchPhase::Bubble || event.button != MouseButton::Left {
+                    return;
+                }
+                let Some((edge, _)) = handles
+                    .iter()
+                    .flatten()
+                    .find(|(_, hitbox)| hitbox.is_hovered(window))
+                else {
+                    return;
+                };
+                if window.is_fullscreen()
+                    || window.is_maximized()
+                    || window.window_decorations() != (Decorations::Client { tiling })
+                {
+                    return;
+                }
+                // Wayland needs the serial of this button press.
+                window.start_window_resize(*edge);
+                cx.stop_propagation();
+            });
+        },
+    )
+    .absolute()
+    .top_0()
+    .left_0()
+    .size_full()
+}
