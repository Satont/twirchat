diff --git a/packages/native/src/linux_window_frame.rs b/packages/native/src/linux_window_frame.rs
new file mode 100644
index 0000000..7edc6c8
--- /dev/null
+++ b/packages/native/src/linux_window_frame.rs
@@ -0,0 +1,168 @@
+use gpui::{
+    canvas, fill, point, prelude::*, px, size, App, Bounds, Context, CursorStyle, Decorations,
+    DispatchPhase, Div, Entity, HitboxBehavior, Hsla, MouseButton, MouseDownEvent, Pixels, Render,
+    ResizeEdge, StyleRefinement, Tiling, Window,
+};
+
+const RESIZE_GUTTER: Pixels = px(6.);
+
+#[derive(Default)]
+pub(crate) struct ResizeHandles {
+    tiling: Tiling,
+    background: Hsla,
+    version: u64,
+}
+
+impl ResizeHandles {
+    pub(crate) fn frame(
+        view: Entity<Self>,
+        frame: Div,
+        tiling: Tiling,
+        background: Hsla,
+        cx: &mut App,
+    ) -> Div {
+        let previous = view.read(cx);
+        let version = if previous.tiling == tiling && previous.background == background {
+            previous.version
+        } else {
+            view.update(cx, |handles, _| {
+                handles.tiling = tiling;
+                handles.background = background;
+                handles.version = handles.version.wrapping_add(1);
+                handles.version
+            })
+        };
+
+        frame
+            .relative()
+            .pt(gutter(tiling.top))
+            .pr(gutter(tiling.right))
+            .pb(gutter(tiling.bottom))
+            .pl(gutter(tiling.left))
+            .child(
+                view.cached(
+                    StyleRefinement::default()
+                        .absolute()
+                        .top_0()
+                        .left_0()
+                        .size_full(),
+                )
+                .cache_version(version),
+            )
+    }
+}
+
+impl Render for ResizeHandles {
+    fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+        resize_handles(self.tiling, self.background)
+    }
+}
+
+fn gutter(tiled: bool) -> Pixels {
+    if tiled {
+        px(0.)
+    } else {
+        RESIZE_GUTTER
+    }
+}
+
+fn resize_handles(tiling: Tiling, background: Hsla) -> impl IntoElement {
+    use ResizeEdge::*;
+
+    canvas(
+        move |bounds: Bounds<Pixels>, window, _| {
+            // Split the painted surface into a 3×3 grid. The center is app
+            // content. A tiled edge collapses its strip and both corners.
+            let left = gutter(tiling.left).min(bounds.size.width / 2.);
+            let right = gutter(tiling.right).min(bounds.size.width / 2.);
+            let top = gutter(tiling.top).min(bounds.size.height / 2.);
+            let bottom = gutter(tiling.bottom).min(bounds.size.height / 2.);
+            let columns = [
+                bounds.left(),
+                bounds.left() + left,
+                bounds.right() - right,
+                bounds.right(),
+            ];
+            let rows = [
+                bounds.top(),
+                bounds.top() + top,
+                bounds.bottom() - bottom,
+                bounds.bottom(),
+            ];
+            let rect = |left: usize, top: usize, right: usize, bottom: usize| {
+                Bounds::new(
+                    point(columns[left], rows[top]),
+                    size(columns[right] - columns[left], rows[bottom] - rows[top]),
+                )
+            };
+            let strips = [
+                rect(0, 0, 3, 1),
+                rect(0, 2, 3, 3),
+                rect(0, 1, 1, 2),
+                rect(2, 1, 3, 2),
+            ];
+            let handles = [
+                (0, 0, TopLeft),
+                (1, 0, Top),
+                (2, 0, TopRight),
+                (2, 1, Right),
+                (2, 2, BottomRight),
+                (1, 2, Bottom),
+                (0, 2, BottomLeft),
+                (0, 1, Left),
+            ]
+            .map(|(column, row, edge)| {
+                let bounds = rect(column, row, column + 1, row + 1);
+                (!bounds.is_empty()).then(|| {
+                    (
+                        edge,
+                        window.insert_hitbox(bounds, HitboxBehavior::BlockMouse),
+                    )
+                })
+            });
+            (strips, handles)
+        },
+        move |_, (strips, handles), window, _| {
+            for strip in strips.into_iter().filter(|strip| !strip.is_empty()) {
+                window.paint_quad(fill(strip, background));
+            }
+            for (edge, hitbox) in handles.iter().flatten() {
+                let cursor = match edge {
+                    Top => CursorStyle::ResizeUp,
+                    Right => CursorStyle::ResizeRight,
+                    Bottom => CursorStyle::ResizeDown,
+                    Left => CursorStyle::ResizeLeft,
+                    TopLeft | BottomRight => CursorStyle::ResizeUpLeftDownRight,
+                    TopRight | BottomLeft => CursorStyle::ResizeUpRightDownLeft,
+                };
+                window.set_cursor_style(cursor, hitbox);
+            }
+
+            window.on_mouse_event(move |event: &MouseDownEvent, phase, window, cx| {
+                if phase != DispatchPhase::Bubble || event.button != MouseButton::Left {
+                    return;
+                }
+                let Some((edge, _)) = handles
+                    .iter()
+                    .flatten()
+                    .find(|(_, hitbox)| hitbox.is_hovered(window))
+                else {
+                    return;
+                };
+                if window.is_fullscreen()
+                    || window.is_maximized()
+                    || window.window_decorations() != (Decorations::Client { tiling })
+                {
+                    return;
+                }
+                // Wayland needs the serial of this button press.
+                window.start_window_resize(*edge);
+                cx.stop_propagation();
+            });
+        },
+    )
+    .absolute()
+    .top_0()
+    .left_0()
+    .size_full()
+}
