+// Bound each decoded canvas separately from the frames retained by one resource.
+const MAX_DECODED_FRAME_BYTES: u64 = 64 * 1024 * 1024;
+const MAX_ANIMATION_BYTES: u64 = 20 * 1024 * 1024;
+const MAX_ANIMATION_FRAMES: u32 = 10_000;
+
+fn check_image_canvas(width: u32, height: u32, decoded_bytes: u64) -> Result<()> {
+    let rgba_bytes = u64::from(width)
+        .checked_mul(u64::from(height))
+        .and_then(|pixels| pixels.checked_mul(4))
+        .context("image dimensions overflow")?;
+    anyhow::ensure!(
+        width > 0
+            && height > 0
+            && rgba_bytes <= MAX_DECODED_FRAME_BYTES
+            && decoded_bytes <= MAX_DECODED_FRAME_BYTES,
+        "image canvas exceeds decode budget"
+    );
+    Ok(())
+}
+
+pub(crate) fn animation_dimensions(width: u32, height: u32, count: u32) -> Result<(u32, u32)> {
+    check_image_canvas(width, height, 0)?;
+    anyhow::ensure!(
+        count > 0 && count <= MAX_ANIMATION_FRAMES,
+        "invalid animation frame count"
+    );
+    let pixels = u64::from(width) * u64::from(height);
+    let budget = MAX_ANIMATION_BYTES / (4 * u64::from(count));
+    if pixels <= budget {
+        return Ok((width, height));
+    }
+
+    // Scale once, before collecting frames. Integer rounding may cost one pixel
+    // on very thin canvases, but may never exceed the retained byte budget.
+    let scale = (budget as f64 / pixels as f64).sqrt();
+    let scaled_height = ((f64::from(height) * scale).floor() as u32).max(1);
+    let scaled_width = ((f64::from(width) * scale).floor() as u32).max(1);
+    let scaled_width = u64::from(scaled_width).min(budget / u64::from(scaled_height)) as u32;
+    if scaled_width == 0 {
+        return Ok((1, budget as u32));
+    }
+    Ok((scaled_width, scaled_height))
+}
+
+pub(crate) fn gif_animation_dimensions(bytes: &[u8]) -> Result<((u32, u32), u32)> {
+    let mut options = gif::DecodeOptions::new();
+    options.skip_frame_decoding(true);
+    let mut decoder = options.read_info(Cursor::new(bytes))?;
+    let width = u32::from(decoder.width());
+    let height = u32::from(decoder.height());
+    check_image_canvas(width, height, 0)?;
+    let mut count = 0;
+    while let Some(frame) = decoder.next_frame_info()? {
+        // Malformed subframes can be larger than their logical screen.
+        check_image_canvas(u32::from(frame.width), u32::from(frame.height), 0)?;
+        count += 1;
+        anyhow::ensure!(count <= MAX_ANIMATION_FRAMES, "too many animation frames");
+    }
+    Ok((animation_dimensions(width, height, count)?, count))
+}
+
+pub(crate) fn decode_animation_frames(
+    frames: image::Frames<'_>,
+    dimensions: (u32, u32),
+    expected_count: u32,
+) -> Result<SmallVec<[Frame; 1]>> {
+    let mut retained = SmallVec::new();
+    for (index, frame) in frames.enumerate() {
+        anyhow::ensure!(
+            index < expected_count as usize,
+            "animation frame count changed"
+        );
+        match frame {
+            Ok(mut frame) => {
+                if frame.buffer().dimensions() != dimensions {
+                    let delay = frame.delay();
+                    let resized = image::imageops::resize(
+                        frame.buffer(),
+                        dimensions.0,
+                        dimensions.1,
+                        image::imageops::FilterType::Triangle,
+                    );
+                    frame = Frame::from_parts(resized, 0, 0, delay);
+                }
+                // GPUI stores BGRA; do this after resizing to avoid another pass.
+                for pixel in frame.buffer_mut().chunks_exact_mut(4) {
+                    pixel.swap(0, 2);
+                }
+                retained.push(frame);
+            }
+            Err(err) => log::debug!("Skipping animation frame due to decode error: {err}"),
+        }
+    }
+    anyhow::ensure!(
+        !retained.is_empty(),
+        "animation could not be decoded: all frames failed"
+    );
+    Ok(retained)
+}
