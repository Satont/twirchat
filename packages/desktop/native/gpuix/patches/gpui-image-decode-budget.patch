+#[cfg(test)]
+mod image_decode_budget_tests {
+    use super::*;
+    use image::{Delay, Rgba};
+
+    #[test]
+    fn canvas_guard_accounts_for_native_output_and_rejects_overflow() {
+        assert!(check_image_canvas(4096, 4096, MAX_DECODED_FRAME_BYTES).is_ok());
+        assert!(check_image_canvas(1, 1, MAX_DECODED_FRAME_BYTES + 1).is_err());
+        assert!(check_image_canvas(u32::MAX, u32::MAX, 0).is_err());
+        assert!(check_image_canvas(0, 1, 0).is_err());
+    }
+
+    #[test]
+    fn animation_dimensions_keep_small_frames_and_bound_large_or_thin_frames() {
+        assert_eq!(animation_dimensions(128, 64, 10).unwrap(), (128, 64));
+        for (width, height, count) in [
+            (2048, 1024, 100),
+            (1, 16_777_216, 10_000),
+            (16_777_216, 1, 10_000),
+        ] {
+            let (w, h) = animation_dimensions(width, height, count).unwrap();
+            assert!(w > 0 && h > 0 && w <= width && h <= height);
+            assert!(u64::from(w) * u64::from(h) * 4 * u64::from(count) <= MAX_ANIMATION_BYTES);
+            if width > 1 && height > 1 {
+                assert!((f64::from(w) / f64::from(h) - 2.0).abs() < 0.02);
+            }
+        }
+        assert!(animation_dimensions(1, 1, 0).is_err());
+        assert!(animation_dimensions(1, 1, MAX_ANIMATION_FRAMES + 1).is_err());
+    }
+
+    #[test]
+    fn metadata_count_and_under_budget_gif_preserve_frames_pixels_and_delays() {
+        let input = [
+            Frame::from_parts(
+                RgbaImage::from_pixel(3, 2, Rgba([255, 0, 0, 255])),
+                0,
+                0,
+                Delay::from_numer_denom_ms(20, 1),
+            ),
+            Frame::from_parts(
+                RgbaImage::from_pixel(3, 2, Rgba([0, 0, 255, 255])),
+                0,
+                0,
+                Delay::from_numer_denom_ms(70, 1),
+            ),
+        ];
+        let mut bytes = Vec::new();
+        image::codecs::gif::GifEncoder::new(&mut bytes)
+            .encode_frames(input)
+            .unwrap();
+        let (dimensions, count) = gif_animation_dimensions(&bytes).unwrap();
+        assert_eq!((dimensions, count), ((3, 2), 2));
+        let expected = GifDecoder::new(Cursor::new(&bytes))
+            .unwrap()
+            .into_frames()
+            .collect_frames()
+            .unwrap();
+        let actual = decode_animation_frames(
+            GifDecoder::new(Cursor::new(&bytes)).unwrap().into_frames(),
+            dimensions,
+            count,
+        )
+        .unwrap();
+        assert_eq!(actual.len(), expected.len());
+        for (actual, mut expected) in actual.iter().zip(expected) {
+            for pixel in expected.buffer_mut().chunks_exact_mut(4) {
+                pixel.swap(0, 2);
+            }
+            assert_eq!(actual.buffer(), expected.buffer());
+            assert_eq!(actual.delay(), expected.delay());
+        }
+    }
+
+    #[test]
+    fn webp_metadata_and_under_budget_frames_preserve_pixels_and_delays() {
+        // Two lossless 3x2 solid frames (red, blue), encoded by libwebp via Pillow.
+        let bytes: &[u8] = &[
+            82, 73, 70, 70, 132, 0, 0, 0, 87, 69, 66, 80, 86, 80, 56, 88, 10, 0, 0, 0, 2, 0, 0, 0,
+            2, 0, 0, 1, 0, 0, 65, 78, 73, 77, 6, 0, 0, 0, 0, 0, 0, 0, 0, 0, 65, 78, 77, 70, 40, 0,
+            0, 0, 0, 0, 0, 0, 0, 0, 2, 0, 0, 1, 0, 0, 20, 0, 0, 2, 86, 80, 56, 76, 15, 0, 0, 0, 47,
+            2, 64, 0, 0, 7, 16, 253, 143, 254, 7, 34, 162, 255, 1, 0, 65, 78, 77, 70, 40, 0, 0, 0,
+            0, 0, 0, 0, 0, 0, 2, 0, 0, 1, 0, 0, 70, 0, 0, 0, 86, 80, 56, 76, 15, 0, 0, 0, 47, 2,
+            64, 0, 0, 7, 16, 209, 255, 254, 7, 34, 162, 255, 1, 0,
+        ];
+        let metadata = image_webp::WebPDecoder::new(Cursor::new(bytes)).unwrap();
+        assert!(metadata.is_animated());
+        assert_eq!(metadata.num_frames(), 2);
+        let (width, height) = metadata.dimensions();
+        let dimensions = animation_dimensions(width, height, metadata.num_frames()).unwrap();
+        let mut decoder = image::codecs::webp::WebPDecoder::new(Cursor::new(bytes)).unwrap();
+        decoder.set_background_color(Rgba([0, 0, 0, 0])).unwrap();
+        let actual =
+            decode_animation_frames(decoder.into_frames(), dimensions, metadata.num_frames())
+                .unwrap();
+        assert_eq!(actual.len(), 2);
+        let mut reference = image::codecs::webp::WebPDecoder::new(Cursor::new(bytes)).unwrap();
+        reference.set_background_color(Rgba([0, 0, 0, 0])).unwrap();
+        let expected = reference.into_frames().collect_frames().unwrap();
+        for ((frame, mut expected), delay) in actual.iter().zip(expected).zip([20, 70]) {
+            for pixel in expected.buffer_mut().chunks_exact_mut(4) {
+                pixel.swap(0, 2);
+            }
+            assert_eq!(frame.buffer().dimensions(), (3, 2));
+            assert_eq!(frame.buffer(), expected.buffer());
+            assert_eq!(frame.delay(), Delay::from_numer_denom_ms(delay, 1));
+        }
+    }
+
+    #[test]
+    fn oversized_animation_keeps_every_frame_and_delay_within_budget() {
+        let dimensions = animation_dimensions(2048, 2048, 2).unwrap();
+        let delays = [
+            Delay::from_numer_denom_ms(30, 1),
+            Delay::from_numer_denom_ms(110, 1),
+        ];
+        let frames = image::Frames::new(Box::new(delays.into_iter().map(|delay| {
+            Ok(Frame::from_parts(
+                RgbaImage::from_pixel(2048, 2048, Rgba([17, 29, 83, 255])),
+                0,
+                0,
+                delay,
+            ))
+        })));
+        let actual = decode_animation_frames(frames, dimensions, 2).unwrap();
+        assert_eq!(actual.len(), 2);
+        assert!(
+            actual
+                .iter()
+                .map(|frame| frame.buffer().len() as u64)
+                .sum::<u64>()
+                <= MAX_ANIMATION_BYTES
+        );
+        for (frame, delay) in actual.iter().zip(delays) {
+            assert_eq!(frame.buffer().dimensions(), dimensions);
+            assert_eq!(frame.delay(), delay);
+            assert_eq!(frame.buffer().get_pixel(0, 0).0, [83, 29, 17, 255]);
+        }
+    }
+}
