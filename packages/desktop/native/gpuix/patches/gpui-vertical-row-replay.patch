+#[cfg(test)]
+mod vertical_replay_tests {
+    use super::*;
+    use crate::size;
+
+    fn box_at(y: f32) -> Bounds<ScaledPixels> {
+        Bounds::new(
+            point(ScaledPixels(0.), ScaledPixels(y)),
+            size(ScaledPixels(12.), ScaledPixels(10.)),
+        )
+    }
+
+    #[test]
+    fn capture_records_quads_that_were_culled_before_insertion() {
+        let mut scene = Scene::default();
+        assert!(scene.begin_vertical_capture());
+        scene.insert_primitive(Quad {
+            bounds: box_at(14.),
+            content_mask: ContentMask {
+                bounds: box_at(40.),
+            },
+            ..Quad::default()
+        });
+
+        assert!(scene.quads.is_empty());
+        assert_eq!(
+            scene.finish_vertical_capture(),
+            Some(ScaledPixels(14.)..ScaledPixels(24.)),
+        );
+    }
+
+    #[test]
+    fn replay_translates_quads_and_local_clip_inside_the_layer() {
+        let mut previous = Scene::default();
+        previous.push_layer(box_at(14.));
+        previous.insert_primitive(Quad {
+            bounds: box_at(14.),
+            content_mask: ContentMask {
+                bounds: box_at(16.),
+            },
+            ..Quad::default()
+        });
+        previous.pop_layer();
+
+        let mut next = Scene::default();
+        next.replay_vertical(0..previous.len(), &previous, ScaledPixels(24.));
+
+        assert!(matches!(
+            next.paint_operations.as_slice(),
+            [
+                PaintOperation::StartLayer(layer),
+                PaintOperation::Primitive(Primitive::Quad(_)),
+                PaintOperation::EndLayer,
+            ] if *layer == box_at(38.)
+        ));
+        assert_eq!(next.quads[0].bounds, box_at(38.));
+        assert_eq!(next.quads[0].content_mask.bounds, box_at(40.));
+    }
+}
