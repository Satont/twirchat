+enum ViewReplay {
+    InPlace,
+    Shift(VerticalShift),
+}
+
+impl VerticalReplay {
+    fn at(
+        &self,
+        old_bounds: Bounds<Pixels>,
+        bounds: Bounds<Pixels>,
+        mask: ContentMask<Pixels>,
+        window: &Window,
+    ) -> Option<ViewReplay> {
+        if old_bounds.size != bounds.size
+            || old_bounds.origin.x != bounds.origin.x
+            || self.scale != window.scale_factor()
+            || mask.bounds.intersect(&bounds) != bounds
+            || old_bounds.contains(&window.mouse_position())
+            || bounds.contains(&window.mouse_position())
+        {
+            return None;
+        }
+
+        let logical = bounds.origin.y - old_bounds.origin.y;
+        let scaled = logical.scale(self.scale);
+        if !scaled.0.is_finite() || scaled.0.fract() != 0.0 {
+            return None;
+        }
+
+        let clip = mask.scale(self.scale).bounds;
+        if self.extent.start + scaled < clip.top() || self.extent.end + scaled > clip.bottom() {
+            return None;
+        }
+        Some(if logical == Pixels::ZERO {
+            ViewReplay::InPlace
+        } else {
+            ViewReplay::Shift(VerticalShift { logical, scaled })
+        })
+    }
+}
