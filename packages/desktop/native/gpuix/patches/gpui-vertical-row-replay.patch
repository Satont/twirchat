+fn trace_vertical_replay(id: &GlobalElementId, shift: VerticalShift) {
+    enum Trace {
+        Off,
+        Sparse,
+        Detail,
+    }
+
+    static MODE: OnceLock<Trace> = OnceLock::new();
+    static HITS: AtomicU64 = AtomicU64::new(0);
+    match MODE.get_or_init(
+        || match std::env::var("GPUIX_TRACE_VERTICAL_REPLAY").as_deref() {
+            Ok("1") => Trace::Sparse,
+            Ok("detail") => Trace::Detail,
+            _ => Trace::Off,
+        },
+    ) {
+        Trace::Off => {}
+        Trace::Sparse => {
+            let count = HITS.fetch_add(1, Ordering::Relaxed) + 1;
+            if count == 1 || count % 256 == 0 {
+                eprintln!("GPUIX vertical replay hit {count}");
+            }
+        }
+        Trace::Detail => {
+            let logical = shift.logical.0;
+            let scaled = shift.scaled.0;
+            if let Some(ElementId::NamedInteger(name, body)) = id.last() {
+                eprintln!(
+                    "GPUIX vertical replay shift {name} {body} logical={logical} scaled={scaled}"
+                );
+            } else {
+                eprintln!("GPUIX vertical replay shift {id} logical={logical} scaled={scaled}");
+            }
+        }
+    }
