+
+impl VerticalPaintCapture {
+    fn record(&mut self, bounds: Bounds<ScaledPixels>) {
+        let top = bounds.origin.y;
+        let bottom = bounds.bottom();
+        if let Some(extent) = &mut self.extent {
+            extent.start = extent.start.min(top);
+            extent.end = extent.end.max(bottom);
+        } else {
+            self.extent = Some(top..bottom);
+        }
+    }
+}
