+#[cfg(all(test, not(all(target_arch = "wasm32", target_os = "unknown"))))]
+mod list_visible_range_tests {
+    use super::ListVisibleRange;
+    use std::cell::Cell;
+    use std::rc::Rc;
+    use std::sync::{Arc, Mutex};
+
+    #[test]
+    fn emits_initial_and_changed_ranges_once_across_rebuilt_wrappers() {
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let recorded = events.clone();
+        let observer = ListVisibleRange {
+            callback: Some(Arc::new(move |event| {
+                recorded.lock().unwrap().push((
+                    event.element_id,
+                    event.start_index,
+                    event.end_index,
+                ));
+            })),
+            list_id: 7,
+            last_range: Rc::new(Cell::new(None)),
+        };
+        observer.update(0..3);
+        observer.update(0..3);
+        let rebuilt = ListVisibleRange {
+            last_range: observer.last_range.clone(),
+            ..observer
+        };
+        rebuilt.update(0..3);
+        rebuilt.update(40..43);
+        rebuilt.update(40..45);
+        rebuilt.update(40..45);
+        assert_eq!(
+            *events.lock().unwrap(),
+            vec![
+                (7.0, Some(0.0), Some(3.0)),
+                (7.0, Some(40.0), Some(43.0)),
+                (7.0, Some(40.0), Some(45.0)),
+            ]
+        );
     }
 }
 
