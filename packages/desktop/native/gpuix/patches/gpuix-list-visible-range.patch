-/// A virtual list with its thumb painted over it.
+struct ListVisibleRange {
+    callback: Option<EventCallback>,
+    list_id: u64,
+    last_range: Rc<Cell<Option<(usize, usize)>>>,
+}
+
+impl ListVisibleRange {
+    fn update(&self, range: std::ops::Range<usize>) {
+        let current = (range.start, range.end);
+        if self.last_range.replace(Some(current)) == Some(current) {
+            return;
+        }
+        emit_event_full(&self.callback, self.list_id, "visibleRange", |payload| {
+            payload.start_index = Some(range.start as f64);
+            payload.end_index = Some(range.end as f64);
+        });
+    }
+}
+
