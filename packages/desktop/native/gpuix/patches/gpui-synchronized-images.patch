@@ -0,0 +1,101 @@
+use std::time::Duration;
+
+#[derive(Default)]
+pub(crate) struct ImageAnimationTimeline {
+    frame_end_nanos: Vec<u128>,
+}
+
+impl ImageAnimationTimeline {
+    pub(crate) fn new(delays: impl ExactSizeIterator<Item = Duration>) -> Self {
+        if delays.len() <= 1 {
+            return Self::default();
+        }
+        let mut frame_end_nanos = Vec::with_capacity(delays.len());
+        let mut end_nanos = 0;
+        for delay in delays {
+            let delay = if delay.is_zero() {
+                Duration::from_millis(10)
+            } else {
+                delay
+            };
+            end_nanos += delay.as_nanos();
+            frame_end_nanos.push(end_nanos);
+        }
+        Self { frame_end_nanos }
+    }
+
+    pub(crate) fn frame_index_at(&self, elapsed: Duration) -> usize {
+        let Some(&cycle_nanos) = self.frame_end_nanos.last() else {
+            return 0;
+        };
+        let phase_nanos = elapsed.as_nanos() % cycle_nanos;
+        self.frame_end_nanos
+            .partition_point(|&end| end <= phase_nanos)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn timeline(delays: &[u64]) -> ImageAnimationTimeline {
+        ImageAnimationTimeline::new(delays.iter().map(|&delay| Duration::from_millis(delay)))
+    }
+
+    #[test]
+    fn unequal_delays_keep_exact_boundaries_and_wrap() {
+        let timeline = timeline(&[100, 250, 50]);
+        let observed: Vec<_> = [0, 99, 100, 349, 350, 399, 400, 499, 500]
+            .into_iter()
+            .map(|time| timeline.frame_index_at(Duration::from_millis(time)))
+            .collect();
+        assert_eq!(observed, [0, 0, 1, 1, 2, 2, 0, 0, 1]);
+    }
+
+    #[test]
+    fn zero_delays_receive_a_ten_millisecond_frame() {
+        let timeline = timeline(&[0, 25]);
+        let observed: Vec<_> = [0, 9, 10, 34, 35]
+            .into_iter()
+            .map(|time| timeline.frame_index_at(Duration::from_millis(time)))
+            .collect();
+        assert_eq!(observed, [0, 0, 1, 1, 0]);
+    }
+
+    #[test]
+    fn positive_submillisecond_delays_are_preserved() {
+        let timeline = ImageAnimationTimeline::new(
+            [Duration::from_micros(500), Duration::from_millis(2)].into_iter(),
+        );
+        let observed: Vec<_> = [499_999, 500_000, 2_499_999, 2_500_000]
+            .into_iter()
+            .map(|time| timeline.frame_index_at(Duration::from_nanos(time)))
+            .collect();
+        assert_eq!(observed, [0, 1, 1, 0]);
+    }
+
+    #[test]
+    fn empty_and_static_images_stay_on_frame_zero() {
+        let timelines = [timeline(&[]), timeline(&[0]), timeline(&[125])];
+        assert!(timelines.iter().all(|timeline| {
+            [Duration::ZERO, Duration::from_secs(123), Duration::MAX]
+                .into_iter()
+                .all(|elapsed| timeline.frame_index_at(elapsed) == 0)
+        }));
+    }
+
+    #[test]
+    fn large_elapsed_times_wrap_without_integer_truncation() {
+        assert_eq!(timeline(&[100, 250, 50]).frame_index_at(Duration::MAX), 2);
+    }
+
+    #[test]
+    fn independently_constructed_images_share_a_phase() {
+        let original = timeline(&[100, 250, 50]);
+        let later_copy = timeline(&[100, 250, 50]);
+        assert!([0, 101, 351, 812, 1_000_000].into_iter().all(|time| {
+            let elapsed = Duration::from_millis(time);
+            original.frame_index_at(elapsed) == later_copy.frame_index_at(elapsed)
+        }));
+    }
+}
