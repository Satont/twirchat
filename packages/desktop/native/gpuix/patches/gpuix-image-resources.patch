+//! Per-view decoded images, shared by resource and retired with their atlas tiles.
+//! The cache targets 64 MiB/256 entries; current visible images may exceed that
+//! budget and stay pinned so painting never causes a decode/eviction loop.
+
+use futures::FutureExt as _;
+use gpui::{
+    App, AppContext as _, Asset as _, AssetLogger, Entity, ImageAssetLoader, ImageCache,
+    ImageCacheError, ImageLoadingTask, RenderImage, Resource, Task, WeakEntity, Window,
+};
+use std::cell::Cell;
+use std::collections::{BTreeMap, HashMap};
+use std::rc::Rc;
+use std::sync::Arc;
+
+const MAX_ENTRIES: usize = 256;
+const MAX_DECODED_BYTES: usize = 64 * 1024 * 1024;
+
+#[derive(Clone, Debug)]
+#[cfg_attr(
+    not(all(target_arch = "wasm32", target_os = "unknown")),
+    napi_derive::napi(object)
+)]
+pub struct ImageResourceStats {
+    pub entries: f64,
+    pub loading: f64,
+    pub decoded_bytes: f64,
+    pub evictions: f64,
+    pub decodes: f64,
+    pub max_entries: f64,
+    pub max_decoded_bytes: f64,
+}
+
+impl Default for ImageResourceStats {
+    fn default() -> Self {
+        Self {
+            entries: 0.0,
+            loading: 0.0,
+            decoded_bytes: 0.0,
+            evictions: 0.0,
+            decodes: 0.0,
+            max_entries: MAX_ENTRIES as f64,
+            max_decoded_bytes: MAX_DECODED_BYTES as f64,
+        }
+    }
+}
+
+pub(crate) type SharedImageResourceStats = Arc<parking_lot::Mutex<ImageResourceStats>>;
+
+struct Access {
+    stamp: u64,
+    epoch: u64,
+    bytes: usize,
+}
+
+struct ResourceBudget {
+    entries: HashMap<Resource, Access>,
+    order: BTreeMap<u64, Resource>,
+    epoch: u64,
+    stamp: u64,
+    bytes: usize,
+    max_entries: usize,
+    max_bytes: usize,
+    draw_id: Option<u64>,
+}
+
+impl ResourceBudget {
+    fn new(max_entries: usize, max_bytes: usize) -> Self {
+        Self {
+            entries: HashMap::new(),
+            order: BTreeMap::new(),
+            epoch: 0,
+            stamp: 0,
+            bytes: 0,
+            max_entries,
+            max_bytes,
+            draw_id: None,
+        }
+    }
+
+    fn begin_draw(&mut self, draw_id: u64) -> bool {
+        if self.draw_id == Some(draw_id) {
+            return false;
+        }
+        self.draw_id = Some(draw_id);
+        self.begin_frame();
+        true
+    }
+
+    fn begin_frame(&mut self) {
+        self.epoch += 1;
+    }
+
+    fn touch(&mut self, resource: &Resource) {
+        self.stamp += 1;
+        let access = self.entries.entry(resource.clone()).or_insert(Access {
+            stamp: self.stamp,
+            epoch: self.epoch,
+            bytes: 0,
+        });
+        self.order.remove(&access.stamp);
+        access.stamp = self.stamp;
+        access.epoch = self.epoch;
+        self.order.insert(self.stamp, resource.clone());
+    }
+
+    fn set_bytes(&mut self, resource: &Resource, bytes: usize) {
+        if let Some(access) = self.entries.get_mut(resource) {
+            self.bytes -= access.bytes;
+            self.bytes += bytes;
+            access.bytes = bytes;
+        }
+    }
+
+    fn is_over_budget(&self) -> bool {
+        self.entries.len() > self.max_entries || self.bytes > self.max_bytes
+    }
+
+    fn oldest_evictable(&self, protect_previous: bool) -> Option<&Resource> {
+        if !self.is_over_budget() {
+            return None;
+        }
+        let (_, resource) = self.order.first_key_value()?;
+        let access = self.entries.get(resource)?;
+        let protected_epoch = self.epoch.saturating_sub(u64::from(protect_previous));
+        if access.epoch >= protected_epoch {
+            return None;
+        }
+        Some(resource)
+    }
+
+    fn evict_oldest(&mut self, protect_previous: bool) -> Option<Resource> {
+        self.oldest_evictable(protect_previous)?;
+        let (_, resource) = self.order.pop_first()?;
+        if let Some(access) = self.entries.remove(&resource) {
+            self.bytes -= access.bytes;
+        }
+        Some(resource)
+    }
+}
+
+enum ImageState {
+    Loading(ImageLoadingTask),
+    Loaded(Result<Arc<RenderImage>, ImageCacheError>),
+}
+
+struct Entry {
+    load: u64,
+    state: ImageState,
+    _completion: Task<()>,
+    completing: Rc<Cell<bool>>,
+}
+
+pub(crate) struct ImageResources {
+    entries: HashMap<Resource, Entry>,
+    budget: ResourceBudget,
+    weak: WeakEntity<Self>,
+    stats: SharedImageResourceStats,
+    loading: usize,
+    decodes: u64,
+    evictions: u64,
+    settle_pending: bool,
+}
+
+impl ImageResources {
+    pub(crate) fn new(stats: SharedImageResourceStats, cx: &mut App) -> Entity<Self> {
+        let cache = cx.new(|cx| Self {
+            entries: HashMap::new(),
+            budget: ResourceBudget::new(MAX_ENTRIES, MAX_DECODED_BYTES),
+            weak: cx.weak_entity(),
+            stats,
+            loading: 0,
+            decodes: 0,
+            evictions: 0,
+            settle_pending: false,
+        });
+        cx.observe_release(&cache, |cache, cx| {
+            for (_, entry) in cache.entries.drain() {
+                match entry.state {
+                    ImageState::Loaded(Ok(image)) => cx.drop_image(image, None),
+                    ImageState::Loading(task) => {
+                        if let Some(Ok(image)) = task.now_or_never() {
+                            cx.drop_image(image, None);
+                        }
+                    }
+                    ImageState::Loaded(Err(_)) => {}
+                }
+            }
+            cache.budget.entries.clear();
+            cache.budget.order.clear();
+            cache.budget.bytes = 0;
+            cache.loading = 0;
+            cache.publish();
+        })
+        .detach();
+        cache.update(cx, |cache, _| cache.publish());
+        cache
+    }
+
+    pub(crate) fn set_stats(&mut self, stats: SharedImageResourceStats) {
+        self.stats = stats;
+        self.publish();
+    }
+
+    pub(crate) fn begin_frame(&mut self, window: &mut Window, cx: &mut App) {
+        if self.budget.begin_draw(window.draw_id()) {
+            self.trim(true, window, cx);
+        }
+    }
+
+    fn publish(&self) {
+        *self.stats.lock() = ImageResourceStats {
+            entries: self.entries.len() as f64,
+            loading: self.loading as f64,
+            decoded_bytes: self.budget.bytes as f64,
+            evictions: self.evictions as f64,
+            decodes: self.decodes as f64,
+            max_entries: MAX_ENTRIES as f64,
+            max_decoded_bytes: MAX_DECODED_BYTES as f64,
+        };
+    }
+
+    fn trim(&mut self, protect_previous: bool, window: &mut Window, cx: &mut App) {
+        let mut changed = false;
+        loop {
+            if self
+                .budget
+                .oldest_evictable(protect_previous)
+                .and_then(|resource| self.entries.get(resource))
+                .is_some_and(|entry| entry.completing.get())
+            {
+                break;
+            }
+            let Some(resource) = self.budget.evict_oldest(protect_previous) else {
+                break;
+            };
+            if let Some(entry) = self.entries.remove(&resource) {
+                match entry.state {
+                    ImageState::Loaded(Ok(image)) => cx.drop_image(image, Some(window)),
+                    ImageState::Loading(task) => {
+                        self.loading -= 1;
+                        if let Some(Ok(image)) = task.now_or_never() {
+                            cx.drop_image(image, Some(window));
+                        }
+                    }
+                    ImageState::Loaded(Err(_)) => {}
+                }
+                self.evictions += 1;
+                changed = true;
+            }
+        }
+        if changed {
+            self.publish();
+        }
+        if protect_previous {
+            self.schedule_settle(window, cx);
+        }
+    }
+
+    fn schedule_settle(&mut self, window: &mut Window, _cx: &mut App) {
+        if self.budget.is_over_budget() && !self.settle_pending {
+            self.settle_pending = true;
+            let weak = self.weak.clone();
+            // A previous frame may still reference its atlas tiles. Once it has
+            // painted, retire cold images even if the chat becomes completely idle.
+            window.on_next_frame(move |window, cx| {
+                weak.update(cx, |cache, cx| {
+                    cache.settle_pending = false;
+                    cache.trim(false, window, cx);
+                })
+                .ok();
+            });
+        }
+    }
+
+    fn complete(
+        &mut self,
+        resource: Resource,
+        load: u64,
+        result: Result<Arc<RenderImage>, ImageCacheError>,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let Some(entry) = self.entries.get_mut(&resource) else {
+            return;
+        };
+        if entry.load != load || !matches!(entry.state, ImageState::Loading(_)) {
+            return;
+        }
+        let bytes = result.as_ref().map_or(0, |image| decoded_bytes(image));
+        entry.state = ImageState::Loaded(result);
+        self.loading -= 1;
+        self.budget.set_bytes(&resource, bytes);
+        self.publish();
+        self.schedule_settle(window, cx);
+    }
+}
+
+impl ImageCache for ImageResources {
+    fn load(
+        &mut self,
+        resource: &Resource,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Option<Result<Arc<RenderImage>, ImageCacheError>> {
+        self.begin_frame(window, cx);
+        self.budget.touch(resource);
+        if let Some(entry) = self.entries.get(resource) {
+            return match &entry.state {
+                ImageState::Loaded(result) => Some(result.clone()),
+                ImageState::Loading(_) => None,
+            };
+        }
+
+        self.decodes += 1;
+        self.loading += 1;
+        let load = self.decodes;
+        let future = AssetLogger::<ImageAssetLoader>::load(resource.clone(), cx);
+        let task = cx.background_executor().spawn(future).shared();
+        let completion_task = task.clone();
+        let completion_resource = resource.clone();
+        let weak = self.weak.clone();
+        let view = window.current_view();
+        let completing = Rc::new(Cell::new(false));
+        let is_completing = completing.clone();
+        let completion = window.spawn(cx, async move |cx| {
+            let result = completion_task.await;
+            is_completing.set(true);
+            cx.update(move |window, cx| {
+                if weak
+                    .update(cx, |cache, cx| {
+                        cache.complete(completion_resource, load, result, window, cx)
+                    })
+                    .is_ok()
+                {
+                    cx.notify(view);
+                }
+            })
+            .ok();
+            is_completing.set(false);
+        });
+        self.entries.insert(
+            resource.clone(),
+            Entry {
+                load,
+                state: ImageState::Loading(task),
+                _completion: completion,
+                completing,
+            },
+        );
+        self.publish();
+        self.trim(true, window, cx);
+        None
+    }
+}
+
+fn decoded_bytes(image: &RenderImage) -> usize {
+    (0..image.frame_count())
+        .filter_map(|frame| image.as_bytes(frame))
+        .map(<[u8]>::len)
+        .sum()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn resource(name: &str) -> Resource {
+        Resource::Embedded(name.to_string().into())
+    }
+
+    #[test]
+    fn revisiting_a_source_deduplicates_entries_and_lru_links() {
+        let mut budget = ResourceBudget::new(2, 100);
+        budget.begin_frame();
+        for _ in 0..10_000 {
+            budget.touch(&resource("same"));
+        }
+        assert_eq!((budget.entries.len(), budget.order.len()), (1, 1));
+    }
+
+    #[test]
+    fn decoded_byte_budget_evicts_cold_images_before_entry_limit() {
+        let mut budget = ResourceBudget::new(256, 100);
+        budget.begin_frame();
+        budget.touch(&resource("old"));
+        budget.set_bytes(&resource("old"), 80);
+        budget.begin_frame();
+        budget.touch(&resource("visible"));
+        budget.set_bytes(&resource("visible"), 80);
+        assert_eq!(budget.evict_oldest(false), Some(resource("old")));
+        assert_eq!(budget.bytes, 80);
+    }
+
+    #[test]
+    fn previous_frame_is_protected_until_settling_after_paint() {
+        let mut budget = ResourceBudget::new(256, 100);
+        budget.begin_frame();
+        budget.touch(&resource("old"));
+        budget.set_bytes(&resource("old"), 200);
+        budget.begin_frame();
+        assert_eq!(budget.evict_oldest(true), None);
+        assert_eq!(budget.evict_oldest(false), Some(resource("old")));
+    }
+
+    #[test]
+    fn visible_images_can_exceed_budget_without_redecode_thrashing() {
+        let mut budget = ResourceBudget::new(1, 100);
+        budget.begin_frame();
+        for name in ["left", "right"] {
+            budget.touch(&resource(name));
+            budget.set_bytes(&resource(name), 200);
+        }
+        assert_eq!(budget.evict_oldest(false), None);
+        budget.begin_frame();
+        budget.touch(&resource("right"));
+        assert_eq!(budget.evict_oldest(false), Some(resource("left")));
+        assert_eq!(budget.evict_oldest(false), None);
+    }
+
+    #[test]
+    fn completed_load_updates_bytes_without_reordering_recent_use() {
+        let mut budget = ResourceBudget::new(1, 1000);
+        budget.begin_frame();
+        budget.touch(&resource("old"));
+        budget.touch(&resource("recent"));
+        budget.set_bytes(&resource("old"), 50);
+        budget.begin_frame();
+        assert_eq!(budget.evict_oldest(false), Some(resource("old")));
+    }
+
+    #[test]
+    fn entry_limit_also_bounds_cold_loads_without_decoded_bytes() {
+        let mut budget = ResourceBudget::new(2, usize::MAX);
+        budget.begin_frame();
+        for name in ["old-a", "old-b", "old-c"] {
+            budget.touch(&resource(name));
+        }
+        budget.begin_frame();
+        assert_eq!(budget.evict_oldest(false), Some(resource("old-a")));
+        assert_eq!(budget.evict_oldest(false), None);
+    }
+
+    #[test]
+    fn repeated_layouts_in_one_native_draw_do_not_retire_visible_images() {
+        let mut budget = ResourceBudget::new(1, 100);
+        assert!(budget.begin_draw(42));
+        budget.touch(&resource("visible"));
+        budget.set_bytes(&resource("visible"), 200);
+        for _ in 0..100 {
+            assert!(!budget.begin_draw(42));
+        }
+        assert_eq!(budget.epoch, 1);
+        assert_eq!(budget.evict_oldest(false), None);
+    }
+
+    #[test]
+    fn new_draw_identity_retires_old_sources_without_root_frame_start() {
+        let mut budget = ResourceBudget::new(1, 100);
+        budget.begin_draw(42);
+        budget.touch(&resource("old"));
+        budget.set_bytes(&resource("old"), 80);
+        // The first deferred image load, not a root Render call, supplies this ID.
+        budget.begin_draw(43);
+        budget.touch(&resource("new"));
+        budget.set_bytes(&resource("new"), 80);
+        assert_eq!(budget.evict_oldest(false), Some(resource("old")));
+    }
+
+    #[test]
+    fn all_decoded_pixel_bytes_are_counted() {
+        let image = RenderImage::from_bgra(12, 8, vec![0; 12 * 8 * 4]).unwrap();
+        assert_eq!(decoded_bytes(&image), 12 * 8 * 4);
+    }
+}
