+#[cfg(test)]
+mod available_space_tests {
+    use super::*;
+    use crate::{self as gpui, AppContext as _, Context, Render, TestAppContext, div};
+
+    struct AvailableSpaceView {
+        state: ListState,
+        sizing_behavior: ListSizingBehavior,
+        observed: Rc<RefCell<Vec<Size<AvailableSpace>>>>,
+    }
+
+    impl Render for AvailableSpaceView {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            let observed = self.observed.clone();
+            list_with_available_space(self.state.clone(), move |_, available_space, _, _| {
+                observed.borrow_mut().push(available_space);
+                div().w(px(40.)).h(px(20.)).into_any_element()
+            })
+            .with_sizing_behavior(self.sizing_behavior)
+            .w_full()
+            .h_full()
+            .px(px(7.))
+        }
+    }
+
+    #[gpui::test]
+    fn item_callback_receives_current_measurement_space(cx: &mut TestAppContext) {
+        let cx = cx.add_empty_window();
+        let state = ListState::new(5, ListAlignment::Top, px(20.));
+        let observed = Rc::new(RefCell::new(Vec::new()));
+
+        for width in [px(100.), px(180.)] {
+            observed.borrow_mut().clear();
+            cx.draw(point(px(0.), px(0.)), size(width, px(60.)), |_, cx| {
+                cx.new(|_| AvailableSpaceView {
+                    state: state.clone(),
+                    sizing_behavior: ListSizingBehavior::Auto,
+                    observed: observed.clone(),
+                })
+                .into_any_element()
+            });
+            let observed = observed.borrow();
+            assert!(!observed.is_empty());
+            assert!(observed.iter().all(|space| {
+                *space
+                    == size(
+                        AvailableSpace::Definite(width - px(14.)),
+                        AvailableSpace::MinContent,
+                    )
+            }));
+        }
+
+        observed.borrow_mut().clear();
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(60.)), |_, cx| {
+            cx.new(|_| AvailableSpaceView {
+                state: ListState::new(5, ListAlignment::Top, px(20.)),
+                sizing_behavior: ListSizingBehavior::Infer,
+                observed: observed.clone(),
+            })
+            .into_any_element()
+        });
+        let observed = observed.borrow();
+        assert_eq!(
+            observed.first(),
+            Some(&size(
+                AvailableSpace::MaxContent,
+                AvailableSpace::MinContent
+            )),
+        );
+        assert!(observed.contains(&size(
+            AvailableSpace::Definite(px(86.)),
+            AvailableSpace::MinContent,
+        )));
+    }
