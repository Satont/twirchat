+    pub(crate) fn request_image_animation_frame(&mut self, deadline: Instant) {
+        self.image_animation_deadline = Some(
+            self.image_animation_deadline
+                .map_or(deadline, |current| current.min(deadline)),
+        );
+    }
+
+    pub(crate) fn suspend_image_animation(&mut self) {
+        self.image_animation_suspended = true;
+    }
+
+    fn image_animation_hidden(&self) -> bool {
+        self.native_window_visibility_state()
+            .is_some_and(|visibility| visibility.load(std::sync::atomic::Ordering::Relaxed) == 2)
+    }
+
+    fn finish_image_animation(&mut self, cx: &App) {
+        let Some(deadline) = self.image_animation_deadline else {
+            self.image_animation_timer = None;
+            return;
+        };
+        if self
+            .image_animation_timer
+            .as_ref()
+            .is_some_and(|(current, _)| *current == deadline)
+        {
+            return;
+        }
+        let task = self.spawn(cx, async move |cx| {
+            cx.background_executor()
+                .timer(deadline.saturating_duration_since(Instant::now()))
+                .await;
+            cx.update(|window, cx| {
+                if cx.reduce_motion() {
+                    return;
+                }
+                if window.image_animation_hidden() {
+                    window.image_animation_suspended = true;
+                    return;
+                }
+                // Refresh the whole uncached image tree through the native frame throttle.
+                window.on_next_frame(|window, _| window.refresh());
+            })
+            .ok();
+        });
+        self.image_animation_timer = Some((deadline, task));
+    }
