+#[cfg(any(feature = "wayland", feature = "x11"))]
+pub(super) fn decode_clipboard_file_list(bytes: &[u8]) -> Option<ClipboardItem> {
+    let list = str::from_utf8(bytes).ok()?;
+    let paths: smallvec::SmallVec<[_; 2]> = list
+        .lines()
+        .filter_map(|line| {
+            let url = http_client::Url::parse(line).ok()?;
+            if url.scheme() != "file" || url.host_str().is_some() {
+                return None;
+            }
+            let path = url.to_file_path().ok()?;
+            (!path.as_os_str().as_encoded_bytes().contains(&0)).then_some(path)
+        })
+        // One entry past the paste limit lets the consumer report the error.
+        .take(11)
+        .collect();
+    if paths.is_empty() {
+        return None;
+    }
+    Some(ClipboardItem {
+        entries: vec![gpui::ClipboardEntry::ExternalPaths(gpui::ExternalPaths(paths))],
+    })
+}
