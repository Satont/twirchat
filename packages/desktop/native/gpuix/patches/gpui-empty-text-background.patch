+    fn background_test_line(window: &mut Window) -> ShapedLine {
+        let font_id = window
+            .text_system()
+            .shape_line(
+                "abcd".into(),
+                px(16.),
+                &[TextRun {
+                    len: 4,
+                    ..Default::default()
+                }],
+                None,
+            )
+            .runs[0]
+            .font_id;
+        let mut line = make_shaped_line("abcd", &[(0, 0.), (1, 10.), (2, 20.), (3, 30.)], 40., &[]);
+        Arc::get_mut(&mut line.layout).unwrap().runs[0].font_id = font_id;
+        line
+    }
+
+    fn background_run(len: u32, color: Option<Hsla>) -> DecorationRun {
+        DecorationRun {
+            len,
+            color: black(),
+            background_color: color,
+            underline: None,
+            strikethrough: None,
+        }
+    }
