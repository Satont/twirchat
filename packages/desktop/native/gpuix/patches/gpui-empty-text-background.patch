+    #[gpui::test]
+    fn absent_background_adds_no_operations_or_ordering_barrier(cx: &mut TestAppContext) {
+        cx.add_empty_window()
+            .draw(point(px(0.), px(0.)), size(px(100.), px(100.)), |_, _| {
+                canvas(
+                    |_, _, _| (),
+                    |_, _, window, cx| {
+                        let line = make_shaped_line(
+                            "abcd",
+                            &[(0, 0.), (1, 10.), (2, 20.), (3, 30.)],
+                            40.,
+                            &[],
+                        );
+                        let bounds = Bounds::new(point(px(0.), px(0.)), size(px(40.), px(20.)));
+                        window.paint_quad(fill(bounds, black()));
+                        let first_order = window.next_frame.scene.quads.last().unwrap().order;
+                        let operations = window.next_frame.scene.len();
+                        for runs in [
+                            vec![],
+                            vec![background_run(1, None), background_run(3, None)],
+                        ] {
+                            paint_line_background(
+                                bounds.origin,
+                                &line.layout,
+                                px(20.),
+                                TextAlign::Left,
+                                None,
+                                &runs,
+                                &[],
+                                window,
+                                cx,
+                            )
+                            .unwrap();
+                            assert_eq!(window.next_frame.scene.len(), operations);
+                        }
+                        window.paint_quad(fill(bounds, black()));
+                        assert_eq!(
+                            window.next_frame.scene.quads.last().unwrap().order,
+                            first_order + 1
+                        );
+                    },
+                )
+                .size(px(100.))
+            });
+    }
+
+    #[gpui::test]
+    fn mixed_wrapped_backgrounds_keep_their_quads_in_one_layer(cx: &mut TestAppContext) {
+        cx.add_empty_window()
+            .draw(point(px(0.), px(0.)), size(px(100.), px(100.)), |_, _| {
+                canvas(
+                    |_, _, _| (),
+                    |_, _, window, cx| {
+                        let line = background_test_line(window);
+                        let operations = window.next_frame.scene.len();
+                        let quads = window.next_frame.scene.quads.len();
+                        paint_line_background(
+                            point(px(0.), px(0.)),
+                            &line.layout,
+                            px(20.),
+                            TextAlign::Left,
+                            None,
+                            &[background_run(1, None), background_run(3, Some(black()))],
+                            &[WrapBoundary {
+                                run_ix: 0,
+                                glyph_ix: 2,
+                            }],
+                            window,
+                            cx,
+                        )
+                        .unwrap();
+                        let scene = &window.next_frame.scene;
+                        let painted = &scene.quads[quads..];
+                        assert_eq!(painted.len(), 2);
+                        assert_eq!(painted[0].order, painted[1].order);
+                        assert_eq!(
+                            painted[0].bounds,
+                            Bounds::new(point(px(10.), px(0.)), size(px(10.), px(20.)),)
+                                .scale(window.scale_factor())
+                        );
+                        assert_eq!(
+                            painted[1].bounds,
+                            Bounds::new(point(px(0.), px(20.)), size(px(20.), px(20.)),)
+                                .scale(window.scale_factor())
+                        );
+                        let operations = &scene.paint_operations[operations..];
+                        assert_eq!(operations.len(), 4);
+                        assert!(matches!(
+                            operations.first(),
+                            Some(PaintOperation::StartLayer(_))
+                        ));
+                        assert!(matches!(operations.last(), Some(PaintOperation::EndLayer)));
+                    },
+                )
+                .size(px(100.))
+            });
+    }
+
+    #[gpui::test]
+    fn explicit_transparent_background_keeps_its_layer(cx: &mut TestAppContext) {
+        cx.add_empty_window()
+            .draw(point(px(0.), px(0.)), size(px(100.), px(100.)), |_, _| {
+                canvas(
+                    |_, _, _| (),
+                    |_, _, window, cx| {
+                        let line = background_test_line(window);
+                        let operations = window.next_frame.scene.len();
+                        let transparent = Hsla { a: 0., ..black() };
+                        paint_line_background(
+                            point(px(0.), px(0.)),
+                            &line.layout,
+                            px(20.),
+                            TextAlign::Left,
+                            None,
+                            &[background_run(4, Some(transparent))],
+                            &[],
+                            window,
+                            cx,
+                        )
+                        .unwrap();
+                        let operations = &window.next_frame.scene.paint_operations[operations..];
+                        assert!(operations.len() >= 2);
+                        assert!(operations[1..operations.len() - 1].iter().all(|operation| {
+                            matches!(operation, PaintOperation::Primitive(_))
+                        }));
+                        assert!(matches!(
+                            operations.first(),
+                            Some(PaintOperation::StartLayer(_))
+                        ));
+                        assert!(matches!(operations.last(), Some(PaintOperation::EndLayer)));
+                    },
+                )
+                .size(px(100.))
+            });
     }
 
