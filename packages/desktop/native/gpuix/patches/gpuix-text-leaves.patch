+fn raw_text_leaf_content(element: &crate::retained_tree::RetainedElement) -> Option<&str> {
+    let content = element
+        .content
+        .as_deref()
+        .filter(|content| !content.is_empty())?;
+    (element.element_type == "text"
+        && element.style.is_none()
+        && element.children.is_empty()
+        && element.events().is_empty()
+        && element.custom_props().is_empty()
+        && !element.auto_focus
+        && element.test_id.is_none())
+    .then_some(content)
+}
