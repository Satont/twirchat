+/// A raw retained text leaf still publishes its own automation box.
+pub(crate) fn selectable_text_leaf(opts: SelectableText) -> gpui::AnyElement {
+    let id = opts.element_id;
+    SelectableTextElement::new(opts, Some(id)).into_any_element()
+}
+
+struct SelectableTextElement {
+    opts: SelectableText,
+    key: Arc<str>,
+    styled: StyledText,
+    bounds_id: Option<u64>,
+}
+
+impl SelectableTextElement {
+    fn new(mut opts: SelectableText, bounds_id: Option<u64>) -> Self {
+        let styled = match opts.runs.take() {
+            Some(runs) => StyledText::new(opts.text.clone()).with_runs(runs),
+            None => StyledText::new(opts.text.clone()),
+        };
+        Self {
+            key: selection_key(opts.element_id, opts.sub),
+            opts,
+            styled,
+            bounds_id,
+        }
+    }
+}
+
+impl gpui::IntoElement for SelectableTextElement {
+    type Element = Self;
+
+    fn into_element(self) -> Self::Element {
+        self
+    }
+}
