+use crate::{
+    AtlasTextureId, AtlasTile, ImageId, PlatformAtlas, PolychromeSprite, RenderImage,
+    RenderImageParams,
+};
+use anyhow::{Result, anyhow};
+use std::{
+    borrow::Cow,
+    collections::{HashMap, HashSet},
+    sync::Arc,
+    time::Duration,
+};
+
+/// Counters for full layout/paint versus stable-scene image animation.
+#[derive(Clone, Copy, Debug, Default)]
+#[expect(missing_docs)]
+pub struct ImageAnimationStats {
+    pub full_draws: u64,
+    pub animation_only_presents: u64,
+    pub slot_uploads: u64,
+    pub live_slots: usize,
+    pub fallbacks: u64,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+struct SourceKey {
+    image: ImageId,
+    animate_when_inactive: bool,
+}
+
+struct Slot {
+    source: Arc<RenderImage>,
+    image: ImageId,
+    frame: usize,
+    draw: u64,
+    tile: Option<AtlasTile>,
+    stable: bool,
+}
+
+impl Slot {
+    fn new(source: Arc<RenderImage>) -> Self {
+        let stable = same_frame_dimensions(&source);
+        Self {
+            source,
+            image: ImageId::new(),
+            frame: 0,
+            draw: 0,
+            tile: None,
+            stable,
+        }
+    }
+
+    fn params(&self, frame: usize) -> RenderImageParams {
+        RenderImageParams {
+            image_id: if self.stable {
+                self.image
+            } else {
+                self.source.id
+            },
+            frame_index: if self.stable { 0 } else { frame },
+        }
+    }
+
+    fn remove(&self, atlas: &dyn PlatformAtlas) {
+        if self.stable {
+            atlas.remove(
+                &RenderImageParams {
+                    image_id: self.image,
+                    frame_index: 0,
+                }
+                .into(),
+            );
+        }
+    }
+
+    fn paint_tile(
+        &mut self,
+        atlas: &dyn PlatformAtlas,
+        frame: usize,
+        draw: u64,
+        stats: &mut ImageAnimationStats,
+    ) -> Result<AtlasTile> {
+        if self.draw == draw
+            && self.frame == frame
+            && let Some(tile) = self.tile
+        {
+            return Ok(tile);
+        }
+        let key = self.params(frame).into();
+        let mut uploaded = false;
+        let mut tile = atlas
+            .get_or_insert_with(&key, &mut || {
+                uploaded = true;
+                Ok(Some((
+                    self.source.size(frame),
+                    Cow::Borrowed(
+                        self.source
+                            .as_bytes(frame)
+                            .ok_or_else(|| anyhow!("missing animation frame {frame}"))?,
+                    ),
+                )))
+            })?
+            .ok_or_else(|| anyhow!("image atlas did not allocate an animation tile"))?;
+        if self.stable && !uploaded && self.frame != frame {
+            tile = atlas
+                .update(
+                    &key,
+                    self.source.size(frame),
+                    self.source
+                        .as_bytes(frame)
+                        .ok_or_else(|| anyhow!("missing animation frame {frame}"))?,
+                )?
+                .ok_or_else(|| anyhow!("image atlas did not update an animation tile"))?;
+            uploaded = true;
+        }
+        if self.stable && uploaded {
+            stats.slot_uploads += 1;
+        }
+        self.tile = Some(tile);
+        self.frame = frame;
+        self.draw = draw;
+        Ok(tile)
+    }
+}
+
+pub(crate) struct ImageAnimationAdvance {
+    pub changed: bool,
+    pub needs_draw: bool,
+    pub remaining: Option<Duration>,
+}
+
+pub(crate) struct ImageSceneAnimations {
+    atlas: Arc<dyn PlatformAtlas>,
+    slots: HashMap<SourceKey, Slot>,
+    stats: ImageAnimationStats,
+    observers: Vec<Box<dyn Fn(ImageAnimationStats)>>,
+}
+
+impl ImageSceneAnimations {
+    pub(crate) fn new(atlas: Arc<dyn PlatformAtlas>) -> Self {
+        Self {
+            atlas,
+            slots: HashMap::new(),
+            stats: ImageAnimationStats::default(),
+            observers: Vec::new(),
+        }
+    }
+
+    pub(crate) fn observe(&mut self, observer: impl Fn(ImageAnimationStats) + 'static) {
+        observer(self.stats);
+        self.observers.push(Box::new(observer));
+    }
+
+    pub(crate) fn frame(&self, source: ImageId, animate_when_inactive: bool) -> Option<usize> {
+        self.slots
+            .get(&SourceKey {
+                image: source,
+                animate_when_inactive,
+            })
+            .map(|slot| slot.frame)
+    }
+
+    pub(crate) fn paint_tile(
+        &mut self,
+        source: Arc<RenderImage>,
+        frame: usize,
+        draw: u64,
+        animate_when_inactive: bool,
+    ) -> Result<AtlasTile> {
+        let key = SourceKey {
+            image: source.id,
+            animate_when_inactive,
+        };
+        let slot = self.slots.entry(key).or_insert_with(|| {
+            let slot = Slot::new(source.clone());
+            if !slot.stable {
+                self.stats.fallbacks += 1;
+            }
+            slot
+        });
+        if !Arc::ptr_eq(&slot.source, &source) {
+            slot.remove(self.atlas.as_ref());
+            *slot = Slot::new(source);
+            if !slot.stable {
+                self.stats.fallbacks += 1;
+            }
+        }
+        match slot.paint_tile(self.atlas.as_ref(), frame, draw, &mut self.stats) {
+            Err(_) if slot.stable => {
+                slot.remove(self.atlas.as_ref());
+                slot.stable = false;
+                slot.tile = None;
+                self.stats.fallbacks += 1;
+                slot.paint_tile(self.atlas.as_ref(), frame, draw, &mut self.stats)
+            }
+            result => result,
+        }
+    }
+
+    pub(crate) fn finish_draw(&mut self, sprites: &[PolychromeSprite]) {
+        if !self.slots.is_empty() {
+            let used: HashSet<_> = sprites
+                .iter()
+                .map(|sprite| allocation(sprite.tile))
+                .collect();
+            self.slots.retain(|_, slot| {
+                let live = slot.tile.is_some_and(|tile| {
+                    used.contains(&allocation(tile))
+                        && self
+                            .atlas
+                            .get_or_insert_with(&slot.params(slot.frame).into(), &mut || Ok(None))
+                            .is_ok_and(|current| current == Some(tile))
+                });
+                if !live {
+                    slot.remove(self.atlas.as_ref());
+                }
+                live
+            });
+        }
+        self.stats.full_draws += 1;
+        self.publish();
+    }
+
+    pub(crate) fn next_deadline(&self, elapsed: Duration, active: bool) -> Option<Duration> {
+        self.slots
+            .iter()
+            .filter(|(key, _)| active || key.animate_when_inactive)
+            .filter_map(|(_, slot)| slot.source.frame_at(elapsed).1)
+            .min()
+    }
+
+    pub(crate) fn advance(&mut self, elapsed: Duration, active: bool) -> ImageAnimationAdvance {
+        let mut advance = ImageAnimationAdvance {
+            changed: false,
+            needs_draw: false,
+            remaining: None,
+        };
+        for (key, slot) in &mut self.slots {
+            if !active && !key.animate_when_inactive {
+                continue;
+            }
+            let (frame, remaining) = slot.source.frame_at(elapsed);
+            if let Some(remaining) = remaining {
+                advance.remaining = Some(
+                    advance
+                        .remaining
+                        .map_or(remaining, |current| current.min(remaining)),
+                );
+            }
+            if frame == slot.frame {
+                continue;
+            }
+            if !slot.stable {
+                advance.needs_draw = true;
+                continue;
+            }
+            let params = slot.params(frame).into();
+            let previous = self.atlas.get_or_insert_with(&params, &mut || Ok(None));
+            let updated = previous.and_then(|previous| {
+                if previous != slot.tile || previous.is_none() {
+                    return Err(anyhow!("animation atlas tile was discarded"));
+                }
+                self.atlas.update(
+                    &params,
+                    slot.source.size(frame),
+                    slot.source
+                        .as_bytes(frame)
+                        .ok_or_else(|| anyhow!("missing animation frame {frame}"))?,
+                )
+            });
+            if matches!(&updated, Ok(Some(_))) {
+                self.stats.slot_uploads += 1;
+            }
+            match updated {
+                Ok(Some(tile)) if Some(tile) == slot.tile => {
+                    slot.frame = frame;
+                    advance.changed = true;
+                }
+                _ => {
+                    slot.remove(self.atlas.as_ref());
+                    slot.stable = false;
+                    slot.tile = None;
+                    self.stats.fallbacks += 1;
+                    advance.needs_draw = true;
+                }
+            }
+        }
+        advance
+    }
+
+    pub(crate) fn record_present(&mut self) {
+        self.stats.animation_only_presents += 1;
+        self.publish();
+    }
+
+    fn publish(&mut self) {
+        self.stats.live_slots = self.slots.len();
+        for observer in &self.observers {
+            observer(self.stats);
+        }
+    }
+}
+
+impl Drop for ImageSceneAnimations {
+    fn drop(&mut self) {
+        for (_, slot) in self.slots.drain() {
+            slot.remove(self.atlas.as_ref());
+        }
+        self.publish();
+    }
+}
+
+fn allocation(tile: AtlasTile) -> (AtlasTextureId, u32) {
+    (tile.texture_id, tile.tile_id.0)
+}
+
+fn same_frame_dimensions(source: &RenderImage) -> bool {
+    source.frame_count() > 1
+        && (1..source.frame_count()).all(|frame| source.size(frame) == source.size(0))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{AtlasKey, AtlasTextureKind, Bounds, DevicePixels, TileId, point, size};
+    use image::{Delay, Frame, Rgba, RgbaImage};
+    use parking_lot::Mutex;
+    use smallvec::SmallVec;
+    use std::{cell::Cell, rc::Rc};
+
+    #[derive(Default)]
+    struct AtlasState {
+        tiles: HashMap<AtlasKey, AtlasTile>,
+        serial: u32,
+        uploads: usize,
+        relocate: bool,
+    }
+
+    #[derive(Default)]
+    struct TestAtlas(Mutex<AtlasState>);
+
+    fn tile(serial: u32, dimensions: crate::Size<DevicePixels>) -> AtlasTile {
+        AtlasTile {
+            texture_id: AtlasTextureId {
+                index: 0,
+                kind: AtlasTextureKind::Polychrome,
+            },
+            tile_id: TileId(serial),
+            padding: 0,
+            bounds: Bounds {
+                origin: point(DevicePixels(0), DevicePixels(0)),
+                size: dimensions,
+            },
+        }
+    }
+
+    impl PlatformAtlas for TestAtlas {
+        fn get_or_insert_with<'a>(
+            &self,
+            key: &AtlasKey,
+            build: &mut dyn FnMut() -> Result<Option<(crate::Size<DevicePixels>, Cow<'a, [u8]>)>>,
+        ) -> Result<Option<AtlasTile>> {
+            let mut state = self.0.lock();
+            if let Some(tile) = state.tiles.get(key) {
+                return Ok(Some(*tile));
+            }
+            let Some((dimensions, _)) = build()? else {
+                return Ok(None);
+            };
+            state.serial += 1;
+            let tile = tile(state.serial, dimensions);
+            state.tiles.insert(key.clone(), tile);
+            state.uploads += 1;
+            Ok(Some(tile))
+        }
+
+        fn update(
+            &self,
+            key: &AtlasKey,
+            dimensions: crate::Size<DevicePixels>,
+            _bytes: &[u8],
+        ) -> Result<Option<AtlasTile>> {
+            let mut state = self.0.lock();
+            let updated = if state.relocate {
+                state.serial += 1;
+                tile(state.serial, dimensions)
+            } else {
+                *state.tiles.get(key).expect("tile already uploaded")
+            };
+            state.tiles.insert(key.clone(), updated);
+            state.uploads += 1;
+            Ok(Some(updated))
+        }
+
+        fn remove(&self, key: &AtlasKey) {
+            self.0.lock().tiles.remove(key);
+        }
+    }
+
+    fn image(delays: &[u32]) -> Arc<RenderImage> {
+        Arc::new(RenderImage::new(SmallVec::from_iter(
+            delays.iter().enumerate().map(|(frame, delay)| {
+                Frame::from_parts(
+                    RgbaImage::from_pixel(2, 2, Rgba([frame as u8, 0, 0, 255])),
+                    0,
+                    0,
+                    Delay::from_numer_denom_ms(*delay, 1),
+                )
+            }),
+        )))
+    }
+
+    fn sprite(tile: AtlasTile) -> PolychromeSprite {
+        PolychromeSprite {
+            order: 0,
+            nearest_neighbor: false.into(),
+            grayscale: false.into(),
+            opacity: 1.0,
+            bounds: Bounds::default(),
+            content_mask: crate::ContentMask::default(),
+            corner_radii: crate::Corners::default(),
+            tile,
+        }
+    }
+
+    #[test]
+    fn duplicate_visible_instances_share_one_slot_and_upload() {
+        let atlas = Arc::new(TestAtlas::default());
+        let mut animations = ImageSceneAnimations::new(atlas.clone());
+        let image = image(&[100, 100]);
+        let original = animations.paint_tile(image.clone(), 0, 1, true).unwrap();
+        for _ in 0..100 {
+            assert_eq!(
+                animations.paint_tile(image.clone(), 0, 1, true).unwrap(),
+                original
+            );
+        }
+        assert_eq!((animations.slots.len(), atlas.0.lock().uploads), (1, 1));
+    }
+
+    #[test]
+    fn windows_get_distinct_keys_without_overwriting_source_frame_zero() {
+        let atlas = Arc::new(TestAtlas::default());
+        let source = image(&[100, 100]);
+        let mut first = ImageSceneAnimations::new(atlas.clone());
+        let mut second = ImageSceneAnimations::new(atlas.clone());
+        let a = first.paint_tile(source.clone(), 0, 1, true).unwrap();
+        let b = second.paint_tile(source.clone(), 0, 1, true).unwrap();
+        assert_ne!(allocation(a), allocation(b));
+        assert!(atlas.0.lock().tiles.keys().all(|key| matches!(key,
+            AtlasKey::Image(params) if params.image_id != source.id && params.frame_index == 0)));
+    }
+
+    #[test]
+    fn uploads_happen_only_when_encoded_frame_changes_and_retain_allocation() {
+        let atlas = Arc::new(TestAtlas::default());
+        let mut animations = ImageSceneAnimations::new(atlas.clone());
+        let source = image(&[100, 100]);
+        let tile = animations.paint_tile(source.clone(), 0, 1, true).unwrap();
+        let early = animations.advance(Duration::from_millis(99), true);
+        assert!(!early.changed && !early.needs_draw);
+        assert_eq!(early.remaining, Some(Duration::from_millis(1)));
+        let due = animations.advance(Duration::from_millis(100), true);
+        assert!(due.changed && !due.needs_draw);
+        assert_eq!(animations.frame(source.id, true), Some(1));
+        assert_eq!(animations.slots.values().next().unwrap().tile, Some(tile));
+        assert_eq!(atlas.0.lock().uploads, 2);
+    }
+
+    #[test]
+    fn irregular_delays_and_wrap_preserve_exact_boundaries() {
+        let mut animations = ImageSceneAnimations::new(Arc::new(TestAtlas::default()));
+        let source = image(&[100, 250, 50]);
+        animations.paint_tile(source.clone(), 0, 1, true).unwrap();
+        for (elapsed, expected, remaining) in
+            [(100, 1, 250), (349, 1, 1), (350, 2, 50), (400, 0, 100)]
+        {
+            let update = animations.advance(Duration::from_millis(elapsed), true);
+            assert!(!update.needs_draw);
+            assert_eq!(animations.frame(source.id, true), Some(expected));
+            assert_eq!(update.remaining, Some(Duration::from_millis(remaining)));
+        }
+    }
+
+    #[test]
+    fn cropped_cached_scene_tiles_keep_the_slot_until_scene_replacement() {
+        let atlas = Arc::new(TestAtlas::default());
+        let mut animations = ImageSceneAnimations::new(atlas.clone());
+        let source = image(&[100, 100]);
+        let mut tile = animations.paint_tile(source.clone(), 0, 1, true).unwrap();
+        tile.bounds.size = size(DevicePixels(1), DevicePixels(1));
+        animations.finish_draw(&[sprite(tile)]);
+        assert_eq!(animations.stats.live_slots, 1);
+        animations.finish_draw(&[]);
+        assert_eq!(
+            (animations.stats.live_slots, atlas.0.lock().tiles.len()),
+            (0, 0)
+        );
+        assert_eq!(Arc::strong_count(&source), 1);
+    }
+
+    #[test]
+    fn close_releases_tiles_sources_and_publishes_zero_even_if_stats_survive() {
+        let atlas = Arc::new(TestAtlas::default());
+        let source = image(&[100, 100]);
+        let stats = Rc::new(Cell::new(ImageAnimationStats::default()));
+        {
+            let mut animations = ImageSceneAnimations::new(atlas.clone());
+            let capture = stats.clone();
+            animations.observe(move |value| capture.set(value));
+            let tile = animations.paint_tile(source.clone(), 0, 1, true).unwrap();
+            animations.finish_draw(&[sprite(tile)]);
+            assert_eq!(stats.get().live_slots, 1);
+        }
+        assert_eq!(stats.get().live_slots, 0);
+        assert_eq!(
+            (atlas.0.lock().tiles.len(), Arc::strong_count(&source)),
+            (0, 1)
+        );
+    }
+
+    #[test]
+    fn varying_frame_sizes_keep_regular_layout_instead_of_stale_geometry() {
+        let source = Arc::new(RenderImage::new(SmallVec::from_iter([1, 2].map(|width| {
+            Frame::from_parts(
+                RgbaImage::from_pixel(width, 1, Rgba([0, 0, 0, 255])),
+                0,
+                0,
+                Delay::from_numer_denom_ms(100, 1),
+            )
+        }))));
+        let mut animations = ImageSceneAnimations::new(Arc::new(TestAtlas::default()));
+        animations.paint_tile(source, 0, 1, true).unwrap();
+        assert!(
+            animations
+                .advance(Duration::from_millis(100), true)
+                .needs_draw
+        );
+    }
+
+    #[test]
+    fn atlas_relocation_forces_regular_draw_before_presenting() {
+        let atlas = Arc::new(TestAtlas::default());
+        let mut animations = ImageSceneAnimations::new(atlas.clone());
+        animations
+            .paint_tile(image(&[100, 100]), 0, 1, true)
+            .unwrap();
+        atlas.0.lock().relocate = true;
+        let update = animations.advance(Duration::from_millis(100), true);
+        assert!(update.needs_draw);
+        assert_eq!(animations.stats.fallbacks, 1);
+    }
+
+    #[test]
+    fn atlas_reset_forces_regular_draw_before_presenting() {
+        let atlas = Arc::new(TestAtlas::default());
+        let mut animations = ImageSceneAnimations::new(atlas.clone());
+        animations
+            .paint_tile(image(&[100, 100]), 0, 1, true)
+            .unwrap();
+        atlas.0.lock().tiles.clear();
+        assert!(
+            animations
+                .advance(Duration::from_millis(100), true)
+                .needs_draw
+        );
+    }
+
+    #[test]
+    fn mixed_focus_policies_do_not_share_a_mutating_slot() {
+        let mut animations = ImageSceneAnimations::new(Arc::new(TestAtlas::default()));
+        let source = image(&[100, 100]);
+        animations.paint_tile(source.clone(), 0, 1, false).unwrap();
+        animations.paint_tile(source.clone(), 0, 1, true).unwrap();
+        let update = animations.advance(Duration::from_millis(100), false);
+        assert!(update.changed && !update.needs_draw);
+        assert_eq!(animations.frame(source.id, false), Some(0));
+        assert_eq!(animations.frame(source.id, true), Some(1));
+    }
+}
