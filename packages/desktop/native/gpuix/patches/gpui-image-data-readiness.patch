+/// Read the completed built-in decode result for inline image data.
+/// Returns `None` when absent or not yet completed by an existing consumer.
+/// This does not start or poll a decode, load a resource, or schedule a redraw.
+pub fn image_data_if_ready(
+    data: &Arc<Image>,
+    cx: &App,
+) -> Option<Result<Arc<RenderImage>, ImageCacheError>> {
+    let asset_id = (TypeId::of::<AssetLogger<ImageDecoder>>(), crate::hash(data));
+    cx.loading_assets
+        .get(&asset_id)?
+        .downcast_ref::<Shared<Task<Result<Arc<RenderImage>, ImageCacheError>>>>()?
+        .peek()
+        .cloned()
+}
