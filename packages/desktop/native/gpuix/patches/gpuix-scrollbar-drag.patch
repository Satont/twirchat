+/// Starts a thumb drag on a press inside the painted scrollbar and keeps
+/// setting the offset while the pointer moves. Once a drag begins it is
+/// handled in the capture phase, so content under the pointer cannot swallow
+/// the move or release events.
+fn install_scrollbar_interaction(
+    window: &mut gpui::Window,
+    element_id: u64,
+    origin: gpui::Point<gpui::Pixels>,
+    size: gpui::Size<gpui::Pixels>,
+    thumbs: ThumbStyle,
+    scroll: ScrollbarScroll,
+    hits: ScrollbarHits,
+) {
+    if hits.vertical.is_none() && hits.horizontal.is_none() {
+        return;
+    }
+
+    window.on_mouse_event({
+        let scroll = scroll.clone();
+        let hits = hits.clone();
+        move |event: &gpui::MouseDownEvent, phase, window, cx| {
+            if phase != gpui::DispatchPhase::Capture
+                || event.button != gpui::MouseButton::Left
+            {
+                return;
+            }
+            let axis = if hits.vertical.as_ref().is_some_and(|hit| hit.is_hovered(window)) {
+                ScrollbarAxis::Vertical
+            } else if hits
+                .horizontal
+                .as_ref()
+                .is_some_and(|hit| hit.is_hovered(window))
+            {
+                ScrollbarAxis::Horizontal
+            } else {
+                return;
+            };
+            let (max, offset) = scroll.extent();
+            let geometry = scrollbar_geometry(size, max, offset, thumbs);
+            let Some(thumb) = (match axis {
+                ScrollbarAxis::Vertical => geometry.vertical,
+                ScrollbarAxis::Horizontal => geometry.horizontal,
+            }) else {
+                return;
+            };
+            let local = event.position - origin;
+            let pointer = match axis {
+                ScrollbarAxis::Vertical => f32::from(local.y),
+                ScrollbarAxis::Horizontal => f32::from(local.x),
+            };
+            let grab = if thumb.contains(pointer) {
+                pointer - thumb.start
+            } else {
+                thumb.length / 2.0
+            };
+            scroll.begin_drag();
+            if !thumb.contains(pointer) {
+                let target = thumb.offset_for(pointer, grab);
+                scroll.set_offset(scrollbar_offset_point(axis, target, offset));
+                window.refresh();
+            }
+            ACTIVE_SCROLLBAR_DRAG.with(|active| {
+                *active.borrow_mut() = Some(ActiveScrollbarDrag {
+                    element_id,
+                    axis,
+                    grab,
+                });
+            });
+            cx.stop_propagation();
+        }
+    });
+
+    window.on_mouse_event({
+        let scroll = scroll.clone();
+        move |event: &gpui::MouseMoveEvent, phase, window, cx| {
+            let Some(active) = ACTIVE_SCROLLBAR_DRAG.with(|active| active.borrow().clone())
+            else {
+                return;
+            };
+            if active.element_id != element_id
+                || phase != gpui::DispatchPhase::Capture
+            {
+                return;
+            }
+            if !event.dragging() {
+                ACTIVE_SCROLLBAR_DRAG.with(|active| *active.borrow_mut() = None);
+                scroll.end_drag();
+                window.refresh();
+                return;
+            }
+            let (max, offset) = scroll.extent();
+            let geometry = scrollbar_geometry(size, max, offset, thumbs);
+            let Some(thumb) = (match active.axis {
+                ScrollbarAxis::Vertical => geometry.vertical,
+                ScrollbarAxis::Horizontal => geometry.horizontal,
+            }) else {
+                return;
+            };
+            let local = event.position - origin;
+            let pointer = match active.axis {
+                ScrollbarAxis::Vertical => f32::from(local.y),
+                ScrollbarAxis::Horizontal => f32::from(local.x),
+            };
+            let target = thumb.offset_for(pointer, active.grab);
+            let next = scrollbar_offset_point(active.axis, target, offset);
+            if next != offset {
+                scroll.set_offset(next);
+                window.refresh();
+            }
+            cx.stop_propagation();
+        }
+    });
+
+    window.on_mouse_event({
+        let scroll = scroll.clone();
+        move |event: &gpui::MouseUpEvent, phase, window, cx| {
+            if event.button != gpui::MouseButton::Left
+                || phase != gpui::DispatchPhase::Capture
+            {
+                return;
+            }
+            let is_active = ACTIVE_SCROLLBAR_DRAG.with(|active| {
+                let mut active = active.borrow_mut();
+                if active
+                    .as_ref()
+                    .is_some_and(|drag| drag.element_id == element_id)
+                {
+                    *active = None;
+                    true
+                } else {
+                    false
+                }
+            });
+            if !is_active {
+                return;
+            }
+            scroll.end_drag();
+            window.refresh();
+            cx.stop_propagation();
+        }
+    });
+}
