+/// One scrollable surface a thumb can drive: a plain scroll container or a
+/// virtual list, which needs its content height frozen for the drag.
+#[derive(Clone)]
+enum ScrollbarScroll {
+    Element(gpui::ScrollHandle),
+    List(gpui::ListState),
+}
+
+impl ScrollbarScroll {
+    fn extent(&self) -> (gpui::Point<gpui::Pixels>, gpui::Point<gpui::Pixels>) {
+        match self {
+            ScrollbarScroll::Element(handle) => (handle.max_offset(), handle.offset()),
+            ScrollbarScroll::List(state) => list_scroll_extent(state),
+        }
+    }
+
+    fn set_offset(&self, offset: gpui::Point<gpui::Pixels>) {
+        match self {
+            ScrollbarScroll::Element(handle) => handle.set_offset(offset),
+            ScrollbarScroll::List(state) => state.set_offset_from_scrollbar(offset),
+        }
+    }
+
+    fn begin_drag(&self) {
+        if let ScrollbarScroll::List(state) = self {
+            state.scrollbar_drag_started();
+        }
+    }
+
+    fn end_drag(&self) {
+        if let ScrollbarScroll::List(state) = self {
+            state.scrollbar_drag_ended();
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum ScrollbarAxis {
+    Vertical,
+    Horizontal,
+}
+
+#[derive(Clone, Copy)]
+struct ThumbGeometry {
+    /// Distance from the viewport's leading edge to the thumb's start.
+    start: f32,
+    length: f32,
+    /// How far the thumb can travel.
+    travel: f32,
+    /// How far the content can scroll.
+    max_scroll: f32,
+}
+
+impl ThumbGeometry {
+    fn contains(&self, pointer: f32) -> bool {
+        pointer >= self.start && pointer <= self.start + self.length
+    }
+
+    /// Scroll offset that puts the thumb under `pointer`, keeping the point
+    /// inside the thumb where the pointer grabbed it.
+    fn offset_for(&self, pointer: f32, grab: f32) -> f32 {
+        if self.travel <= 0.0 {
+            return 0.0;
+        }
+        let start = (pointer - grab).clamp(0.0, self.travel);
+        -(start / self.travel) * self.max_scroll
+    }
+}
+
+struct ScrollbarGeometry {
+    vertical: Option<ThumbGeometry>,
+    horizontal: Option<ThumbGeometry>,
+}
+
+fn scrollbar_geometry(
+    size: gpui::Size<gpui::Pixels>,
+    max: gpui::Point<gpui::Pixels>,
+    offset: gpui::Point<gpui::Pixels>,
+    thumbs: ThumbStyle,
+) -> ScrollbarGeometry {
+    let (width, height) = (f32::from(size.width), f32::from(size.height));
+    let thumb = |track: f32, max_scroll: gpui::Pixels, offset: gpui::Pixels| {
+        scrollbar_thumb(track, f32::from(max_scroll), f32::from(offset)).map(
+            |(start, length)| ThumbGeometry {
+                start,
+                length,
+                travel: (track - length).max(0.0),
+                max_scroll: f32::from(max_scroll),
+            },
+        )
+    };
+    let mut vertical = thumbs
+        .vertical
+        .then(|| thumb(height, max.y, offset.y))
+        .flatten();
+    let mut horizontal = thumbs
+        .horizontal
+        .then(|| thumb(width, max.x, offset.x))
+        .flatten();
+    if vertical.is_some() && horizontal.is_some() {
+        // Leave the corner to whichever thumb reaches it first.
+        vertical = thumbs
+            .vertical
+            .then(|| thumb(height - thumbs.thickness, max.y, offset.y))
+            .flatten();
+        horizontal = thumbs
+            .horizontal
+            .then(|| thumb(width - thumbs.thickness, max.x, offset.x))
+            .flatten();
+    }
+    ScrollbarGeometry {
+        vertical,
+        horizontal,
+    }
+}
+
+/// Pointer target wider than the painted thumb, so a 5px bar is still easy to
+/// grab without painting a wider bar.
+const SCROLLBAR_HIT_WIDTH: f32 = 10.0;
+
+#[derive(Clone, Default)]
+struct ScrollbarHits {
+    vertical: Option<gpui::Hitbox>,
+    horizontal: Option<gpui::Hitbox>,
+}
+
+fn insert_scrollbar_hits(
+    window: &mut gpui::Window,
+    origin: gpui::Point<gpui::Pixels>,
+    size: gpui::Size<gpui::Pixels>,
+    max: gpui::Point<gpui::Pixels>,
+    offset: gpui::Point<gpui::Pixels>,
+    thumbs: ThumbStyle,
+) -> ScrollbarHits {
+    let geometry = scrollbar_geometry(size, max, offset, thumbs);
+    let (width, height) = (f32::from(size.width), f32::from(size.height));
+    let hit = thumbs.thickness.max(SCROLLBAR_HIT_WIDTH);
+    let vertical = geometry.vertical.map(|_| {
+        let strip = hit.min(width);
+        window.insert_hitbox(
+            gpui::Bounds::new(
+                gpui::point(origin.x + gpui::px(width - strip), origin.y),
+                gpui::size(gpui::px(strip), gpui::px(height)),
+            ),
+            gpui::HitboxBehavior::BlockMouseExceptScroll,
+        )
+    });
+    let horizontal = geometry.horizontal.map(|_| {
+        let strip = hit.min(height);
+        window.insert_hitbox(
+            gpui::Bounds::new(
+                gpui::point(origin.x, origin.y + gpui::px(height - strip)),
+                gpui::size(gpui::px(width), gpui::px(strip)),
+            ),
+            gpui::HitboxBehavior::BlockMouseExceptScroll,
+        )
+    });
+    ScrollbarHits {
+        vertical,
+        horizontal,
+    }
+}
+
+#[derive(Clone)]
+struct ActiveScrollbarDrag {
+    element_id: u64,
+    axis: ScrollbarAxis,
+    grab: f32,
+}
+
+thread_local! {
+    static ACTIVE_SCROLLBAR_DRAG: RefCell<Option<ActiveScrollbarDrag>> = const { RefCell::new(None) };
+}
+
+fn scrollbar_offset_point(
+    axis: ScrollbarAxis,
+    value: f32,
+    current: gpui::Point<gpui::Pixels>,
+) -> gpui::Point<gpui::Pixels> {
+    match axis {
+        ScrollbarAxis::Vertical => gpui::point(current.x, gpui::px(value)),
+        ScrollbarAxis::Horizontal => gpui::point(gpui::px(value), current.y),
+    }
+}
