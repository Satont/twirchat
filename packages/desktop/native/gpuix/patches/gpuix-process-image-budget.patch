+struct PressureSubscription {
+    id: u64,
+    pressure: Arc<AtomicBool>,
+}
+
+impl PressureSubscription {
+    fn new() -> (Self, mpsc::Receiver<()>) {
+        let (mut sender, receiver) = mpsc::channel(0);
+        let subscription = SharedImages::with(|images| {
+            let id = images.next_subscriber;
+            images.next_subscriber += 1;
+            if images.under_pressure() {
+                // The new receiver is live and its single slot is empty.
+                sender.try_send(()).ok();
+            }
+            images.subscribers.insert(id, sender);
+            Self {
+                id,
+                pressure: images.pressure.clone(),
+            }
+        });
+        (subscription, receiver)
+    }
+}
+
+impl Drop for PressureSubscription {
+    fn drop(&mut self) {
+        let sender = SharedImages::with(|images| images.subscribers.remove(&self.id));
+        drop(sender);
+    }
+}
