+/// Native image animation work, read from the last published snapshot.
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[derive(Debug, Clone, Default)]
+#[napi(object)]
+pub struct NativeImageAnimationStats {
+    pub full_draws: f64,
+    pub animation_only_presents: f64,
+    pub slot_uploads: f64,
+    pub live_slots: f64,
+    pub fallbacks: f64,
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+impl From<gpui::ImageAnimationStats> for NativeImageAnimationStats {
+    fn from(stats: gpui::ImageAnimationStats) -> Self {
+        Self {
+            full_draws: stats.full_draws as f64,
+            animation_only_presents: stats.animation_only_presents as f64,
+            slot_uploads: stats.slot_uploads as f64,
+            live_slots: stats.live_slots as f64,
+            fallbacks: stats.fallbacks as f64,
+        }
+    }
+}
+
