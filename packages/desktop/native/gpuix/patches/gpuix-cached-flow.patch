+            entity
+                .cached(StyleRefinement {
+                    size: gpui::SizeRefinement {
+                        width: Some(measured.width.into()),
+                        height: Some(measured.height.into()),
+                    },
+                    min_size: gpui::SizeRefinement {
+                        width: Some(measured.width.into()),
+                        height: Some(measured.height.into()),
+                    },
+                    ..Default::default()
+                })
+                .cache_version(version)
+        } else {
+            entity.into_element()
+        };
+        let capture =
+            ImageUseCapture::new(scope.images.entity_id(), window.window_handle().window_id());
+        // Delegate manually: Drawable<ViewElement> would push the changing Entity ID.
+        let layout = capture.run(|| {
+            Element::request_layout(&mut view, self.cache_id.as_ref(), inspector, window, cx)
+        });
+        self.view = Some(view);
+        self.capture = Some(capture);
+        layout
+    }
+    fn prepaint(
+        &mut self,
+        _id: Option<&GlobalElementId>,
+        inspector: Option<&InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        state: &mut Self::RequestLayoutState,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Self::PrepaintState {
+        if let Some(mut direct) = self.direct.take() {
+            direct.prepaint(window, cx);
+            return Some(direct);
+        }
+        let painted = match (&mut self.view, &self.capture) {
+            (Some(view), Some(capture)) => capture.run(|| {
+                Element::prepaint(
+                    view,
+                    self.cache_id.as_ref(),
+                    inspector,
+                    bounds,
+                    state,
+                    window,
+                    cx,
+                )
+            }),
+            _ => None,
+        };
+        {
+            let (scope, entry) = (&self.scope, &self.entry);
+            let state = entry.borrow();
+            if let Some(overlay) = state.source.overlay {
+                let mut build = state.entity.read(cx).build.clone();
+                build.part = FlowPart::Overlay {
+                    id: overlay.id,
+                    height: bounds.size.height,
+                };
+                drop(state);
+                let mut element = scope
+                    .root
+                    .update(cx, |root, cx| root.build_flow_body(&build, window, cx))
+                    .unwrap_or_else(|_| gpui::Empty.into_any_element());
+                // Re-enter only the original body div's namespace; no cache ID reaches children.
+                window.with_id(crate::renderer::host_element_id(self.body), |window| {
+                    let size = element.layout_as_root(
+                        Size {
+                            width: AvailableSpace::MaxContent,
+                            height: AvailableSpace::Definite(bounds.size.height),
+                        },
+                        window,
+                        cx,
+                    );
+                    element.prepaint_at(
+                        gpui::point(
+                            bounds.right() - px(overlay.right as f32) - size.width,
+                            bounds.top(),
+                        ),
+                        window,
+                        cx,
+                    );
+                });
+                self.overlay = Some(element);
+            }
+        }
+        painted
+    }
+    fn paint(
+        &mut self,
+        _id: Option<&GlobalElementId>,
+        inspector: Option<&InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        state: &mut Self::RequestLayoutState,
+        painted: &mut Self::PrepaintState,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let Some(view) = self.view.as_mut() else {
+            if let Some(direct) = painted {
+                direct.paint(window, cx);
+            }
+            return;
+        };
+        let Some(capture) = &self.capture else {
+            return;
+        };
+        let window_id = window.window_handle().window_id();
+        let marker = text_paint_marker(window_id);
+        capture.run(|| {
+            Element::paint(
+                view,
+                self.cache_id.as_ref(),
+                inspector,
+                bounds,
+                state,
+                painted,
+                window,
+                cx,
+            )
+        });
+        // Only inline paint contributes to the reusable native effects and resource lease.
+        self.finish_snapshot(bounds, painted.is_some(), marker, window, cx);
+        if let Some(overlay) = self.overlay.as_mut() {
+            window.with_id(crate::renderer::host_element_id(self.body), |window| {
+                overlay.paint(window, cx)
+            });
+        }
+    }
+}
+
+impl FlowElement {
+    fn finish_snapshot(
+        &self,
+        bounds: Bounds<Pixels>,
+        fresh: bool,
+        marker: crate::text::paint::TextPaintMarker,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let (scope, entry) = (&self.scope, &self.entry);
+        let Some(capture) = &self.capture else {
+            return;
+        };
+        let window_id = window.window_handle().window_id();
+        let cache = scope.cache.borrow();
+        if !self.valid || !cache.enabled || cache.epoch != self.epoch {
+            return;
+        }
+        if fresh {
+            let Some(images) = capture.finish(cx) else {
+                entry.borrow_mut().snapshot = None;
+                return;
+            };
+            if !scope.images.read(cx).uses_current(&images) {
+                return;
+            }
+            let nodes = entry
+                .borrow()
+                .ids
+                .iter()
+                .filter_map(|id| automation::get_bounds(window_id, *id).map(|bounds| (*id, bounds)))
+                .collect();
+            let snapshot = Snapshot {
+                bounds,
+                text: text_paint_effects(window_id, marker),
+                nodes,
+                images,
+            };
+            let mut entry = entry.borrow_mut();
+            entry.snapshot = Some(snapshot);
+            entry.painted = self.epoch;
+        } else {
+            let mut entry = entry.borrow_mut();
+            if let Some(snapshot) = &entry.snapshot {
+                // Scene replay alone does not restore native selection/locator registries.
+                snapshot.text.replay(window_id);
+                automation::replay_bounds(window_id, &snapshot.nodes);
+                scope.images.update(cx, |images, _| {
+                    images.touch_uses(&snapshot.images);
+                });
+                scope.words.borrow_mut().touch_existing(&entry.ids);
+                entry.painted = self.epoch;
+            }
+        }
+    }
+}
