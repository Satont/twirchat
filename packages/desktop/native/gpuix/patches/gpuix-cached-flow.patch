+pub(crate) struct ImageUseCapture {
+    owner: gpui::EntityId,
+    window: gpui::WindowId,
+    managed: Rc<RefCell<ManagedCapture>>,
+    data: Rc<RefCell<Vec<CapturedDataImage>>>,
+}
+
+#[derive(Default)]
+struct ManagedCapture {
+    stamp: u64,
+    uses: HashMap<Resource, (Option<u64>, u64)>,
+}
+
+impl ManagedCapture {
+    fn record(&mut self, resource: &Resource, load: Option<u64>) {
+        self.stamp += 1;
+        // Later completion cannot upgrade a capture that saw a placeholder.
+        let load = match self.uses.get(resource) {
+            Some((previous, _)) if previous.is_none() || *previous != load => None,
+            _ => load,
+        };
+        self.uses.insert(resource.clone(), (load, self.stamp));
+    }
+    fn snapshot(&self) -> Option<Vec<(Resource, u64)>> {
+        let mut ordered = self
+            .uses
+            .iter()
+            .map(|(resource, (load, stamp))| Some((*stamp, resource.clone(), (*load)?)))
+            .collect::<Option<Vec<_>>>()?;
+        ordered.sort_by_key(|(stamp, _, _)| *stamp);
+        Some(
+            ordered
+                .into_iter()
+                .map(|(_, resource, load)| (resource, load))
+                .collect(),
+        )
+    }
+}
