+pub(crate) struct ImageUses {
+    owner: gpui::EntityId,
+    managed: Vec<(Resource, u64)>,
+    data: Vec<(Arc<gpui::Image>, Arc<RenderImage>)>,
+}
+
+thread_local! {
+    static IMAGE_USE_CAPTURE: RefCell<Option<ImageUseCapture>> = const { RefCell::new(None) };
+}
+
+struct RestoreCapture(Option<ImageUseCapture>);
+impl Drop for RestoreCapture {
+    fn drop(&mut self) {
+        IMAGE_USE_CAPTURE.with(|active| *active.borrow_mut() = self.0.take());
+    }
+}
+
+impl ImageUseCapture {
+    pub(crate) fn new(owner: gpui::EntityId, window: gpui::WindowId) -> Self {
+        Self {
+            owner,
+            window,
+            managed: Default::default(),
+            data: Default::default(),
+        }
+    }
+
+    pub(crate) fn run<R>(&self, action: impl FnOnce() -> R) -> R {
+        let previous = IMAGE_USE_CAPTURE.with(|active| active.replace(Some(self.clone())));
+        let _restore = RestoreCapture(previous);
+        action()
