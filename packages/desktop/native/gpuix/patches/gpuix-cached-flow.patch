+
+fn split_overlay(tree: &RetainedTree, body: &RetainedElement) -> Option<Overlay> {
+    if !body.events().is_empty()
+        || !body.custom_props().is_empty()
+        || body.needs_focus()
+        || body.content.is_some()
+    {
+        return None;
+    }
+    let mut overlay = None;
+    for id in &body.children {
+        let node = tree.elements.get(id)?;
+        let Some(style) = node
+            .style
+            .as_deref()
+            .filter(|s| s.position.as_deref() == Some("absolute"))
+        else {
+            continue;
+        };
+        if overlay.is_some()
+            || node.element_type != "div"
+            || style.top != Some(0.)
+            || style.bottom != Some(0.)
+            || !style
+                .right
+                .is_some_and(|right| right.is_finite() && right >= 0.)
+            || style.display.as_deref() != Some("flex")
+            || style.flex_direction.as_deref() != Some("row")
+            || style.align_items.as_deref() != Some("center")
+        {
+            return None;
+        }
+        let mut remaining = style.clone();
+        remaining.position = None;
+        remaining.top = None;
+        remaining.bottom = None;
+        remaining.right = None;
+        remaining.display = None;
+        remaining.flex_direction = None;
+        remaining.align_items = None;
+        if !remaining.gap.is_none_or(|gap| gap.is_finite() && gap >= 0.) {
+            return None;
+        }
+        remaining.gap = None;
+        if remaining.user_select.as_deref() == Some("none") {
+            remaining.user_select = None;
+        }
+        if remaining.width == Some(DimensionValue::Auto) {
+            remaining.width = None;
+        }
+        if remaining.height == Some(DimensionValue::Auto) {
+            remaining.height = None;
+        }
+        if remaining != StyleDesc::default() {
+            return None;
+        }
+        overlay = Some(Overlay {
+            id: *id,
+            right: style.right?,
+        });
+    }
+    overlay
+}
+
+fn content_revision(tree: &RetainedTree, body: &RetainedElement, overlay: Option<Overlay>) -> u64 {
+    match overlay {
+        None => body.subtree_revision,
+        Some(overlay) => body
+            .children
+            .iter()
+            .filter(|id| **id != overlay.id)
+            .filter_map(|id| tree.elements.get(id).map(|child| child.subtree_revision))
+            .max()
+            .unwrap_or(0),
+    }
+}
+
+fn inline_ids(tree: &RetainedTree, ids: Arc<[u64]>, overlay: Option<Overlay>) -> Arc<[u64]> {
+    let Some(overlay) = overlay else { return ids };
+    let mut excluded = FxHashSet::default();
+    let mut pending = vec![overlay.id];
+    while let Some(id) = pending.pop() {
+        excluded.insert(id);
+        if let Some(node) = tree.elements.get(&id) {
+            pending.extend(node.children.iter().copied());
+        }
+    }
+    ids.iter()
+        .copied()
+        .filter(|id| !excluded.contains(id))
+        .collect()
+}
+
+pub(crate) fn candidate(element: &RetainedElement) -> bool {
+    if element.element_type != "div" {
+        return false;
+    }
+    let Some(style) = element.style.as_deref() else {
+        return false;
+    };
+    if style.display.as_deref() != Some("flex")
+        || style.flex_direction.as_deref() != Some("row")
+        || style.flex_wrap.as_deref() != Some("wrap")
+        || style.align_items.as_deref() != Some("center")
+    {
+        return false;
+    }
+    true
+}
+
+fn compact_geometry(tree: &RetainedTree, element: &RetainedElement, row: u64) -> bool {
+    let Some(style) = element.style.as_deref() else {
+        return false;
+    };
+    let mut rest = style.clone();
+    rest.display = None;
+    rest.flex_direction = None;
+    rest.flex_wrap = None;
+    rest.align_items = None;
+    rest.gap = None;
+    rest.row_gap = None;
+    rest.column_gap = None;
+    if matches!(rest.min_width, Some(DimensionValue::Pixels(0.))) {
+        rest.min_width = None;
+    }
+    if rest != StyleDesc::default() {
+        return false;
+    }
+    let Some(parent) = element.parent.and_then(|id| tree.elements.get(&id)) else {
+        return false;
+    };
+    if parent
+        .style
+        .as_deref()
+        .and_then(|s| s.flex_direction.as_deref())
+        != Some("column")
+    {
+        return false;
+    }
+    let mut node = Some(parent);
+    while let Some(ancestor) = node {
+        if let Some(style) = ancestor.style.as_deref() {
+            if style.height.is_some()
+                || style.max_height.is_some()
+                || style.align_items.as_deref().is_some_and(|a| a != "stretch")
+                || (style.flex_direction.as_deref() != Some("column")
+                    && ancestor.children.len() > 1)
+            {
+                return false;
+            }
+        }
+        if ancestor.id == row {
+            return true;
+        }
+        node = ancestor.parent.and_then(|id| tree.elements.get(&id));
+    }
+    false
+}
+
+fn eligible_ids(tree: &RetainedTree, body: u64, row: u64) -> Option<Arc<[u64]>> {
+    if !compact_geometry(tree, tree.elements.get(&body)?, row) {
+        return None;
+    }
+    let mut outside = vec![row];
+    let mut visited = 0;
+    while let Some(id) = outside.pop() {
+        if id == body {
+            continue;
+        }
+        if visited >= MAX_NODES {
+            return None;
+        }
+        visited += 1;
+        let node = tree.elements.get(&id)?;
+        if !matches!(node.element_type.as_str(), "div" | "text" | "img" | "svg")
+            || node.custom_props().contains_key("motion")
+        {
+            return None;
+        }
+        if matches!(node.element_type.as_str(), "img" | "svg")
+            && !node.style.as_deref().is_some_and(|s| {
+                matches!(s.width, Some(DimensionValue::Pixels(w)) if w > 0.)
+                    && matches!(s.height, Some(DimensionValue::Pixels(h)) if h > 0.)
+            })
+        {
+            return None;
+        }
+        if visited + outside.len() + node.children.len() > MAX_NODES {
+            return None;
+        }
+        outside.extend(node.children.iter().copied());
+    }
+    let mut ids = Vec::new();
+    let mut pending = vec![body];
+    while let Some(id) = pending.pop() {
+        let node = tree.elements.get(&id)?;
+        if visited + ids.len() >= MAX_NODES
+            || !matches!(node.element_type.as_str(), "div" | "text" | "img" | "svg")
+            || node.events().contains("scrollChange")
+            || node.events().contains("highlight")
+            || node.style.as_deref().is_some_and(|s| {
+                s.has_dynamic_opacity()
+                    || [
+                        s.overflow.as_deref(),
+                        s.overflow_x.as_deref(),
+                        s.overflow_y.as_deref(),
+                    ]
+                    .contains(&Some("scroll"))
+            })
+            || node.custom_props().keys().any(|key| {
+                !(key == "tabIndex"
+                    || key == "role"
+                    || key.starts_with("aria")
+                    || (node.element_type == "img"
+                        && matches!(key.as_str(), "src" | "objectFit" | "alt"))
+                    || (node.element_type == "svg" && matches!(key.as_str(), "src" | "source")))
+            })
+        {
+            return None;
+        }
+        ids.push(id);
+        if visited + ids.len() + pending.len() + node.children.len() > MAX_NODES {
+            return None;
+        }
+        pending.extend(node.children.iter().copied());
+    }
+    Some(ids.into())
+}
+
+impl FlowScope {
+    pub(crate) fn prepare(
+        &self,
+        tree: &RetainedTree,
+        body: u64,
+        inherited: &Inherited,
+        window: &Window,
+        cx: &mut gpui::Context<GpuixView>,
+    ) -> Option<FlowElement> {
+        if !inherited.text_cache_safe
+            || inherited.highlight.is_some()
+            || !cacheable_space(self.available)
+        {
+            return None;
+        }
+        let mut cache = self.cache.borrow_mut();
+        if !cache.enabled {
+            return None;
+        }
+        let generation = cache.frame.as_ref()?.generation;
+        if tree.cache_revision() != Some(generation) {
+            cache.clear();
+            return None;
+        }
+        let node = tree.elements.get(&body)?;
+        let existing = cache.entries.get(&body).cloned();
+        let unchanged = existing.as_ref().filter(|entry| {
+            let previous = entry.borrow();
+            previous.observed == node.subtree_revision
+                && previous.source.row == self.row
+                && previous.source.list == self.list
+        });
+        let (ids, overlay, revision) = if let Some(entry) = unchanged {
+            let previous = entry.borrow();
+            (
+                previous.ids.clone(),
+                previous.source.overlay,
+                previous.source.revision,
+            )
+        } else {
+            let ids = eligible_ids(tree, body, self.row)?;
+            let overlay = split_overlay(tree, node);
+            (
+                inline_ids(tree, ids, overlay),
+                overlay,
+                content_revision(tree, node, overlay),
+            )
+        };
+        let source = Source {
+            generation,
+            body,
+            row: self.row,
+            list: self.list,
+            revision,
+            style: node.style.clone(),
+            overlay,
+            available: self.available,
+            selectable: inherited.selectable,
+            wash: inherited.selection_wash,
+        };
+        let epoch = cache.epoch;
+        let entry = if let Some(entry) = existing {
+            if entry.borrow().source != source {
+                let version = cache.version()?;
+                let mut state = entry.borrow_mut();
+                state.source = source;
+                state.version = version;
+                state.snapshot = None;
+                state.ids = ids;
+            }
+            entry.borrow_mut().observed = node.subtree_revision;
+            entry.borrow().entity.update(cx, |view, _| {
+                view.build = FlowBuild {
+                    body,
+                    list: self.list,
+                    row: self.row,
+                    inherited: inherited.clone(),
+                    part: FlowPart::Body {
+                        overlay: overlay.map(|overlay| overlay.id),
+                        width: None,
+                    },
+                };
+            });
+            entry
+        } else {
+            if cache.entries.len() >= MAX_FLOWS
+                || automation::get_bounds(window.window_handle().window_id(), body).is_none()
+            {
+                return None;
+            }
+            let version = cache.version()?;
+            let entity = cx.new(|_| FlowView {
+                root: self.root.clone(),
+                build: FlowBuild {
+                    body,
+                    list: self.list,
+                    row: self.row,
+                    inherited: inherited.clone(),
+                    part: FlowPart::Body {
+                        overlay: overlay.map(|overlay| overlay.id),
+                        width: None,
+                    },
+                },
+            });
+            let entry = Rc::new(RefCell::new(FlowEntry {
+                source,
+                ids,
+                observed: node.subtree_revision,
+                entity,
+                version,
+                painted: 0,
+                snapshot: None,
+            }));
+            cache.entries.insert(body, entry.clone());
+            entry
+        };
+        Some(FlowElement {
+            body,
+            scope: self.clone(),
+            entry,
+            epoch,
+            direct: None,
+            view: None,
+            capture: None,
+            valid: false,
+            cache_id: None,
+            overlay: None,
+        })
+    }
+}
