+
+impl Flows {
+    pub(crate) fn clear(&mut self) {
+        self.entries.clear();
+        self.enabled = false;
+    }
+    fn version(&mut self) -> Option<u64> {
+        match self.token.checked_add(1) {
+            Some(token) => {
+                self.token = token;
+                Some(token)
+            }
+            None => {
+                self.clear();
+                None
+            }
+        }
+    }
+    pub(crate) fn begin(
+        &mut self,
+        kind: Invalidation,
+        tree: &RetainedTree,
+        selection: u64,
+        safe: bool,
+        window: &Window,
+        cx: &App,
+    ) {
+        self.epoch = self.epoch.wrapping_add(1);
+        let frame = tree.cache_revision().map(|generation| Frame {
+            generation,
+            selection,
+            focus: window.focused(cx).map(|f| f.id()),
+            keyboard: window.last_input_was_keyboard(),
+            viewport: window.viewport_size(),
+            scale: window.scale_factor(),
+            rem: window.rem_size(),
+        });
+        self.enabled = safe && kind != Invalidation::Full && frame.is_some() && frame == self.frame;
+        if !self.enabled {
+            self.entries.clear();
+        }
+        self.frame = frame;
+    }
+    pub(crate) fn finish(cache: SharedFlows) -> AnyElement {
+        use gpui::prelude::*;
+        let epoch = cache.borrow().epoch;
+        canvas(
+            |_, _, _| (),
+            move |_, _, _, _| {
+                let mut cache = cache.borrow_mut();
+                if cache.epoch == epoch {
+                    cache
+                        .entries
+                        .retain(|_, entry| entry.borrow().painted.saturating_add(1) >= epoch);
+                }
+            },
+        )
+        .absolute()
+        .w(px(0.))
+        .h(px(0.))
+        .into_any_element()
+    }
