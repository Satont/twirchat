+pub(crate) struct FlowElement {
+    body: u64,
+    scope: FlowScope,
+    entry: Rc<RefCell<FlowEntry>>,
+    epoch: u64,
+    direct: Option<AnyElement>,
+    view: Option<ViewElement<Entity<FlowView>>>,
+    capture: Option<ImageUseCapture>,
+    valid: bool,
+    cache_id: Option<GlobalElementId>,
+    overlay: Option<AnyElement>,
+}
