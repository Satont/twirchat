     #[gpui::test]
+    fn test_visible_range_after_initial_layout_programmatic_scroll_and_resize(
+        cx: &mut TestAppContext,
+    ) {
+        let cx = cx.add_empty_window();
+        let state = ListState::new(100, crate::ListAlignment::Top, px(20.))
+            .with_uniform_item_height(px(20.));
+        assert_eq!(state.visible_range(), None);
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(45.)), |_, cx| {
+            cx.new(|_| TestListView(state.clone())).into_any_element()
+        });
+        assert_eq!(state.visible_range(), Some(0..3));
+
+        state.scroll_to(gpui::ListOffset {
+            item_ix: 40,
+            offset_in_item: px(0.),
+        });
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(45.)), |_, cx| {
+            cx.new(|_| TestListView(state.clone())).into_any_element()
+        });
+        assert_eq!(state.visible_range(), Some(40..43));
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(85.)), |_, cx| {
+            cx.new(|_| TestListView(state.clone())).into_any_element()
+        });
+        assert_eq!(state.visible_range(), Some(40..45));
+    }
