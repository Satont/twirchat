+    /// The visible item range from the last prepaint. Returns `None` before layout.
+    pub fn visible_range(&self) -> Option<Range<usize>> {
+        let state = self.0.borrow();
+        let bounds = state.last_layout_bounds?;
+        let range = StateInner::visible_range(
+            &state.items,
+            bounds.size.height,
+            &state.last_layout_scroll_top,
+        );
+        let count = state.items.summary().count;
+        Some(range.start.min(count)..range.end.min(count))
+    }
