+    #[gpui::test]
+    fn cached_element_primes_then_reuses_scene_listeners_and_child_ids(cx: &mut TestAppContext) {
+        let (window, counts) = setup(cx);
+        assert_eq!(counts.builds.get(), 1);
+        draw(cx, window);
+        assert_eq!(counts.builds.get(), 2);
+        let quads = cx
+            .update_window(window.into(), |_, window, _| {
+                window.rendered_frame.scene.quads.len()
+            })
+            .unwrap();
+
+        draw(cx, window);
+        draw(cx, window);
+        assert_eq!(counts.builds.get(), 2);
+        assert_eq!(counts.paints.get(), 2);
+        assert_eq!(counts.reuses.get(), 2);
+        cx.update_window(window.into(), |_, window, cx| {
+            assert_eq!(window.rendered_frame.scene.quads.len(), quads);
+            window.simulate_mouse_move(point(px(10.), px(10.)), cx);
+        })
+        .unwrap();
+        assert_eq!(counts.mouse_moves.get(), 1);
+        let ids = counts.child_ids.borrow();
+        assert!(ids.windows(2).all(|pair| pair[0] == pair[1]));
+        assert!(ids.iter().all(|id| !id.to_string().contains("paint-cache")));
+    }
