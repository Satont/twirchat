+use std::{cell::RefCell, ops::Range, rc::Rc};
+
+use collections::FxHashSet;
+
+use crate::{
+    AnyElement, App, Bounds, ContentMask, Element, ElementId, Empty, EntityId, GlobalElementId,
+    InspectorElementId, IntoElement, LayoutId, PaintIndex, Pixels, PrepaintStateIndex, Size, Style,
+    TextStyle, Window,
+};
+
+/// Reuse an intrinsic, default-box element while its retained data revision is unchanged.
+///
+/// The caller must advance `revision` for every change affecting the built subtree, including
+/// external state. This is for retained leaves with constraint-independent intrinsic sizing
+/// and a default layout box, not arbitrary responsive containers. The child keeps its original element ID path. On a cache hit,
+/// `on_reuse` must replay any application-owned paint effects not recorded by GPUI.
+///
+/// A cold draw learns the size. The next matching draw records layout and prepaint together;
+/// later draws can reuse those ranges. Refreshes, inspector picking and active accessibility
+/// always use ordinary child painting.
+pub fn cached_element<F, R>(
+    id: ElementId,
+    revision: u64,
+    build: F,
+    on_reuse: R,
+) -> CachedElement<F, R>
+where
+    F: FnOnce(&mut Window, &mut App) -> AnyElement + 'static,
+    R: FnOnce(&mut Window, &mut App) + 'static,
+{
+    CachedElement {
+        id,
+        revision,
+        build: Some(build),
+        on_reuse: Some(on_reuse),
+        state: None,
+        measure_context: None,
+    }
+}
+
+/// An explicitly versioned, ID-transparent retained leaf cache.
+pub struct CachedElement<F, R> {
+    id: ElementId,
+    revision: u64,
+    build: Option<F>,
+    on_reuse: Option<R>,
+    state: Option<Rc<RefCell<CacheState>>>,
+    measure_context: Option<MeasureContext>,
+}
+
+#[derive(Clone, PartialEq)]
+struct MeasureContext {
+    revision: u64,
+    viewport: Size<Pixels>,
+    scale: f32,
+    rem: Pixels,
+    text_style: TextStyle,
+}
+
+impl MeasureContext {
+    fn new(revision: u64, window: &Window) -> Self {
+        Self {
+            revision,
+            viewport: window.viewport_size(),
+            scale: window.scale_factor(),
+            rem: window.rem_size(),
+            text_style: window.text_style(),
+        }
+    }
+}
+
+#[derive(Default)]
+struct CacheState {
+    measurement: Option<(MeasureContext, Size<Pixels>)>,
+    recorded: Option<RecordedElement>,
+}
+
+struct RecordedElement {
+    bounds: Bounds<Pixels>,
+    content_mask: ContentMask<Pixels>,
+    text_style: TextStyle,
+    prepaint_range: Range<PrepaintStateIndex>,
+    paint_range: Option<Range<PaintIndex>>,
+    accessed_entities: FxHashSet<EntityId>,
+}
+
+impl<F, R> CachedElement<F, R>
+where
+    F: FnOnce(&mut Window, &mut App) -> AnyElement + 'static,
+    R: FnOnce(&mut Window, &mut App) + 'static,
+{
+    fn build(&mut self, window: &mut Window, cx: &mut App) -> AnyElement {
+        match self.build.take() {
+            Some(build) => build(window, cx),
+            None => Empty.into_any_element(),
+        }
+    }
+
+    fn can_reuse(window: &Window, cx: &App) -> bool {
+        !window.refreshing && !window.is_a11y_active() && !window.is_inspector_picking(cx)
+    }
+}
+
+impl<F, R> IntoElement for CachedElement<F, R>
+where
+    F: FnOnce(&mut Window, &mut App) -> AnyElement + 'static,
+    R: FnOnce(&mut Window, &mut App) + 'static,
+{
+    type Element = Self;
+
+    fn into_element(self) -> Self::Element {
+        self
+    }
+}
+
+impl<F, R> Element for CachedElement<F, R>
+where
+    F: FnOnce(&mut Window, &mut App) -> AnyElement + 'static,
+    R: FnOnce(&mut Window, &mut App) + 'static,
+{
+    type RequestLayoutState = Option<AnyElement>;
+    type PrepaintState = Option<AnyElement>;
+
+    fn id(&self) -> Option<ElementId> {
+        None
+    }
+
+    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        _id: Option<&GlobalElementId>,
+        _inspector_id: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, Self::RequestLayoutState) {
+        let state = window.with_global_id(self.id.clone(), |id, window| {
+            window.with_element_state(id, |state: Option<Rc<RefCell<CacheState>>>, _| {
+                let state = state.unwrap_or_default();
+                (state.clone(), state)
+            })
+        });
+        let context = MeasureContext::new(self.revision, window);
+        let measured = state
+            .borrow()
+            .measurement
+            .as_ref()
+            .filter(|(previous, size)| {
+                *previous == context && size.width > Pixels::ZERO && size.height > Pixels::ZERO
+            })
+            .map(|(_, size)| *size);
+        self.measure_context = Some(context);
+        self.state = Some(state);
+
+        if let Some(size) = measured.filter(|_| Self::can_reuse(window, cx)) {
+            return (
+                window.request_measured_layout(Style::default(), move |_, _, _, _| size),
+                None,
+            );
+        }
+
+        let mut element = self.build(window, cx);
+        let layout = element.request_layout(window, cx);
+        (layout, Some(element))
+    }
+
+    fn prepaint(
+        &mut self,
+        _id: Option<&GlobalElementId>,
+        _inspector_id: Option<&InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        element: &mut Self::RequestLayoutState,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Self::PrepaintState {
+        let Some(state) = self.state.clone() else {
+            if let Some(element) = element {
+                element.prepaint(window, cx);
+            }
+            return element.take();
+        };
+        let context = self
+            .measure_context
+            .clone()
+            .unwrap_or_else(|| MeasureContext::new(self.revision, window));
+
+        if let Some(mut element) = element.take() {
+            element.prepaint(window, cx);
+            let mut state = state.borrow_mut();
+            state.measurement = Some((context, bounds.size));
+            state.recorded = None;
+            return Some(element);
+        }
+
+        if Self::can_reuse(window, cx) {
+            let mut state = state.borrow_mut();
+            if let Some(recorded) = state.recorded.as_mut()
+                && recorded.bounds == bounds
+                && recorded.content_mask == window.content_mask()
+                && recorded.text_style == window.text_style()
+                && recorded.paint_range.is_some()
+            {
+                let start = window.prepaint_index();
+                window.reuse_prepaint(recorded.prepaint_range.clone());
+                cx.entities.extend_accessed(&recorded.accessed_entities);
+                recorded.prepaint_range = start..window.prepaint_index();
+                return None;
+            }
+        }
+
+        let content_mask = window.content_mask();
+        let text_style = window.text_style();
+        let start = window.prepaint_index();
+        let refreshing = std::mem::replace(&mut window.refreshing, true);
+        let (element, accessed_entities) = cx.detect_accessed_entities(|cx| {
+            let mut element = self.build(window, cx);
+            element.layout_as_root(bounds.size.into(), window, cx);
+            element.prepaint_at(bounds.origin, window, cx);
+            element
+        });
+        window.refreshing = refreshing;
+        let mut state = state.borrow_mut();
+        state.measurement = Some((context, bounds.size));
+        state.recorded = Some(RecordedElement {
+            bounds,
+            content_mask,
+            text_style,
+            prepaint_range: start..window.prepaint_index(),
+            paint_range: None,
+            accessed_entities,
+        });
+        Some(element)
+    }
+
+    fn paint(
+        &mut self,
+        _id: Option<&GlobalElementId>,
+        _inspector_id: Option<&InspectorElementId>,
+        _bounds: Bounds<Pixels>,
+        _request_layout: &mut Self::RequestLayoutState,
+        element: &mut Self::PrepaintState,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let start = window.paint_index();
+        if let Some(element) = element {
+            element.paint(window, cx);
+        } else if let Some(state) = &self.state {
+            let range = state
+                .borrow()
+                .recorded
+                .as_ref()
+                .and_then(|recorded| recorded.paint_range.clone());
+            if let Some(range) = range {
+                window.reuse_paint(range);
+                if let Some(on_reuse) = self.on_reuse.take() {
+                    on_reuse(window, cx);
+                }
+            }
+        }
+        if let Some(state) = &self.state
+            && let Some(recorded) = state.borrow_mut().recorded.as_mut()
+        {
+            recorded.paint_range = Some(start..window.paint_index());
+        }
+    }
+}
