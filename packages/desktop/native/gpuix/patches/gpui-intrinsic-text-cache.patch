+    struct WrappingTextView {
+        nowrap: bool,
+        bounds: Rc<RefCell<Vec<Bounds<Pixels>>>>,
+        reuses: Rc<Cell<usize>>,
+        width: Pixels,
+        cached: bool,
+    }
+
+    impl Render for WrappingTextView {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            let cached = self.cached;
+            let nowrap = self.nowrap;
+            let bounds = self.bounds.clone();
+            let reuses = self.reuses.clone();
+            div()
+                .flex()
+                .flex_wrap()
+                .w(self.width)
+                .text_size(px(17.))
+                .children(
+                    [
+                        "Hello ",
+                        "abcdefghijklmnopqrstuvwxyzAB ",
+                        "longerword ",
+                        "several separated words for wrapping ",
+                        "βета ",
+                        "🌍 ",
+                        "tail ",
+                    ]
+                    .into_iter()
+                    .enumerate()
+                    .map(move |(index, word)| {
+                        let build = move || {
+                            let host = div().child(crate::StyledText::new(word));
+                            if nowrap {
+                                host.whitespace_nowrap()
+                            } else {
+                                host
+                            }
+                        };
+                        let child = if cached {
+                            let reuses = reuses.clone();
+                            cached_element(
+                                ("word", index).into(),
+                                1,
+                                move |_, _| build().into_any_element(),
+                                move |_, _| reuses.set(reuses.get() + 1),
+                            )
+                            .into_any_element()
+                        } else {
+                            build().into_any_element()
+                        };
+                        BoundsProbe {
+                            child,
+                            bounds: bounds.clone(),
+                        }
+                    }),
+                )
+        }
+    }
+
+    #[gpui::test]
+    fn cached_element_preserves_wrapping_text_geometry_at_fractional_scale(
+        cx: &mut TestAppContext,
+    ) {
+        let bounds = Rc::new(RefCell::new(Vec::new()));
+        let reuses = Rc::new(Cell::new(0));
+        let window = cx.add_window({
+            let bounds = bounds.clone();
+            let reuses = reuses.clone();
+            move |_, _| WrappingTextView {
+                nowrap: false,
+                bounds,
+                reuses,
+                width: px(180.),
+                cached: false,
+            }
+        });
+        for nowrap in [false, true] {
+            for scale in [1., 1.5] {
+                for width in [px(180.), px(500.)] {
+                    window
+                        .update(cx, |view, window, _| {
+                            view.cached = false;
+                            view.nowrap = nowrap;
+                            view.width = width;
+                            window.set_scale_factor(scale);
+                        })
+                        .unwrap();
+                    bounds.borrow_mut().clear();
+                    cx.update_window(window.into(), |_, window, cx| window.draw(cx).clear(cx))
+                        .unwrap();
+                    let expected = bounds.borrow().clone();
+                    assert_eq!(expected.len(), 7);
+                    assert!(
+                        expected
+                            .iter()
+                            .all(|bounds| bounds.size.width > Pixels::ZERO)
+                    );
+                    window.update(cx, |view, _, _| view.cached = true).unwrap();
+                    let previous_reuses = reuses.get();
+                    for _ in 0..4 {
+                        bounds.borrow_mut().clear();
+                        cx.update_window(window.into(), |_, window, cx| window.draw(cx).clear(cx))
+                            .unwrap();
+                        assert_eq!(
+                            *bounds.borrow(),
+                            expected,
+                            "cached text moved at scale {scale}, width {width:?}, nowrap {nowrap}"
+                        );
+                    }
+                    assert!(reuses.get() > previous_reuses);
+                }
+            }
+        }
+    }
+}
