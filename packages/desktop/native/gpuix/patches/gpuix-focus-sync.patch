+#[cfg(test)]
+mod focus_revision_tests {
+    use super::RetainedTree;
+    use crate::style::StyleDesc;
+    use std::sync::Arc;
+
+    fn revision(tree: &RetainedTree) -> u64 {
+        tree.focus_revision().unwrap()
+    }
+
+    #[test]
+    fn ordinary_node_churn_does_not_require_focus_reconciliation() {
+        let mut tree = RetainedTree::new();
+        let before = revision(&tree);
+        tree.create_element(1, "div".into());
+        tree.create_element(2, "text".into());
+        tree.append_child(1, 2);
+        tree.create_element(2, "div".into());
+        tree.destroy_element(2);
+        tree.destroy_element(1);
+        assert_eq!(revision(&tree), before);
+    }
+
+    #[test]
+    fn creating_and_replacing_focusable_nodes_advances_the_revision() {
+        let mut tree = RetainedTree::new();
+        let mut before = revision(&tree);
+        for kind in ["input", "input", "textarea", "div"] {
+            tree.create_element(1, kind.into());
+            assert_eq!(revision(&tree), before + 1);
+            before = revision(&tree);
+        }
+        assert!(tree.focusable_ids.is_empty());
+    }
+
+    #[test]
+    fn subtree_removal_retires_focusable_ids_but_missing_removals_do_not() {
+        let mut tree = RetainedTree::new();
+        for (id, kind) in [(1, "div"), (2, "input"), (3, "div"), (4, "textarea")] {
+            tree.create_element(id, kind.into());
+        }
+        for (parent, child) in [(1, 2), (1, 3), (3, 4)] {
+            tree.append_child(parent, child);
+        }
+        let before = revision(&tree);
+        tree.destroy_element(3);
+        assert_eq!(revision(&tree), before + 1);
+        assert_eq!(tree.focusable_ids.iter().copied().collect::<Vec<_>>(), [2]);
+        tree.destroy_element(1);
+        assert_eq!(revision(&tree), before + 2);
+        assert!(tree.focusable_ids.is_empty());
+        tree.destroy_element(1);
+        assert_eq!(revision(&tree), before + 2);
+    }
+
+    #[test]
+    fn focus_listeners_invalidate_even_when_the_focusable_set_stays_the_same() {
+        let mut tree = RetainedTree::new();
+        tree.create_element(1, "input".into());
+        for event in ["keyDown", "keyUp", "focus", "blur"] {
+            let before = revision(&tree);
+            tree.set_event_listener(1, event.into(), true);
+            assert_eq!(revision(&tree), before + 1);
+            tree.set_event_listener(1, event.into(), true);
+            assert_eq!(revision(&tree), before + 1);
+            tree.set_event_listener(1, event.into(), false);
+            assert_eq!(revision(&tree), before + 2);
+            tree.set_event_listener(1, event.into(), false);
+            assert_eq!(revision(&tree), before + 2);
+            assert_eq!(tree.focusable_ids.iter().copied().collect::<Vec<_>>(), [1]);
+        }
+    }
+
+    #[test]
+    fn changing_tab_index_invalidates_metadata_without_changing_focusable_ids() {
+        let mut tree = RetainedTree::new();
+        tree.create_element(1, "input".into());
+        for index in [Some(0), Some(5), Some(-1), None] {
+            let before = revision(&tree);
+            let value = serde_json::json!(index);
+            tree.set_custom_prop(1, "tabIndex".into(), value.clone());
+            assert_eq!(revision(&tree), before + 1);
+            assert_eq!(tree.elements[&1].tab_index(), index);
+            assert_eq!(tree.focusable_ids.iter().copied().collect::<Vec<_>>(), [1]);
+            tree.set_custom_prop(1, "tabIndex".into(), value);
+            assert_eq!(revision(&tree), before + 1);
+        }
+    }
+
+    #[test]
+    fn autofocus_changes_invalidate_metadata_only_when_the_flag_changes() {
+        let mut tree = RetainedTree::new();
+        tree.create_element(1, "input".into());
+        let before = revision(&tree);
+        tree.set_custom_prop(1, "autoFocus".into(), serde_json::json!(false));
+        assert_eq!(revision(&tree), before);
+        tree.set_custom_prop(1, "autoFocus".into(), serde_json::json!(true));
+        assert_eq!(revision(&tree), before + 1);
+        assert!(tree.elements[&1].auto_focus);
+        tree.set_custom_prop(1, "autoFocus".into(), serde_json::json!(true));
+        assert_eq!(revision(&tree), before + 1);
+        tree.set_custom_prop(1, "autoFocus".into(), serde_json::Value::Null);
+        assert_eq!(revision(&tree), before + 2);
+        assert!(!tree.elements[&1].auto_focus);
+        tree.set_custom_prop(1, "autoFocus".into(), serde_json::json!(false));
+        assert_eq!(revision(&tree), before + 2);
+    }
+
+    #[test]
+    fn reparenting_and_reordering_do_not_cache_or_invalidate_painted_tab_order() {
+        let mut tree = RetainedTree::new();
+        for (id, kind) in [(1, "div"), (2, "div"), (3, "input"), (4, "textarea")] {
+            tree.create_element(id, kind.into());
+        }
+        let before = revision(&tree);
+        tree.append_child(1, 3);
+        tree.append_child(1, 4);
+        tree.insert_before(1, 4, 3);
+        tree.append_child(2, 3);
+        assert_eq!(revision(&tree), before);
+        assert_eq!(tree.focusable_ids.iter().copied().collect::<Vec<_>>(), [3, 4]);
+    }
+
+    #[test]
+    fn text_color_mouse_events_and_unrelated_props_leave_focus_metadata_unchanged() {
+        let mut tree = RetainedTree::new();
+        tree.create_element(1, "input".into());
+        let before = revision(&tree);
+        tree.set_style(
+            1,
+            Arc::new(StyleDesc {
+                color: Some("red".into()),
+                ..Default::default()
+            }),
+        );
+        tree.set_text(1, "new text".into());
+        for event in ["click", "mouseMove", "mouseEnter", "mouseLeave"] {
+            tree.set_event_listener(1, event.into(), true);
+        }
+        tree.set_custom_prop(1, "testId".into(), serde_json::json!("input"));
+        tree.set_custom_prop(1, "placeholder".into(), serde_json::json!("type here"));
+        tree.set_root(1);
+        tree.set_keyboard_focus_dim(false);
+        assert_eq!(revision(&tree), before);
+    }
+
+    #[test]
+    fn missing_node_mutations_do_not_invalidate_focus_metadata() {
+        let mut tree = RetainedTree::new();
+        let before = revision(&tree);
+        tree.set_event_listener(99, "focus".into(), true);
+        tree.set_custom_prop(99, "tabIndex".into(), serde_json::json!(0));
+        tree.set_custom_prop(99, "autoFocus".into(), serde_json::json!(true));
+        tree.destroy_element(99);
+        assert_eq!(revision(&tree), before);
+    }
+
+    #[test]
+    fn metadata_revision_changes_before_the_queued_invalidation_can_run() {
+        let mut tree = RetainedTree::new();
+        tree.create_element(1, "input".into());
+        tree.take_invalidation();
+        let before = revision(&tree);
+        tree.set_custom_prop(1, "tabIndex".into(), serde_json::json!(4));
+        assert_eq!(revision(&tree), before + 1);
+        tree.take_invalidation();
+        assert_eq!(revision(&tree), before + 1);
+    }
+
+    #[test]
+    fn exhausted_focus_revisions_remain_uncacheable() {
+        let mut tree = RetainedTree::new();
+        tree.create_element(1, "input".into());
+        tree.focus_revision = Some(u64::MAX);
+        tree.set_custom_prop(1, "tabIndex".into(), serde_json::json!(0));
+        assert_eq!(tree.focus_revision(), None);
+        tree.set_event_listener(1, "blur".into(), true);
+        assert_eq!(tree.focus_revision(), None);
+    }
+}
