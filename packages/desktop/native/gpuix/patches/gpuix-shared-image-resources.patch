+    #[test]
+    fn separate_app_threads_share_absolute_resources_but_not_local_sources() {
+        let first = ImageOwner::new(gpui::WindowId::default());
+        let second = std::thread::spawn(|| ImageOwner::new(gpui::WindowId::default()))
+            .join()
+            .unwrap();
+        assert_ne!(first, second);
+        let absolute = Resource::Path(std::env::temp_dir().join("shared-emote.png").into());
+        assert!(SharedResource::new(&absolute, first) == SharedResource::new(&absolute, second));
+        assert!(
+            SharedResource::new(&resource("embedded"), first)
+                != SharedResource::new(&resource("embedded"), second)
+        );
+        let relative = Resource::Path(std::path::PathBuf::from("emote.png").into());
+        assert!(SharedResource::new(&relative, first) != SharedResource::new(&relative, second));
+        let mut shared = SharedImages::default();
+        let key = SharedResource::new(&absolute, first);
+        let image = Arc::new(RenderImage::from_bgra(1, 1, vec![0; 4]).unwrap());
+        shared.0.insert(
+            key.clone(),
+            SharedEntry {
+                state: ImageState::Loaded(Ok(image.clone())),
+                owners: HashMap::from([(first, 1), (second, 1)]),
+            },
+        );
+        let (retired, owned) = shared.release(&absolute, first);
+        assert!(retired.is_none() && !owned);
+        let ImageState::Loaded(Ok(retained)) = &shared.0[&key].state else {
+            panic!("surviving App lost pixels");
+        };
+        assert!(Arc::ptr_eq(&image, retained));
+        let (retired, owned) = shared.release(&absolute, second);
+        assert!(retired.is_some() && !owned && shared.0.is_empty());
+    }
