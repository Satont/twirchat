+    fn acquire(
+        &mut self,
+        resource: &Resource,
+        owner: ImageOwner,
+        cx: &mut App,
+    ) -> (ImageState, bool) {
+        let key = SharedResource::new(resource, owner);
+        if let Some(entry) = self.0.get_mut(&key) {
+            *entry.owners.entry(owner).or_default() += 1;
+            return (entry.state.clone(), false);
+        }
+        let future = AssetLogger::<ImageAssetLoader>::load(resource.clone(), cx);
+        let executor = cx.background_executor().clone();
+        let keep_alive = executor.clone();
+        // Scheduler wakeups hold a Weak reference. Keep the background dispatcher
+        // alive until decode finishes, even if the creating window/App closes.
+        let state = ImageState::Loading(
+            executor
+                .spawn(async move {
+                    let result = future.await;
+                    drop(keep_alive);
+                    result
+                })
+                .shared(),
+        );
+        self.0.insert(
+            key,
+            SharedEntry {
+                state: state.clone(),
+                owners: HashMap::from([(owner, 1)]),
+            },
+        );
+        (state, true)
+    }
+
+    // Move retired tasks/pixels outside the mutex before dropping them.
+    fn release(&mut self, resource: &Resource, owner: ImageOwner) -> (Option<SharedEntry>, bool) {
+        let key = SharedResource::new(resource, owner);
+        let Some(entry) = self.0.get_mut(&key) else {
+            return (None, false);
+        };
+        if let Some(count) = entry.owners.get_mut(&owner) {
+            *count -= 1;
+            if *count == 0 {
+                entry.owners.remove(&owner);
+            }
+        }
+        let window_owned = entry.owners.contains_key(&owner);
+        let retired = if entry.owners.is_empty() {
+            self.0.remove(&key)
+        } else {
+            None
+        };
+        (retired, window_owned)
+    }
+}
