     #[test]
+    fn expiry_preserves_idle_paint_and_waits_for_a_later_draw() {
+        let mut budget = ResourceBudget::new(256, usize::MAX);
+        let start = budget.now;
+        budget.begin_draw(1);
+        budget.touch(&resource("old"));
+        let expired = start + COLD_TTL;
+        assert!(!budget.expired(&resource("old"), expired));
+        assert!(!budget.begin_draw(1));
+        assert!(!budget.expired(&resource("old"), expired));
+        budget.begin_draw(2);
+        assert!(!budget.expired(&resource("old"), expired - Duration::from_millis(1)));
+        assert!(budget.expired(&resource("old"), expired));
+        budget.now = expired;
+        budget.touch_captured(&[(resource("old"), 1)]);
+        assert!(!budget.expired(&resource("old"), expired + COLD_TTL));
+        budget.begin_draw(3);
+        assert!(!budget.expired(
+            &resource("old"),
+            expired + COLD_TTL - Duration::from_millis(1)
+        ));
+        assert!(budget.expired(&resource("old"), expired + COLD_TTL));
+        budget.remove(&resource("old"));
+        assert!(budget.entries.is_empty());
+        assert!(budget.order.is_empty());
+    }
