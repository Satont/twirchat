+fn release_image(mut entry: Entry, window: Option<&mut Window>, cx: &mut App) {
+    let (retired, window_owned) = entry.lease.release();
+    let last = retired.is_some();
+    drop(retired);
+    let ImageState::Loaded(Ok(image)) = entry.state else {
+        return;
+    };
+    if last {
+        cx.drop_image(image, window);
+    } else if !window_owned {
+        // On release the closed window disposes its own atlas. A live window
+        // can retire its tiles while another window keeps the decoded pixels.
+        if let Some(window) = window {
+            if let Err(error) = window.drop_image(image) {
+                log::error!("Failed to retire image atlas tiles: {error}");
+            }
+        }
+    }
+}
