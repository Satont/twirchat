+
+impl ImageLease {
+    fn release(&mut self) -> (Option<SharedEntry>, bool) {
+        if !std::mem::replace(&mut self.active, false) {
+            return (None, false);
+        }
+        SharedImages::with(|images| images.release(&self.resource, self.owner))
