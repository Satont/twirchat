+    fn start_expiry(&mut self, window: &Window, cx: &App) {
+        if self.expiry.is_some() {
+            return;
+        }
+        let weak = self.weak.clone();
+        self.expiry = Some(window.spawn(cx, async move |cx| {
+            loop {
+                cx.background_executor().timer(EXPIRY_INTERVAL).await;
+                let keep_running = cx.update(|window, cx| {
+                    weak.update(cx, |cache, cx| {
+                        cache.expire(cx.background_executor().now(), window, cx);
+                        !cache.entries.is_empty()
+                    })
+                });
+                if !matches!(keep_running, Ok(Ok(true))) {
+                    break;
+                }
+            }
+        }));
+    }
+
+    fn expire(&mut self, now: Instant, window: &mut Window, cx: &mut App) {
+        // Timer updates run between synchronous draws. The current epoch is the
+        // last painted scene, even while idle or minimized; it must remain pinned.
+        while let Some((_, resource)) = self.budget.order.first_key_value() {
+            if !self.budget.expired(resource, now)
+                || self
+                    .entries
+                    .get(resource)
+                    .is_some_and(|entry| entry.completing.get())
