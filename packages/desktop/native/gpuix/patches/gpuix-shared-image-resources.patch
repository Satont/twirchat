+impl SharedImages {
+    fn with<R>(action: impl FnOnce(&mut Self) -> R) -> R {
+        #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+        {
+            action(&mut SHARED_IMAGES.lock())
