+    #[test]
+    fn shared_lease_keeps_identity_until_last_same_window_owner_leaves() {
+        let window = ImageOwner::new(gpui::WindowId::default());
+        let key = SharedResource::new(&resource("exact"), window);
+        let image = Arc::new(RenderImage::from_bgra(1, 1, vec![0; 4]).unwrap());
+        let state = ImageState::Loaded(Ok(image.clone()));
+        let mut shared = SharedImages::default();
+        shared.0.insert(
+            key.clone(),
+            SharedEntry {
+                state,
+                owners: HashMap::from([(window, 2)]),
+            },
+        );
+        assert!(
+            !shared
+                .0
+                .contains_key(&SharedResource::new(&resource("other"), window))
+        );
+        let (retired, owned) = shared.release(&resource("exact"), window);
+        assert!(retired.is_none() && owned);
+        let ImageState::Loaded(Ok(retained)) = &shared.0[&key].state else {
+            panic!("decoded image must remain available to the surviving lease");
+        };
+        assert!(Arc::ptr_eq(&image, retained));
+        let (retired, owned) = shared.release(&resource("exact"), window);
+        assert!(retired.is_some() && !owned);
+        assert!(shared.0.is_empty());
+    }
