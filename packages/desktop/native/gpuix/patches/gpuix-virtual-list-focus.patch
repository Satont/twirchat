+#[derive(Default)]
+struct VirtualRowFocus {
+    revision: u64,
+    focusable_ids: Vec<u64>,
+    has_auto_focus: bool,
+}
+
+fn sync_virtual_row_focus(
+    rows: &mut HashMap<u64, VirtualRowFocus>,
+    tree: &RetainedTree,
+    list_id: u64,
+    child_ids: &[u64],
+    child_revisions: &[u64],
+) {
+    rows.retain(|id, _| virtual_child_is_mounted(tree, list_id, *id));
+    for (&id, &revision) in child_ids.iter().zip(child_revisions) {
+        if rows.get(&id).is_some_and(|row| row.revision == revision) {
+            continue;
+        }
+        let mut row = VirtualRowFocus {
+            revision,
+            ..Default::default()
+        };
+        let mut pending = vec![id];
+        while let Some(descendant_id) = pending.pop() {
+            let Some(descendant) = tree.elements.get(&descendant_id) else {
+                continue;
+            };
+            // This is the same authoritative membership used by sync_focus_handles.
+            // Include nested lists: their focused descendants also keep this row mounted.
+            if tree.focusable_ids.contains(&descendant_id) {
+                row.focusable_ids.push(descendant_id);
+                row.has_auto_focus |= descendant.auto_focus;
+            }
+            pending.extend(descendant.children.iter().copied());
+        }
+        rows.insert(id, row);
+    }
 }
 
