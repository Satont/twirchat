+#[cfg(test)]
+mod virtual_row_focus_tests {
+    use super::{VirtualRowFocus, sync_virtual_row_focus};
+    use crate::retained_tree::RetainedTree;
+    use std::collections::HashMap;
+
+    fn sync(rows: &mut HashMap<u64, VirtualRowFocus>, tree: &RetainedTree, list_id: u64) {
+        let ids = &tree.elements[&list_id].children;
+        let revisions: Vec<_> = ids
+            .iter()
+            .map(|id| tree.elements[id].subtree_revision)
+            .collect();
+        sync_virtual_row_focus(rows, tree, list_id, ids, &revisions);
+    }
+
+    fn fixture() -> RetainedTree {
+        let mut tree = RetainedTree::new();
+        for (id, kind) in [(1, "virtual-list"), (2, "div"), (3, "div"), (4, "div")] {
+            tree.create_element(id, kind.into());
+        }
+        tree.append_child(1, 2);
+        tree.append_child(1, 3);
+        tree.append_child(2, 4);
+        tree
+    }
+
+    #[test]
+    fn focus_event_and_autofocus_changes_refresh_cached_rows() {
+        let mut tree = fixture();
+        let mut rows = HashMap::new();
+        sync(&mut rows, &tree, 1);
+        assert!(rows[&2].focusable_ids.is_empty());
+        tree.set_event_listener(4, "keyDown".into(), true);
+        sync(&mut rows, &tree, 1);
+        assert_eq!(rows[&2].focusable_ids, [4]);
+        tree.set_custom_prop(4, "autoFocus".into(), serde_json::json!(true));
+        sync(&mut rows, &tree, 1);
+        assert!(rows[&2].has_auto_focus);
+        tree.set_custom_prop(4, "autoFocus".into(), serde_json::json!(false));
+        sync(&mut rows, &tree, 1);
+        assert!(!rows[&2].has_auto_focus);
+        tree.set_event_listener(4, "keyDown".into(), false);
+        sync(&mut rows, &tree, 1);
+        assert!(rows[&2].focusable_ids.is_empty());
+    }
+
+    #[test]
+    fn reparenting_descendants_updates_both_rows_and_removal_retires_metadata() {
+        let mut tree = fixture();
+        tree.set_custom_prop(4, "tabIndex".into(), serde_json::json!(0));
+        let mut rows = HashMap::new();
+        sync(&mut rows, &tree, 1);
+        tree.append_child(3, 4);
+        sync(&mut rows, &tree, 1);
+        assert!(rows[&2].focusable_ids.is_empty());
+        assert_eq!(rows[&3].focusable_ids, [4]);
+        tree.destroy_element(3);
+        sync(&mut rows, &tree, 1);
+        assert!(!rows.contains_key(&3));
+    }
+
+    #[test]
+    fn nested_lists_and_intact_row_moves_keep_descendant_membership() {
+        let mut tree = fixture();
+        tree.create_element(5, "virtual-list".into());
+        tree.create_element(6, "input".into());
+        tree.append_child(4, 5);
+        tree.append_child(5, 6);
+        let mut rows = HashMap::new();
+        sync(&mut rows, &tree, 1);
+        assert_eq!(rows[&2].focusable_ids, [6]);
+        let revision = rows[&2].revision;
+        tree.append_child(1, 2);
+        sync(&mut rows, &tree, 1);
+        assert_eq!(rows[&2].revision, revision);
+        assert_eq!(rows[&2].focusable_ids, [6]);
+        tree.create_element(7, "virtual-list".into());
+        tree.append_child(7, 2);
+        sync(&mut rows, &tree, 1);
+        assert!(!rows.contains_key(&2));
+        let mut other_rows = HashMap::new();
+        sync(&mut other_rows, &tree, 7);
+        assert_eq!(other_rows[&2].focusable_ids, [6]);
+    }
 }
 
