+/// Identity of every style from the list up to the root. Interned styles share one
+/// `Arc` per content, so any ancestor restyle (opacity, inherited text) changes it.
+fn ancestry(tree: &RetainedTree, list: u64) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut hasher = rustc_hash::FxHasher::default();
+    let mut node = tree.elements.get(&list);
+    while let Some(element) = node {
+        element.id.hash(&mut hasher);
+        element
+            .style
+            .as_ref()
+            .map(|style| Arc::as_ptr(style).addr())
+            .hash(&mut hasher);
+        node = element.parent.and_then(|id| tree.elements.get(&id));
+    }
+    hasher.finish()
+}
