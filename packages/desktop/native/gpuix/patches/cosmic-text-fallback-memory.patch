+    pub(crate) fn get_fallback_font(
+        &mut self,
+        id: fontdb::ID,
+        weight: fontdb::Weight,
+        retain: bool,
+    ) -> Option<Arc<Font>> {
+        #[cfg(all(feature = "std", target_os = "linux"))]
+        if !retain {
+            if let Some(font) = self.font_cache.get(&(id, weight)) {
+                return font.clone();
+            }
+            let info = self.db.face(id)?;
+            if let fontdb::Source::File(path) = &info.source {
+                let file = std::fs::File::open(path).ok()?;
+                // The system font file is subject to the same immutability assumption as
+                // fontdb's shared map. Keep this map local until the candidate contributes a glyph.
+                let data = unsafe { memmap2::MmapOptions::new().map(&file).ok()? };
+                return Font::new_with_data(info, Arc::new(data), weight).map(Arc::new);
+            }
+            return Font::new(&self.db, id, weight).map(Arc::new);
+        }
+        let _ = retain;
+        self.get_font(id, weight)
+    }
+
+    #[cfg(all(feature = "std", target_os = "linux"))]
+    pub(crate) fn retain_fallback_font(&mut self, font: Arc<Font>, weight: fontdb::Weight) {
+        self.font_cache.entry((font.id(), weight)).or_insert(Some(font));
+    }
+
+    #[cfg(all(feature = "std", target_os = "linux"))]
+    pub(crate) fn has_missing_fallback(&self, text: &str, attrs: &Attrs<'_>, rtl: bool) -> bool {
+        self.missing_fallback_runs.iter().any(|run| {
+            run.text.as_ref() == text && run.rtl == rtl && run.attrs.as_attrs() == *attrs
+        })
+    }
+
+    #[cfg(all(feature = "std", target_os = "linux"))]
+    pub(crate) fn remember_missing_fallback(&mut self, text: &str, attrs: &Attrs<'_>, rtl: bool) {
+        if text.len() > 128
+            || matches!(attrs.family, fontdb::Family::Name(name) if name.len() > 128)
+            || attrs.font_features.features.len() > 16
+        {
+            return;
+        }
+        if self.missing_fallback_runs.len() == MISSING_FALLBACK_LIMIT {
+            self.missing_fallback_runs.pop_front();
+        }
+        self.missing_fallback_runs.push_back(MissingFallbackRun {
+            text: text.into(),
+            attrs: AttrsOwned::new(attrs),
+            rtl,
+        });
+    }
+
     pub fn is_monospace(&self, id: fontdb::ID) -> bool {
