new file mode 100644
index 0000000..b632595
--- /dev/null
+++ b/packages/native/src/clipboard_images.rs
@@ -0,0 +1,160 @@
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Weak};
+
+use gpui::{ClipboardEntry, ClipboardItem, WindowId};
+use napi::bindgen_prelude::{Buffer, Either3, Function, Result};
+use napi::threadsafe_function::ThreadsafeFunctionCallMode;
+use napi_derive::napi;
+use parking_lot::Mutex;
+
+const MAX_IMAGE_BYTES: usize = 20 * 1024 * 1024;
+const MAX_PATHS: usize = 10;
+
+#[napi(object, object_from_js = false)]
+pub struct ClipboardImage {
+    pub mime_type: String,
+    pub bytes: Buffer,
+}
+
+#[napi(object, object_from_js = false)]
+pub struct ClipboardPaths {
+    pub paths: Vec<String>,
+}
+
+#[napi(object, object_from_js = false)]
+pub struct ClipboardImageError {
+    pub error: String,
+}
+
+pub(crate) type ClipboardImagePayload =
+    Either3<ClipboardImage, ClipboardPaths, ClipboardImageError>;
+pub(crate) type PasteHandler = Arc<dyn Fn(ClipboardPaste) + Send + Sync>;
+type Handlers = Mutex<HashMap<u64, PasteHandler>>;
+pub(crate) type ImagePasteHandlers = Arc<Handlers>;
+
+thread_local! {
+    static WINDOW_HANDLERS: RefCell<HashMap<WindowId, Weak<Handlers>>> = RefCell::new(HashMap::new());
+}
+
+pub(crate) fn attach(window_id: WindowId, handlers: &ImagePasteHandlers) {
+    WINDOW_HANDLERS.with(|windows| {
+        windows
+            .borrow_mut()
+            .insert(window_id, Arc::downgrade(handlers));
+    });
+}
+
+pub(crate) fn detach(window_id: WindowId) {
+    let handlers = WINDOW_HANDLERS.with(|windows| windows.borrow_mut().remove(&window_id));
+    if let Some(handlers) = handlers.and_then(|handlers| handlers.upgrade()) {
+        handlers.lock().clear();
+    }
+}
+
+pub(crate) fn set_handler(
+    handlers: &ImagePasteHandlers,
+    id: u64,
+    callback: Option<Function<ClipboardImagePayload, ()>>,
+) -> Result<()> {
+    let Some(callback) = callback else {
+        handlers.lock().remove(&id);
+        return Ok(());
+    };
+
+    let pending = Arc::new(AtomicBool::new(false));
+    let delivered = pending.clone();
+    let callback = callback
+        .build_threadsafe_function::<ClipboardPaste>()
+        .callee_handled::<false>()
+        .weak::<true>()
+        .build_callback(move |context| {
+            delivered.store(false, Ordering::Release);
+            Ok(context.value.into_payload())
+        })?;
+    handlers.lock().insert(
+        id,
+        Arc::new(move |paste| {
+            if !pending.swap(true, Ordering::AcqRel)
+                && callback.call(paste, ThreadsafeFunctionCallMode::NonBlocking) != napi::Status::Ok
+            {
+                pending.store(false, Ordering::Release);
+            }
+        }),
+    );
+    Ok(())
+}
+
+pub(crate) enum ClipboardPaste {
+    Image(gpui::Image),
+    Paths(gpui::ExternalPaths),
+    Error(&'static str),
+}
+
+impl ClipboardPaste {
+    fn take(item: &mut ClipboardItem) -> Option<Self> {
+        let index = item
+            .entries
+            .iter()
+            .position(|entry| matches!(entry, ClipboardEntry::Image(_)))
+            .or_else(|| {
+                item.entries.iter().position(|entry| {
+                    matches!(entry, ClipboardEntry::ExternalPaths(paths) if !paths.paths().is_empty())
+                })
+            })?;
+
+        match item.entries.swap_remove(index) {
+            ClipboardEntry::Image(image) if image.bytes.len() > MAX_IMAGE_BYTES => {
+                Some(Self::Error("Clipboard images must be 20 MiB or smaller."))
+            }
+            ClipboardEntry::Image(image) => Some(Self::Image(image)),
+            ClipboardEntry::ExternalPaths(paths) if paths.paths().len() > MAX_PATHS => {
+                Some(Self::Error("Paste up to 10 image files at a time."))
+            }
+            ClipboardEntry::ExternalPaths(paths) => Some(Self::Paths(paths)),
+            ClipboardEntry::String(_) => None,
+        }
+    }
+
+    fn into_payload(self) -> ClipboardImagePayload {
+        match self {
+            Self::Image(image) => Either3::A(ClipboardImage {
+                mime_type: image.format.mime_type().into(),
+                bytes: image.bytes.into(),
+            }),
+            Self::Paths(paths) => {
+                let paths = paths
+                    .0
+                    .into_iter()
+                    .map(|path| path.into_os_string().into_string())
+                    .collect::<std::result::Result<_, _>>();
+                match paths {
+                    Ok(paths) => Either3::B(ClipboardPaths { paths }),
+                    Err(_) => {
+                        Self::Error("The copied file name is not valid UTF-8.").into_payload()
+                    }
+                }
+            }
+            Self::Error(error) => Either3::C(ClipboardImageError {
+                error: error.into(),
+            }),
+        }
+    }
+}
+
+pub(crate) fn handler(window_id: WindowId, id: u64) -> Option<PasteHandler> {
+    WINDOW_HANDLERS.with(|windows| {
+        let handlers = windows.borrow().get(&window_id)?.upgrade()?;
+        let callback = handlers.lock().get(&id).cloned();
+        callback
+    })
+}
+
+pub(crate) fn dispatch(callback: PasteHandler, item: &mut ClipboardItem) -> bool {
+    let Some(paste) = ClipboardPaste::take(item) else {
+        return false;
+    };
+    callback(paste);
+    true
+}
