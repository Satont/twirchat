# Copy to .env in the repository root and replace the credentials and public URLs.
# docker compose up -d uses docker-compose.yml from the repository root.

TWIRCHAT_VERSION=1.0.0
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3000

# Use the same credentials in POSTGRES_* and DATABASE_URL. URL-encode the password
# in DATABASE_URL if it contains reserved URI characters. PostgreSQL stays private.
POSTGRES_USER=twirchat
POSTGRES_DB=twirchat
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://twirchat:replace-with-a-long-random-password@twirchat-postgres:5432/twirchat

# Server-side credentials for public platform data.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://chat.example.com/auth/kick/callback
KICK_WEBHOOK_URL=https://chat.example.com/webhook/kick
# Generate a secret, for example with: openssl rand -hex 32
KICK_WEBHOOK_SECRET=

# Optional: enables YouTube channel resolution and anonymous gRPC chat relay.
YOUTUBE_API_KEY=

# Optional JSON provider list. Empty selects the default external history services;
# [] disables them. See packages/backend/.env.example for a custom-list example.
TWITCH_HISTORY_PROVIDERS=
