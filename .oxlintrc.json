{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "import", "oxc", "react", "unicorn", "promise"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-debugger": "error",
    "eqeqeq": "error",
    "prefer-const": "warn",
    "func-style": "off",
    "id-length": "off",
    "no-ternary": "off",
    "no-magic-numbers": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "prefer-template": "off",
    "no-duplicate-imports": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off",
    "unicorn/numeric-separators-style": "off",
    "import/no-named-export": "off",
    "import/no-namespace": "off",
    "import/no-nodejs-modules": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "no-useless-constructor": "off",
    "project-quality/no-type-assertions": "error",
    "project-quality/no-local-type-declarations": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-expect-error": "allow-with-description",
        "minimumDescriptionLength": 10
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/no-children-prop": "error",
    "promise/param-names": "warn",
    "promise/no-new-statics": "error",
    "promise/no-return-in-finally": "error",
    "promise/valid-params": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "typescript/no-base-to-string": "warn",
    "typescript/unbound-method": "warn",
    "typescript/restrict-template-expressions": "warn",
    "unicorn/no-useless-spread": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.out/**",
    "**/*.d.ts",
    "**/coverage/**",
    "**/frontend/bindings/**",
    "**/.opencode/**",
    "**/.agents/skills/**",
    "**/.cursor/skills/**"
  ],
  "jsPlugins": ["./scripts/quality-plugin.mjs"],
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["packages/desktop/src/gpuix/**/*.ts", "packages/desktop/src/gpuix/**/*.tsx"],
      "rules": {
        "project-quality/no-blocking-native-geometry": "error",
        "project-quality/no-unsupported-anchored-events": "error"
      }
    },
    {
      "files": ["**/tests/**/*.ts", "**/tests/**/*.tsx", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/await-thenable": "off"
      }
    }
  ]
}
